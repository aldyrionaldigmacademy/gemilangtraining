---
// src/components/Footer.astro
---

<footer class="bg-tc-card border-t border-tc-border mt-20 pt-16 pb-12 text-tc-muted">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10">
    <!-- Col 1: Brand Info -->
    <div class="space-y-4">
      <a href="/" class="inline-block text-2xl font-bold text-white">
        <span class="text-tc-accent">Gemilang</span> Training
      </a>
      <p class="text-sm leading-relaxed">
        Wadah pengembangan bakat digital berbasis proyek industri riil untuk siswa SMK dan mahasiswa agar siap kerja serta memiliki portofolio profesional.
      </p>
    </div>

    <!-- Col 2: Navigasi Cepat -->
    <div>
      <h4 class="text-white font-semibold mb-4">Navigasi Utama</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/" class="hover:text-tc-accent transition-colors">Beranda</a></li>
        <li><a href="/tentang" class="hover:text-tc-accent transition-colors">Tentang Kami</a></li>
        <li><a href="/program" class="hover:text-tc-accent transition-colors">Program Magang</a></li>
        <li><a href="/portofolio" class="hover:text-tc-accent transition-colors">Portofolio Karya</a></li>
        <li><a href="/blog" class="hover:text-tc-accent transition-colors">Blog & Artikel</a></li>
        <li><a href="/kontak" class="hover:text-tc-accent transition-colors">Kontak</a></li>
      </ul>
    </div>

    <!-- Col 3: Rumpun Keahlian -->
    <div>
      <h4 class="text-white font-semibold mb-4">Rumpun Keahlian</h4>
      <ul class="space-y-2.5 text-sm">
        <li>
          <a href="/program?cat=tech" class="hover:text-tc-accent transition-colors block">
            Web Engineering & Software (Informatika / RPL)
          </a>
        </li>
        <li>
          <a href="/program?cat=tech" class="hover:text-tc-accent transition-colors block">
            Network & Cloud Infrastructure (TKJ)
          </a>
        </li>
        <li>
          <a href="/program?cat=business" class="hover:text-tc-accent transition-colors block">
            SEO & Digital Marketing
          </a>
        </li>
        <li>
          <a href="/program?cat=business" class="hover:text-tc-accent transition-colors block">
            Data-Driven Growth & Bisnis Digital
          </a>
        </li>
        <li>
          <a href="/program?cat=design" class="hover:text-tc-accent transition-colors block">
            UI/UX Design System (DKV)
          </a>
        </li>
        <li>
          <a href="/program?cat=design" class="hover:text-tc-accent transition-colors block">
            Video & Motion Graphics (Multimedia)
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 4: Informasi Kontak & Lokasi (Sesuai Gambar) -->
    <div>
      <h4 class="text-white font-semibold mb-4">Hubungi Kami</h4>
      <div class="space-y-3.5 text-sm">
        <!-- Lokasi -->
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="text-tc-muted">Mojolangu, lowokwaru, Kota Malang, 65141</span>
        </div>

        <!-- Jam Operasional -->
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-tc-muted">Senin – Jumat, 08.00 – 17.00 WIB</span>
        </div>

        <!-- WhatsApp Resmi -->
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <a href="https://wa.me/6281943431484" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            +62 819–4343–1484 <span class="text-rose-400"></span>
          </a>
        </div>

        <!-- Instagram Resmi -->
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-pink-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" stroke-width="2"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2" stroke-linecap="round"></line>
          </svg>
          <a href="https://instagram.com/gemilangtraining.id" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            @gemilangtraining.id <span class="text-rose-400"></span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-6 border-t border-tc-border text-center text-xs text-tc-muted">
    <p>&copy; {new Date().getFullYear()} Gemilang Training. All rights reserved.</p>
  </div>
</footer>