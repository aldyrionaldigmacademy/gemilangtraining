---
// src/components/RegistrationForm.astro
---

<form id="wa-form" class="max-w-xl mx-auto bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border shadow-2xl">
  <h3 class="text-2xl font-bold text-white mb-2 text-center">Formulir Pendaftaran Magang</h3>
  <p class="text-sm text-tc-muted mb-6 text-center">Isi data di bawah untuk terhubung langsung dengan Tim Seleksi via WhatsApp.</p>
  
  <div class="mb-4">
    <label for="nama" class="block text-sm font-medium text-tc-muted mb-2">Nama Lengkap</label>
    <input type="text" id="nama" required placeholder="Contoh: Budi Pratama" class="w-full px-4 py-3 bg-tc-bg border border-tc-border rounded-xl text-white focus:outline-none focus:border-tc-accent transition-colors" />
  </div>

  <div class="mb-4">
    <label for="instansi" class="block text-sm font-medium text-tc-muted mb-2">Asal Sekolah / Universitas</label>
    <input type="text" id="instansi" required placeholder="Contoh: SMKN 1 Malang / Universitas Brawijaya" class="w-full px-4 py-3 bg-tc-bg border border-tc-border rounded-xl text-white focus:outline-none focus:border-tc-accent transition-colors" />
  </div>

  <div class="mb-4">
    <label for="jurusan" class="block text-sm font-medium text-tc-muted mb-2">Pilihan Program Magang</label>
    <select id="jurusan" required class="w-full px-4 py-3 bg-tc-bg border border-tc-border rounded-xl text-white focus:outline-none focus:border-tc-accent transition-colors">
      <option value="">-- Pilih Rumpun Jurusan --</option>
      <option value="Tech (Informatika / RPL / TKJ)">Tech (Informatika, RPL, TKJ)</option>
      <option value="Digital Business (Digital Marketing / Pemasaran)">Digital Business (Digital Marketing, Pemasaran)</option>
      <option value="Creative Arts (DKV / Multimedia)">Creative Arts (DKV, Multimedia)</option>
    </select>
  </div>

  <div class="mb-6">
    <label for="catatan" class="block text-sm font-medium text-tc-muted mb-2">Catatan / Rencana Periode Magang (Opsional)</label>
    <textarea id="catatan" rows="3" placeholder="Tuliskan periode atau pertanyaan..." class="w-full px-4 py-3 bg-tc-bg border border-tc-border rounded-xl text-white focus:outline-none focus:border-tc-accent transition-colors"></textarea>
  </div>

  <button type="submit" class="w-full py-4 bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold rounded-xl shadow-lg transition-all duration-300">
    Kirim Pendaftaran via WhatsApp
  </button>
</form>

<script>
  const form = document.getElementById('wa-form') as HTMLFormElement;
  const phoneNumber = "6281943431484";

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nama = (document.getElementById('nama') as HTMLInputElement).value;
    const instansi = (document.getElementById('instansi') as HTMLInputElement).value;
    const jurusan = (document.getElementById('jurusan') as HTMLSelectElement).value;
    const catatan = (document.getElementById('catatan') as HTMLTextAreaElement).value;

    let message = `Halo Admin Gemilang Training, saya ingin mendaftar Program Magang.%0A%0A`;
    message += `*--- DATA PENDAFTAR ---*%0A`;
    message += `👤 *Nama:* ${encodeURIComponent(nama)}%0A`;
    message += `🏫 *Instansi:* ${encodeURIComponent(instansi)}%0A`;
    message += `🎯 *Program:* ${encodeURIComponent(jurusan)}%0A`;
    
    if (catatan.trim() !== "") {
      message += `📝 *Catatan:* ${encodeURIComponent(catatan)}%0A`;
    }
    
    message += `%0AMohon informasi proses seleksi selanjutnya. Terima kasih!`;

    window.open(`https://wa.me/${phoneNumber}?text=${message}`, '_blank');
  });
</script>