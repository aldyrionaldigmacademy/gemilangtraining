---
// src/components/Navbar.astro
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, ""); 
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0A192F]/90 backdrop-blur-md border-b border-tc-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="/" class="text-xl md:text-2xl font-bold tracking-tight text-white flex items-center gap-3 group">
      <img 
        src="/logo.webp" 
        alt="Logo Gemilang Training" 
        class="w-9 h-9 md:w-10 md:h-10 object-contain transition-transform duration-300 group-hover:scale-105"
        onerror="this.src='/logo.webp'"
      />
      <span class="font-extrabold mb-0">
        <span class="text-tc-accent">Gemilang</span> Training
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-2 text-sm font-medium">
      <a 
        href="/" 
        class={`px-4 py-2 rounded-xl transition-all ${
          currentPath === "" || currentPath === "/" 
            ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" 
            : "text-tc-muted hover:text-white"
        }`}
      >
        Beranda
      </a>

      <a 
        href="/tentang" 
        class={`px-4 py-2 rounded-xl transition-all ${
          currentPath.startsWith("/tentang") 
            ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" 
            : "text-tc-muted hover:text-white"
        }`}
      >
        Tentang Kami
      </a>
      
      <!-- Dropdown Program Magang -->
      <div class="relative group py-2">
        <a 
          href="/program"
          class={`flex items-center gap-1.5 px-4 py-2 rounded-xl transition-all focus:outline-none ${
            currentPath.startsWith("/program") 
              ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" 
              : "text-tc-muted hover:text-white"
          }`}
        >
          <span>Program Magang</span>
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </a>

        <!-- Menu Dropdown 2 Rumpun Utama -->
        <div class="absolute left-0 top-full hidden group-hover:block w-96 bg-tc-card border border-tc-border rounded-2xl shadow-2xl p-4 space-y-2 mt-2 before:absolute before:-top-4 before:left-0 before:w-full before:h-4 before:content-['']">
          
          <!-- Seluruh Program -->
          <a href="/program" class="block p-2.5 rounded-xl hover:bg-tc-bg/80 border border-transparent hover:border-tc-border transition-all group/item">
            <div class="flex items-center gap-2 text-xs font-bold text-tc-accent uppercase tracking-wider mb-0.5">
              <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
              <span>SELURUH PROGRAM MAGANG</span>
            </div>
            <span class="block text-xs text-tc-muted group-hover/item:text-white pl-6">Katalog Lengkap Jalur SMK & Mahasiswa</span>
          </a>

          <!-- Rumpun 1: Tech & Web Engineering -->
          <a href="/program?cat=webdev" class="block p-2.5 rounded-xl hover:bg-tc-bg/80 border border-transparent hover:border-tc-border transition-all group/item border-t border-tc-border/40 pt-2.5">
            <div class="flex items-center gap-2 text-xs font-bold text-tc-accent uppercase tracking-wider mb-0.5">
              <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
              <span>TECH & WEB ENGINEERING</span>
            </div>
            <span class="block text-xs text-tc-muted group-hover/item:text-white pl-6">70% Web Dev (Astro/Bootstrap/WP) + 30% SEO</span>
            <span class="block text-[10px] text-tc-accent/80 pl-6 mt-0.5">Jurusan: Informatika, RPL, TKJ</span>
          </a>

          <!-- Rumpun 2: Digital Business & Creative Media -->
          <a href="/program?cat=digital-creative" class="block p-2.5 rounded-xl hover:bg-tc-bg/80 border border-transparent hover:border-tc-border transition-all group/item border-t border-tc-border/40 pt-2.5">
            <div class="flex items-center gap-2 text-xs font-bold text-tc-accent uppercase tracking-wider mb-0.5">
              <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              <span>DIGITAL BUSINESS & CREATIVE MEDIA</span>
            </div>
            <span class="block text-xs text-tc-muted group-hover/item:text-white pl-6">70% SEO, Artikel, 3 Video Konten + 30% Web</span>
            <span class="block text-[10px] text-tc-accent/80 pl-6 mt-0.5">Jurusan: Digital Marketing, Bisnis Digital, Pemasaran, DKV, Multimedia</span>
          </a>

          <!-- Link Alur Pendaftaran -->
          <a href="/alur-pendaftaran" class="block p-2.5 rounded-xl bg-tc-bg/60 hover:bg-tc-bg border border-tc-accent/30 hover:border-tc-accent transition-all group/item mt-3">
            <div class="flex items-center gap-2 text-xs font-bold text-tc-accent uppercase tracking-wider mb-0.5">
              <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
              <span>ALUR & SYARAT PENDAFTARAN</span>
            </div>
            <span class="block text-xs text-tc-muted group-hover/item:text-white pl-6">Panduan 5 Langkah Terstruktur Magang</span>
          </a>

        </div>
      </div>

      <a 
        href="/portofolio" 
        class={`px-4 py-2 rounded-xl transition-all ${
          currentPath.startsWith("/portofolio") 
            ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" 
            : "text-tc-muted hover:text-white"
        }`}
      >
        Portofolio
      </a>

      <a 
        href="/blog" 
        class={`px-4 py-2 rounded-xl transition-all ${
          currentPath.startsWith("/blog") 
            ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" 
            : "text-tc-muted hover:text-white"
        }`}
      >
        Blog
      </a>

      <a 
        href="/kontak" 
        class={`px-4 py-2 rounded-xl transition-all ${
          currentPath.startsWith("/kontak") 
            ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" 
            : "text-tc-muted hover:text-white"
        }`}
      >
        Kontak
      </a>
    </nav>

    <!-- Header CTA Button -->
    <div class="hidden md:block">
      <a href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20mendaftar%20Program%20Magang." 
         target="_blank" 
         rel="noopener noreferrer" 
         class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-5 py-2.5 rounded-xl transition-all inline-flex items-center gap-2.5 shadow-md hover:scale-105 group">
        
        <!-- Modern WhatsApp SVG Icon -->
        <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z"/>
        </svg>
        
        <span>Daftar Magang</span>
      </a>
    </div>

    <!-- Hamburger Button (Mobile Trigger) -->
    <button id="menu-btn" type="button" aria-label="Buka Menu" aria-expanded="false" aria-controls="mobile-drawer" class="md:hidden text-white focus:outline-none p-2 cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>
</header>

<!-- Offcanvas Mobile Drawer -->
<div 
  id="mobile-drawer" 
  class="fixed inset-0 w-screen h-screen z-[9999] flex flex-col p-6 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden overflow-y-auto"
  style="background-color: #0A192F !important;"
>
  <div class="flex items-center justify-between pb-6 border-b border-tc-border">
    <a href="/" class="flex items-center gap-2.5 text-xl font-bold text-white">
      <img src="/logo.webp" alt="Logo Gemilang Training" class="w-8 h-8 object-contain" onerror="this.src='/logo.webp'" />
      <span><span class="text-tc-accent">Gemilang</span> Training</span>
    </a>
    <button id="close-btn" type="button" aria-label="Tutup Menu" class="text-tc-muted hover:text-white p-2 cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <nav class="flex flex-col gap-2 mt-6 font-medium">
    <a href="/" class={`px-4 py-3 rounded-xl transition-all ${currentPath === "" || currentPath === "/" ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" : "text-tc-muted hover:text-white"}`}>
      Beranda
    </a>

    <a href="/tentang" class={`px-4 py-3 rounded-xl transition-all ${currentPath.startsWith("/tentang") ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" : "text-tc-muted hover:text-white"}`}>
      Tentang Kami
    </a>

    <!-- Accordion Mobile -->
    <details class="group rounded-xl border border-transparent [&[open]]:border-tc-border [&[open]]:bg-tc-card/40 transition-all">
      <summary class={`flex items-center justify-between px-4 py-3 cursor-pointer list-none select-none rounded-xl ${currentPath.startsWith("/program") ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" : "text-tc-muted hover:text-white"}`}>
        <span>Program Magang</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-open:rotate-180 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </summary>

      <div class="px-4 pb-4 pt-2 space-y-3">
        <a href="/program?cat=webdev" class="mobile-link block p-2 rounded-lg bg-tc-bg/60 border border-tc-border/60 hover:border-tc-accent">
          <div class="text-xs font-semibold text-tc-accent uppercase tracking-wider mb-0.5">TECH & WEB ENGINEERING</div>
          <span class="block text-xs text-tc-muted">Informatika, RPL, TKJ (70% Web : 30% SEO)</span>
        </a>

        <a href="/program?cat=digital-creative" class="mobile-link block p-2 rounded-lg bg-tc-bg/60 border border-tc-border/60 hover:border-tc-accent">
          <div class="text-xs font-semibold text-tc-accent uppercase tracking-wider mb-0.5">DIGITAL BUSINESS & CREATIVE MEDIA</div>
          <span class="block text-xs text-tc-muted">Marketing, Bisnis Digital, Pemasaran, DKV, MM</span>
        </a>

        <a href="/alur-pendaftaran" class="mobile-link block p-2 rounded-lg bg-tc-card border border-tc-accent/40 hover:border-tc-accent">
          <div class="text-xs font-semibold text-tc-accent uppercase tracking-wider mb-0.5">ALUR PENDAFTARAN</div>
          <span class="block text-xs text-tc-muted">Panduan 5 Tahapan Terstruktur</span>
        </a>
      </div>
    </details>

    <a href="/portofolio" class={`px-4 py-3 rounded-xl transition-all ${currentPath.startsWith("/portofolio") ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" : "text-tc-muted hover:text-white"}`}>
      Portofolio Karya
    </a>

    <a href="/blog" class={`px-4 py-3 rounded-xl transition-all ${currentPath.startsWith("/blog") ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" : "text-tc-muted hover:text-white"}`}>
      Blog & Artikel
    </a>

    <a href="/kontak" class={`px-4 py-3 rounded-xl transition-all ${currentPath.startsWith("/kontak") ? "bg-tc-card text-tc-accent border border-tc-border font-semibold" : "text-tc-muted hover:text-white"}`}>
      Kontak
    </a>

    <!-- CTA Daftar Magang di Mobile -->
    <a 
      href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20mendaftar%20Program%20Magang." 
      target="_blank" 
      rel="noopener noreferrer"
      class="mt-4 bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-4 py-3 rounded-xl text-center transition-all shadow-md"
    >
      Daftar Magang via WA
    </a>
  </nav>
</div>

<script>
  function setupMobileMenu() {
    const menuBtn = document.getElementById('menu-btn');
    const closeBtn = document.getElementById('close-btn');
    const drawer = document.getElementById('mobile-drawer');
    if (!menuBtn || !closeBtn || !drawer) return;

    const openDrawer = () => {
      drawer.classList.remove('translate-x-full');
      document.body.classList.add('overflow-hidden');
      menuBtn.setAttribute('aria-expanded', 'true');
    };

    const closeDrawer = () => {
      drawer.classList.add('translate-x-full');
      document.body.classList.remove('overflow-hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
    };

    menuBtn.onclick = openDrawer;
    closeBtn.onclick = closeDrawer;

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>