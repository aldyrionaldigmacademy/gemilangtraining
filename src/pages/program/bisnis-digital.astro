---
// src/pages/program/bisnis-digital.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const data = {
  title: "Program Magang Data-Driven Growth & Business Strategy",
  jurusanTarget: "SMK Jurusan Bisnis Digital",
  category: "Artikel & Business Strategy",
  img: "/assets/img/bisnisdigital.webp",
  desc: "Membimbing siswa SMK Bisnis Digital memahami siklus pertumbuhan bisnis online, pembuatan artikel penawaran produk, optimasi Sales Funnel landing page, serta riset kompetitor industri.",
  durasi: "3 - 6 Bulan (Flexible WFH / Hybrid / Onsite Malang)",
  mentor: "E-Commerce Manager & Business Growth Strategist",
  kualifikasi: [
    "Siswa aktif SMK Jurusan Bisnis Digital",
    "Memahami konsep dasar model bisnis digital & manajemen",
    "Memiliki kemampuan komunikasi & analisis yang baik",
    "Memiliki laptop pribadi untuk pengelolaan dashboard e-commerce"
  ],
  fasilitas: [
    "Bimbingan Penulisan Artikel Strategi Bisnis",
    "Akses Dashboard Analisis Pertumbuhan Penjualan",
    "Sertifikat Magang Kelulusan Resmi",
    "Portofolio Campaign Business Blueprint"
  ],
  gallery: [
    "/assets/img/bisnisdigital1.webp",
    "/assets/img/bisnisdigital2.webp",
    "/assets/img/bisnisdigital3.webp"
  ]
};
---

<BaseLayout title={`${data.title} - Gemilang Training`} isHome={false}>
  <Navbar slot="header" />

  <section class="py-8 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div>
      <a href="/program" class="inline-flex items-center gap-2 text-xs md:text-sm text-tc-accent hover:underline font-semibold">
        &larr; Kembali ke Daftar Semua Program Magang
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div class="bg-tc-card p-3 rounded-2xl border border-tc-border shadow-2xl overflow-hidden">
        <img src={data.img} alt={data.title} class="w-full h-auto max-h-[380px] object-cover rounded-xl" />
      </div>

      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border shadow-2xl space-y-6">
        <div>
          <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest block mb-1">
            {data.category}
          </span>
          <h1 class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight">
            {data.title}
          </h1>
          <p class="text-tc-muted text-xs md:text-sm leading-relaxed">
            {data.desc}
          </p>
        </div>

        <div class="space-y-2 text-xs text-tc-muted border-t border-tc-border/60 pt-4">
          <div class="flex justify-between">
            <span>Target Pendaftar:</span>
            <strong class="text-white">{data.jurusanTarget}</strong>
          </div>
          <div class="flex justify-between">
            <span>Pembimbing/Mentor:</span>
            <strong class="text-tc-accent">{data.mentor}</strong>
          </div>
          <div class="flex justify-between">
            <span>Durasi Magang:</span>
            <strong class="text-white">{data.durasi}</strong>
          </div>
        </div>

        <div class="space-y-3 pt-2">
          <a 
            href={`https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20tertarik%20pilih%20Program%20${encodeURIComponent(data.title)}.`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="block w-full text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold py-3.5 rounded-xl transition-all shadow-lg text-sm hover:scale-[1.02]"
          >
            Daftar Program Ini Sekarang via WA
          </a>
        </div>
      </div>
    </div>

    <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
      <h2 class="text-lg md:text-xl font-bold text-white mb-4">Galeri Bimbingan Bisnis Digital</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {data.gallery.map((imgUrl) => (
          <div class="h-40 md:h-48 rounded-xl overflow-hidden border border-tc-border bg-tc-card">
            <img src={imgUrl} alt="Dokumentasi Bimbingan Bisnis Digital" class="w-full h-full object-cover" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>