---
// src/pages/program/pariwisata.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const waUrl = "https://wa.me/6281943431484?text=Halo%20Admin%2C%20saya%20tertarik%20mendaftar%20program%20Magang%20%2F%20PKL%20Jurusan%20Pariwisata%20(penempatan%20Katun%20Outbound%20Malang).%20Mohon%20info%20kuota%20dan%20syaratnya.";

const bidangPraktik = [
  {
    no: "01",
    title: "Bagian Bisnis EO (Event Organizer)",
    desc: "Mempelajari perencanaan konsep acara, penyusunan rundown kegiatan, koordinasi perlengkapan, hingga alur pelayanan klien event & wisata.",
    img: "/assets/img/Siswa-SMK-RPL-mengerjakan-proyek-website.webp"
  },
  {
    no: "02",
    title: "LO (Leader Organizer)",
    desc: "Mendampingi rombongan peserta atau tamu selama kegiatan berlangsung agar jadwal, alur koordinasi, dan kebutuhan lapangan berjalan tertib.",
    img: "/assets/img/Siswa-SMK-RPL-mengerjakan-laporan-akhir.webp"
  },
  {
    no: "03",
    title: "PIC (Person In Charge) Kegiatan Outbound",
    desc: "Bertanggung jawab mengawal teknis sesi kegiatan outbound, keamanan peserta, kelengkapan alat, serta kelancaran alur permainan/aktivitas lapangan.",
    img: "/assets/img/Daftar-ide-project-PKL-RPL.webp"
  },
  {
    no: "04",
    title: "Tour Guide (Pemandu Wisata)",
    desc: "Memandu peserta atau rombongan wisata di lokasi, menyampaikan informasi destinasi secara menarik, serta menjaga kenyamanan perjalanan.",
    img: "/assets/img/Contoh-project-PKL-RPL.webp"
  },
  {
    no: "05",
    title: "Tour Leader (Pemimpin Rombongan Wisata)",
    desc: "Mengkoordinasikan keseluruhan perjalanan rombongan mulai dari titik kumpul, alur itinerary, hingga komunikasi antar-tim lapangan.",
    img: "/assets/img/apa-yang-dikerjakan-anak-rpl-saat-pkl.webp"
  }
];

const skillsDibutuhkan = [
  {
    title: "Grooming",
    desc: "Penampilan rapi, bersih, proporsional, dan mencerminkan profesionalitas industri pariwisata & hospitality."
  },
  {
    title: "Greeting",
    desc: "Sambutan hangat, ramah, dan sopan kepada tamu, peserta outbound, maupun mitra kegiatan sejak kontak pertama."
  },
  {
    title: "Komunikasi",
    desc: "Kemampuan menyampaikan instruksi dan informasi dengan jelas, empatik, serta responsif saat berkoordinasi di lapangan."
  },
  {
    title: "Public Speaking",
    desc: "Kepercayaan diri berbicara di depan rombongan atau kelompok besar saat briefing, pemanduan wisata, maupun memimpin sesi acara."
  }
];
---

<BaseLayout 
  title="Magang Mahasiswa & PKL SMK Pariwisata di Katun Outbound Malang" 
  description="Program magang mahasiswa dan PKL siswa SMK jurusan MBP (Manajemen Bisnis Pariwisata), DEP (Destinasi Pariwisata), dan Pariwisata dengan penempatan di Katun Outbound Malang: Bisnis EO (Event Organizer), LO (Leader Organizer), PIC (Person In Charge) Outbound, Tour Guide & Tour Leader."
  isHome={false}
>
  <Navbar slot="header" />

  <!-- HERO (Rata Tengah) -->
  <section class="relative bg-tc-card/80 border-b border-tc-border overflow-hidden">
    <div class="absolute inset-0 opacity-15">
      <img src="/assets/img/beranda1.webp" alt="Magang Pariwisata di Katun Outbound Malang" class="w-full h-full object-cover" />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 text-center">
      <span class="inline-block text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-bg/90 px-4 py-1.5 rounded-full border border-tc-border mb-4">
        Penempatan: Katun Outbound Malang
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 leading-tight">
        Magang Mahasiswa & PKL SMK <span class="text-tc-accent">Pariwisata</span>
      </h1>
      <p class="text-tc-muted text-sm md:text-lg max-w-3xl mx-auto leading-relaxed mb-8">
        Program praktik lapangan khusus jurusan <strong class="text-white">MBP (Manajemen Bisnis Pariwisata)</strong>, <strong class="text-white">DEP (Destinasi Pariwisata)</strong>, <strong class="text-white">Pariwisata</strong>, serta <strong class="text-white">SMK (Sekolah Menengah Kejuruan) Jurusan Pariwisata</strong> dengan penempatan di <strong class="text-white">Katun Outbound Malang</strong>.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold text-sm px-6 py-3.5 rounded-xl transition-all shadow-lg"
        >
          Daftar via WhatsApp &rarr;
        </a>
        <a 
          href="/program"
          class="bg-tc-bg hover:border-tc-accent border border-tc-border text-white font-semibold text-sm px-6 py-3.5 rounded-xl transition-all"
        >
          Kembali ke Semua Program
        </a>
      </div>
    </div>
  </section>

  <!-- RINGKASAN FOKUS JURUSAN & WAKTU -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-tc-card border border-tc-border rounded-2xl p-6">
        <span class="text-xs font-mono text-tc-accent uppercase">Fokus Jurusan</span>
        <h2 class="text-xl font-bold text-white mt-2 mb-2">MBP, DEP & Pariwisata</h2>
        <p class="text-sm text-tc-muted">
          Terbuka untuk Mahasiswa <strong class="text-white">MBP (Manajemen Bisnis Pariwisata)</strong>, <strong class="text-white">DEP (Destinasi Pariwisata)</strong>, <strong class="text-white">Pariwisata</strong>, maupun siswa <strong class="text-white">SMK (Sekolah Menengah Kejuruan)</strong> jurusan Pariwisata.
        </p>
      </div>
      <div class="bg-tc-card border border-tc-border rounded-2xl p-6">
        <span class="text-xs font-mono text-tc-accent uppercase">Lokasi Praktik</span>
        <h2 class="text-xl font-bold text-white mt-2 mb-2">Katun Outbound Malang</h2>
        <p class="text-sm text-tc-muted">Praktik langsung di lapangan kegiatan outbound, wisata, dan event di kawasan Malang.</p>
      </div>
      <div class="bg-tc-card border border-tc-border rounded-2xl p-6">
        <span class="text-xs font-mono text-tc-accent uppercase">Waktu Program</span>
        <h2 class="text-xl font-bold text-white mt-2 mb-2">3 – 6 Bulan</h2>
        <p class="text-sm text-tc-muted">Durasi program disesuaikan dengan jadwal akademik kampus atau sekolah serta kebutuhan lapangan.</p>
      </div>
    </div>
  </section>

  <!-- 5 BIDANG PRAKTIK (DENGAN GAMBAR 16:9) -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-wider block mb-2">
        Ruang Lingkup Kegiatan
      </span>
      <h2 class="text-2xl md:text-4xl font-extrabold text-white">
        5 Bidang Praktik di Lapangan
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {bidangPraktik.map((item) => (
        <div class="bg-tc-card border border-tc-border hover:border-tc-accent transition-all duration-300 rounded-2xl overflow-hidden flex flex-col justify-between group">
          <div>
            <!-- Thumbnail Rasio 16:9 -->
            <div class="aspect-video w-full overflow-hidden relative border-b border-tc-border/60">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                loading="lazy"
              />
              <span class="absolute top-3 left-3 text-xs font-mono font-bold text-tc-accent bg-tc-bg/90 border border-tc-border px-3 py-1 rounded-full backdrop-blur-md">
                Bidang {item.no}
              </span>
            </div>

            <!-- Konten -->
            <div class="p-6">
              <h3 class="text-xl font-bold text-white mb-2">{item.title}</h3>
              <p class="text-sm text-tc-muted leading-relaxed">{item.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SKILL YANG DIBUTUHKAN -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-wider block mb-2">
        Kompetensi Utama
      </span>
      <h2 class="text-2xl md:text-4xl font-extrabold text-white">
        Skill yang Dibutuhkan
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillsDibutuhkan.map((sk) => (
        <div class="bg-tc-card border border-tc-border rounded-2xl p-6">
          <h3 class="text-lg font-bold text-tc-accent mb-2">{sk.title}</h3>
          <p class="text-sm text-tc-muted leading-relaxed">{sk.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA WHATSAPP -->
  <section class="pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-tc-card border border-tc-border rounded-3xl p-8 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-2xl font-extrabold text-white mb-2">
          Siap Magang Pariwisata di Katun Outbound Malang?
        </h2>
        <p class="text-sm text-tc-muted">
          Hubungi admin via WhatsApp untuk menanyakan jadwal, kuota, dan penempatan Katun Outbound Malang.
        </p>
      </div>
      <a 
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold text-sm px-6 py-3.5 rounded-xl transition-all shrink-0 shadow-lg"
      >
        Hubungi WhatsApp Sekarang &rarr;
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>