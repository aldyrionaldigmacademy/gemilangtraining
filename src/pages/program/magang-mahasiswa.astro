<script>
  function setupMateriFilter() {
    const btns = document.querySelectorAll('.mfilter-btn');
    const cards = document.querySelectorAll('.materi-card');
    if (!btns.length || !cards.length) return;

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-mfilter') || 'all';

        btns.forEach((b) => {
          b.classList.remove('bg-tc-accent', 'text-slate-950', 'font-bold');
          b.classList.add('bg-tc-card', 'border', 'border-tc-border', 'text-tc-muted', 'font-semibold');
        });

        btn.classList.add('bg-tc-accent', 'text-slate-950', 'font-bold');
        btn.classList.remove('bg-tc-card', 'border', 'border-tc-border', 'text-tc-muted', 'font-semibold');

        cards.forEach((card) => {
          const cat = card.getAttribute('data-mcat');
          if (val === 'all' || val === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupMateriFilter();
  document.addEventListener('astro:page-load', setupMateriFilter);
</script>