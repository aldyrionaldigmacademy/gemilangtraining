---
// src/pages/program/rpl.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const data = {
  slug: "rpl",
  jurusanTarget: "SMK Jurusan Rekayasa Perangkat Lunak (RPL)",
  title: "Program Magang Frontend & Fullstack Web Development",
  category: "Web Development (Astro Framework, Bootstrap 5, Blogspot)",
  img: "/assets/img/rpl.webp",
  desc: "Program magang praktik industri riil untuk siswa SMK RPL. Berfokus pada pengerjaan web modern berkinerja tinggi menggunakan Astro Framework, pengubahan tema Bootstrap 5, pengelolaan CMS Blogspot komersial, serta penerapan Clean Code dan Clean URL.",
  durasi: "3 - 6 Bulan (Flexible WFH / Hybrid / Onsite Malang)",
  target: "Siswa SMK Spesialisasi RPL / Software Engineering",
  mentor: "Frontend Developer Specialist & Pembimbing Vokasi Gemilang Training",
  kualifikasi: [
    "Siswa aktif SMK jurusan Rekayasa Perangkat Lunak (RPL)",
    "Memahami dasar HTML5, CSS3, dan logika pemrograman JavaScript",
    "Mengenal penggunaan text editor (VS Code) & Git dasar",
    "Memiliki laptop pribadi yang memadai untuk aktivitas coding"
  ],
  fasilitas: [
    "Akses Repositori Project Web Riil (GitHub)",
    "Direct Bimbingan & Review Clean Code Mingguan",
    "Sertifikat Magang Official & Surat Rekomendasi",
    "Portofolio Live Web SSG (Astro & Blogspot Custom)",
    "Lembar Penilaian & Verifikasi Jurnal/Logbook PKL SMK"
  ],
  timeline: [
    { waktu: "Bulan 1", judul: "Onboarding, HTML5 Semantik & Bootstrap", ket: "Pengenalan struktur layouting modern, Flexbox/Grid, & kustomisasi komponen Bootstrap 5." },
    { waktu: "Bulan 2", judul: "Astro SSG & Blogspot CMS Development", ket: "Pembuatan komponen Astro reusable, pengolahan tema Blogspot, & arsitektur Clean URL." },
    { waktu: "Bulan 3", judul: "Performance Optimization & Live Deployment", ket: "Audit kecepatan situs (PageSpeed 95+), integrasi repositori GitHub, & deployment Vercel." }
  ],
  curriculum: [
    "Penguasaan HTML5 Semantik, Layouting CSS Flexbox & Grid",
    "Integrasi Komponen UI Bootstrap 5 & Tailwind CSS",
    "Arsitektur Jamstack & Static Site Generation (SSG) dengan Astro Framework",
    "Pengelolaan & Custom Theme Development pada Blogspot CMS",
    "Penerapan Clean URL & Komponensialisasi Kode Reusable",
    "Version Control System menggunakan GitHub Collaboration Flow"
  ],
  tools: ["Astro Framework", "Bootstrap 5", "Blogspot", "VS Code", "HTML5 & CSS3", "GitHub", "Vercel"],
  output: [
    "Website Responsive Company Profile Berkecepatan Tinggi (Live URL)",
    "Blog Komersial Berbasis Blogspot Custom Theme",
    "Portofolio GitHub Repository Terverifikasi",
    "Sertifikat Magang Kelulusan Resmi & Penilaian Sekolah"
  ],
  assessment: [
    { aspek: "Kerapian Layout & Responsivitas UI", bobot: "35%", ket: "Tampilan antarmuka yang presisi di layar desktop, tablet, dan smartphone." },
    { aspek: "Clean Code & Reusability Component", bobot: "30%", ket: "Struktur komponen HTML/Astro yang terorganisir, rapi, dan modular." },
    { aspek: "Kedisiplinan & Logbook PKL SMK", bobot: "20%", ket: "Kedisiplinan kehadiran, pengisian jurnal magang harian, & milestone tugas." },
    { aspek: "Presentasi Karya Akhir Proyek", bobot: "15%", ket: "Kemampuan memaparkan alur pengerjaan website saat evaluasi kelulusan." }
  ],
  crossCollab: "Penerjemahan aset UI/UX wireframe dari tim DKV ke dalam kode frontend Astro/Bootstrap serta koordinasi deployment server bersama tim TKJ.",
  gallery: [
    "/assets/img/rpl1.webp",
    "/assets/img/rpl2.webp",
    "/assets/img/rpl3.webp"
  ],
  faqs: [
    { q: "Apakah perlu menguasai JavaScript tingkat lanjut?", a: "Tidak harus master, minimal memahami logika dasar pemrograman. Mentor akan membimbing dari penyesuaian awal." },
    { q: "Apakah sertifikat magang diakui oleh pihak sekolah/SMK?", a: "Sangat diakui. Sertifikat dilengkapi dengan daftar nilai kompetensi yang disesuaikan dengan kurikulum vokasi SMK." },
    { q: "Apakah diajarkan pembuatan web di Blogspot juga?", a: "Ya, selain Astro Framework, peserta diajarkan mengolah Blogspot menjadi landing page komersial yang rapi dan responsif." }
  ],
  technicalGuide: {
    headline: "Informasi Teknis & Standar Pelaksanaan Magang RPL 2026",
    paragraph1: "Spesialisasi Rekayasa Perangkat Lunak difokuskan pada ketelitian struktur kode dan kerapian antarmuka. Peserta dilatih membangun arsitektur kode modular berbasis komponen yang mudah dirawat.",
    points: [
      "1. Standar Kerapian Kode: Mengikuti pedoman penulisan kode standar pengembang frontend industri global.",
      "2. Optimasi Beban Aset Visual: Implementasi format gambar modern (WebP/AVIF) untuk mempercepat muat situs.",
      "3. Verifikasi Repositori GitHub: Dokumentasi commit dan pull request berkala sebagai bukti otentik portofolio.",
      "4. Validasi Jurnal PKL: Penandatanganan berkas resmi magang sekolah secara berkala oleh mentor industri."
    ]
  }
};
---

<BaseLayout title={`${data.title} - Gemilang Training`} isHome={false}>
  <Navbar slot="header" />

  <section class="py-8 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div>
      <a href="/program" class="inline-flex items-center gap-2 text-xs md:text-sm text-tc-accent hover:underline font-semibold">
        &larr; Kembali ke Daftar Semua Program Magang
      </a>
    </div>

    <!-- HEADER SECTION -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div class="bg-tc-card p-3 rounded-2xl border border-tc-border shadow-2xl overflow-hidden">
        <img src={data.img} alt={data.title} class="w-full h-auto max-h-[380px] object-cover rounded-xl" />
      </div>

      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border shadow-2xl space-y-6">
        <div class="border-b border-tc-border pb-4 flex items-center justify-between">
          <div>
            <span class="text-xs text-tc-muted block">Status Pendaftaran</span>
            <span class="text-base font-bold text-white">Gelombang Aktif 2026</span>
          </div>
          <span class="text-xs bg-tc-accent/20 text-tc-accent border border-tc-accent/40 px-3 py-1 rounded-full font-semibold">Buka</span>
        </div>

        <div>
          <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest block mb-1">
            {data.category}
          </span>
          <h1 class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight">
            {data.title}
          </h1>
          <p class="text-tc-muted text-xs md:text-sm leading-relaxed">
            {data.desc}
          </p>
        </div>

        <div class="space-y-2 text-xs text-tc-muted border-t border-tc-border/60 pt-4">
          <div class="flex justify-between">
            <span>Target Pendaftar:</span>
            <strong class="text-white">{data.jurusanTarget}</strong>
          </div>
          <div class="flex justify-between">
            <span>Pembimbing/Mentor:</span>
            <strong class="text-tc-accent">{data.mentor}</strong>
          </div>
          <div class="flex justify-between">
            <span>Durasi Program:</span>
            <strong class="text-white">{data.durasi}</strong>
          </div>
        </div>

        <div class="space-y-3 pt-2">
          <a 
            href={`https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20tertarik%20pilih%20Program%20${encodeURIComponent(data.title)}.`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="block w-full text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold py-3.5 rounded-xl transition-all shadow-lg text-sm hover:scale-[1.02]"
          >
            Daftar Program Ini Sekarang via WA
          </a>
          <a href="/program" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white font-medium py-3 rounded-xl transition-all text-xs">
            Cek Pilihan Program Lainnya
          </a>
        </div>
      </div>
    </div>

    <!-- DETAIL CONTENT STACKED -->
    <div class="space-y-12">
      <!-- 1. KUALIFIKASI -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Prasyarat & Kualifikasi Peserta
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {data.kualifikasi.map((kual) => (
            <div class="flex items-start gap-3 bg-tc-bg/70 p-4 rounded-xl border border-tc-border/60">
              <span class="text-tc-accent font-bold mt-0.5">✓</span>
              <span class="text-tc-text text-xs md:text-sm font-medium leading-relaxed">{kual}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 2. FASILITAS -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Fasilitas & Benefit Magang Termasuk
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {data.fasilitas.map((fasi) => (
            <div class="flex items-center gap-3 bg-tc-bg/70 p-4 rounded-xl border border-tc-border/60">
              <span class="w-2 h-2 rounded-full bg-tc-accent flex-shrink-0"></span>
              <span class="text-tc-text text-xs md:text-sm font-medium">{fasi}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 3. PENILAIAN -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border space-y-6">
        <div>
          <h2 class="text-lg md:text-xl font-bold text-white mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"></path></svg>
            Kriteria & Bobot Penilaian Kelulusan SMK
          </h2>
          <p class="text-tc-muted text-xs md:text-sm">
            Penilaian resmi disesuaikan dengan formulir evaluasi PKL/Magang dari Sekolah Menengah Kejuruan (SMK).
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {data.assessment.map((ass) => (
            <div class="bg-tc-bg/70 p-4 rounded-xl border border-tc-border/60 space-y-1.5">
              <div class="flex justify-between items-center">
                <span class="text-white font-bold text-xs md:text-sm">{ass.aspek}</span>
                <span class="text-xs font-mono font-bold text-tc-accent bg-tc-card px-2 py-0.5 rounded border border-tc-border">{ass.bobot}</span>
              </div>
              <p class="text-tc-muted text-xs leading-relaxed">{ass.ket}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 4. GALERI BIMBINGAN KHUSUS RPL -->
      <div>
        <h2 class="text-lg md:text-xl font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          Dokumentasi & Galeri Bimbingan RPL
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {data.gallery.map((imgUrl) => (
            <div class="h-40 md:h-48 rounded-xl overflow-hidden border border-tc-border bg-tc-card shadow-md">
              <img src={imgUrl} alt="Dokumentasi Bimbingan RPL" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
            </div>
          ))}
        </div>
      </div>

      <!-- 5. SILABUS & TOOLS -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-6">Materi Silabus & Tools Pembelajaran RPL</h2>
        <div class="space-y-4 mb-8">
          {data.curriculum.map((curr, idx) => (
            <div class="flex items-start gap-3 border-b border-tc-border/40 pb-3 last:border-none">
              <span class="w-6 h-6 rounded-full bg-tc-bg border border-tc-border text-tc-accent text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">{idx + 1}</span>
              <span class="text-tc-muted text-xs md:text-sm leading-relaxed">{curr}</span>
            </div>
          ))}
        </div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3">Tools & Framework Utama:</h3>
        <div class="flex flex-wrap gap-2">
          {data.tools.map((t) => (
            <span class="text-xs bg-tc-bg px-3 py-1.5 rounded-lg text-tc-accent border border-tc-border font-mono">{t}</span>
          ))}
        </div>
      </div>

      <!-- 6. FAQ ACCORDION -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-6">Pertanyaan Sering Diajukan (FAQ)</h2>
        <div class="space-y-3">
          {data.faqs.map((faq) => (
            <details class="bg-tc-bg/70 p-4 rounded-xl border border-tc-border/60 group cursor-pointer">
              <summary class="text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>{faq.q}</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform duration-300">▼</span>
              </summary>
              <p class="text-tc-muted text-xs md:text-sm mt-3 pt-3 border-t border-tc-border/40 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>