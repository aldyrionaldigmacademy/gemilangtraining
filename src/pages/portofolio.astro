---
// src/pages/portofolio.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { portofolios } from '../data/portofolioData';

const formattedPortofolios = portofolios.map((item) => {
  const isYudharta =
    item.title.toLowerCase().includes('yudharta') ||
    item.mitra.toLowerCase().includes('yudharta');

  if (!isYudharta) return item;

  return {
    ...item,
    slug: 'kemitraan-industri-magang-mahasiswa-poliwangi',
    mitra: 'Politeknik Negeri Banyuwangi (Poliwangi)',
    lokasi: 'Banyuwangi, Jawa Timur',
    title: 'Kemitraan Industri & Magang Mahasiswa Poliwangi',
    desc: 'Kolaborasi program magang mahasiswa Politeknik Negeri Banyuwangi (Poliwangi) dalam pengembangan website modern, optimasi SEO, dan proyek digital terapan bersama mentor industri.',
    tags: item.tags.map((t) =>
      t.toLowerCase().includes('yudharta') ? 'Poliwangi' : t
    ),
  };
});
---

<BaseLayout title="Portofolio Dokumentasi Karya & Studi Kasus - Gemilang Training" isHome={false}>
  <Navbar slot="header" />

  <section class="py-12 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Portofolio & Studi Kasus
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Portofolio Aktivitas & Karya Terapan
      </h1>
      <p class="text-tc-muted text-base md:text-lg">
        Dokumentasi komprehensif implementasi teknologi, pelatihan kejuruan vokasi, dan kerja sama industri Gemilang Training. Hubungi tim kami untuk berkonsultasi mengenai detail pengerjaan proyek.
      </p>
    </div>

    <!-- Filter Buttons Interaktif -->
    <div class="flex flex-wrap justify-center gap-2 mb-12">
      <button 
        data-filter="all" 
        class="filter-btn active-filter px-4 py-2 rounded-xl text-xs font-bold transition-all border border-tc-accent bg-tc-accent text-slate-950 cursor-pointer"
      >
        Semua Kategori
      </button>
      <button 
        data-filter="vokasi" 
        class="filter-btn px-4 py-2 rounded-xl text-xs font-medium transition-all border border-tc-border bg-tc-card text-tc-muted hover:text-white cursor-pointer"
      >
        Vokasi & Pelatihan
      </button>
      <button 
        data-filter="web-fintech" 
        class="filter-btn px-4 py-2 rounded-xl text-xs font-medium transition-all border border-tc-border bg-tc-card text-tc-muted hover:text-white cursor-pointer"
      >
        Web & Fintech
      </button>
      <button 
        data-filter="edukasi-marketing" 
        class="filter-btn px-4 py-2 rounded-xl text-xs font-medium transition-all border border-tc-border bg-tc-card text-tc-muted hover:text-white cursor-pointer"
      >
        Edukasi & Digital Marketing
      </button>
      <button 
        data-filter="media" 
        class="filter-btn px-4 py-2 rounded-xl text-xs font-medium transition-all border border-tc-border bg-tc-card text-tc-muted hover:text-white cursor-pointer"
      >
        Media Digital
      </button>
      <button 
        data-filter="branding" 
        class="filter-btn px-4 py-2 rounded-xl text-xs font-medium transition-all border border-tc-border bg-tc-card text-tc-muted hover:text-white cursor-pointer"
      >
        Branding & Merchandise
      </button>
    </div>

    <!-- Grid Portofolio (3 Kolom) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {formattedPortofolios.map((item) => {
        const waMessage = `Halo Admin Gemilang Training, saya tertarik dan ingin menanyakan detail mengenai proyek "${item.title}" (${item.mitra}).`;
        const waUrl = `https://wa.me/6281943431484?text=${encodeURIComponent(waMessage)}`;

        return (
          <div 
            class="portofolio-card bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between shadow-xl"
            data-category={item.category}
          >
            <div>
              <!-- Header Image -->
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="block h-56 overflow-hidden relative border-b border-tc-border/60">
                <img 
                  src={item.img} 
                  alt={item.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                  {item.badge}
                </span>
                {item.featured && (
                  <span class="absolute top-3 right-3 bg-emerald-500/90 text-slate-950 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow">
                    Unggulan
                  </span>
                )}
              </a>

              <!-- Content Body -->
              <div class="p-6 space-y-3">
                <div class="flex justify-between items-center text-xs text-tc-accent font-semibold border-b border-tc-border/40 pb-2">
                  <span>📍 {item.mitra}</span>
                  <span class="text-tc-muted">{item.lokasi}</span>
                </div>

                <h3 class="text-lg font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
                  <a href={waUrl} target="_blank" rel="noopener noreferrer" class="hover:text-tc-accent transition-colors">
                    {item.title}
                  </a>
                </h3>

                <p class="text-tc-muted text-xs leading-relaxed line-clamp-3">
                  {item.desc}
                </p>

                <!-- Tags / Skill list -->
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {item.tags.map((tag) => (
                    <span class="text-[10px] bg-tc-bg px-2.5 py-1 rounded-md text-tc-muted border border-tc-border/60 font-mono">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Direct Redirect to WhatsApp -->
            <div class="px-6 pb-6 pt-3 border-t border-tc-border/40">
              <a 
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-2.5 rounded-xl bg-tc-bg hover:bg-tc-accent hover:text-slate-950 text-center text-xs font-bold text-tc-accent border border-tc-border hover:border-tc-accent transition-all duration-300"
              >
                Konsultasi Proyek via WA &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Banner Penutup CTA -->
    <div class="mt-20 bg-tc-card border border-tc-border rounded-3xl p-8 md:p-12 text-center shadow-2xl relative overflow-hidden">
      <h2 class="text-2xl md:text-4xl font-extrabold text-white mb-4">
        Ingin Membangun Portofolio Nyata Seperti Ini?
      </h2>
      <p class="text-tc-muted max-w-2xl mx-auto text-xs md:text-sm mb-8">
        Program Magang Informatika di Kota Malang membuka kesempatan bagi siswa SMK dan mahasiswa untuk menggarap proyek langsung bersama mentor industri.
      </p>
      <a 
        href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20mendaftar%20Program%20Magang." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-8 py-3.5 rounded-xl transition-all inline-block shadow-lg hover:scale-105 text-sm"
      >
        Daftar Sekarang &rarr;
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  // Logika Filter Kategori Portofolio Interaktif
  function initPortofolioFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const portofolioCards = document.querySelectorAll('.portofolio-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter');

        // Reset styling tombol filter
        filterBtns.forEach(b => {
          b.classList.remove('bg-tc-accent', 'text-slate-950', 'font-bold', 'border-tc-accent');
          b.classList.add('bg-tc-card', 'text-tc-muted', 'font-medium', 'border-tc-border');
        });

        // Terapkan styling aktif ke tombol yang diklik
        btn.classList.remove('bg-tc-card', 'text-tc-muted', 'font-medium', 'border-tc-border');
        btn.classList.add('bg-tc-accent', 'text-slate-950', 'font-bold', 'border-tc-accent');

        // Filter kartu portofolio
        portofolioCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (filterValue === 'all' || cardCategory === filterValue) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  // Eksekusi fungsi saat pertama kali dimuat & pada navigasi Astro View Transitions
  initPortofolioFilter();
  document.addEventListener('astro:page-load', initPortofolioFilter);
</script>