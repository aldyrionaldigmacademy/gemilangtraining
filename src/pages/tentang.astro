---
// src/pages/tentang.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Tentang Kami - Gemilang Training Malang" isHome={false}>
  <Navbar slot="header" />

  <!-- 1. HERO TENTANG KAMI -->
  <section class="pt-16 pb-12 md:pt-24 md:pb-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Profil & Aktivasi Gemilang Training
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6 leading-tight">
        Akselerator Portofolio Industri untuk Mahasiswa & SMK
      </h1>
      <p class="text-tc-muted text-base md:text-lg leading-relaxed">
        <strong class="text-white">Gemilang Training</strong> adalah platform inkubasi magang berbasis proyek nyata yang dirancang khusus untuk mahasiswa dan siswa SMK. Kami mentransformasi teori perkuliahan dan sekolah menjadi portofolio kerja otentik yang memenuhi standar tinggi industri digital.
      </p>
    </div>
  </section>

  <!-- 2. SECTION PENJELASAN -->
  <section class="py-16 bg-tc-card/50 border-y border-tc-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Kolom Kiri: Teks Pengertian -->
        <div class="space-y-6">
          <span class="text-xs font-semibold text-tc-accent uppercase tracking-wider">Mengenal Lebih Dekat</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white">Apa itu Gemilang Training?</h2>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            Banyak mahasiswa dan siswa SMK menghadapi kendala saat melamar kerja karena ketiadaan portofolio proyek industri yang meyakinkan. Gemilang Training hadir sebagai solusi untuk mengisi celah antara kurikulum akademik dengan kebutuhan nyata di lapangan.
          </p>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            Di Gemilang Training, peserta dari rumpun <strong class="text-white">Informatika, Digital Marketing, Bisnis Digital, Pemasaran, DKV, dan Multimedia</strong> tidak sekadar menjalankan rutinitas magang formalitas. Setiap peserta digabungkan dalam tim kolaboratif untuk menggarap proyek nyata di bawah bimbingan langsung mentor praktisi berpengalaman.
          </p>
          <div class="pt-2">
            <a href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20bertanya%20mengenai%20program%20magang." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-tc-accent hover:underline">
              Konsultasi Program Magang &rarr;
            </a>
          </div>
        </div>

        <!-- Kolom Kanan: Gambar Representatif -->
        <div class="bg-tc-card p-3 rounded-2xl border border-tc-border shadow-2xl flex justify-center items-center">
          <img 
            src="/assets/img/tentang.webp" 
            alt="Sesi Bimbingan Mentor Gemilang Training" 
            class="w-full h-auto max-h-[380px] object-cover rounded-xl shadow-md"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- 3. VISI & MISI -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Visi Card -->
      <div class="bg-tc-card p-8 rounded-2xl border border-tc-border">
        <div class="w-12 h-12 rounded-xl bg-tc-bg border border-tc-border flex items-center justify-center text-tc-accent mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">Visi Utama</h2>
        <p class="text-tc-muted leading-relaxed text-sm md:text-base">
          Menjadi platform magang berbasis proyek terdepan di Indonesia yang melahirkan lulusan mahasiswa dan SMK berdaya saing tinggi, kompeten, dan menguasai portofolio digital berstandar profesional.
        </p>
      </div>

      <!-- Misi Card -->
      <div class="bg-tc-card p-8 rounded-2xl border border-tc-border">
        <div class="w-12 h-12 rounded-xl bg-tc-bg border border-tc-border flex items-center justify-center text-tc-accent mb-6">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">Misi Strategis</h2>
        <ul class="space-y-3 text-tc-muted text-sm md:text-base">
          <li class="flex items-start gap-2">
            <span class="text-tc-accent font-bold mt-1">✓</span>
            <span>Menyediakan lingkungan kerja simulasi Agile berbasis proyek nyata industri.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-tc-accent font-bold mt-1">✓</span>
            <span>Memfasilitasi kolaborasi lintas jurusan antar peserta (Tech, Marketing, & Design).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-tc-accent font-bold mt-1">✓</span>
            <span>Menjamin setiap alumni mengantongi sertifikat resmi serta bukti portofolio yang terverifikasi.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. KEUNGGULAN METODE BERSAMA GEMILANG TRAINING -->
  <section class="py-16 bg-tc-card/30 border-t border-tc-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Mengapa Memilih Gemilang Training?</h2>
        <p class="text-tc-muted text-sm md:text-base">
          Struktur bimbingan dirancang sistematis agar ramah bagi peserta sekaligus diakui oleh rekruter profesional.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Keunggulan 1 -->
        <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
          <div class="w-10 h-10 rounded-lg bg-tc-bg border border-tc-border flex items-center justify-center text-tc-accent mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Project-Based Learning</h3>
          <p class="text-tc-muted text-sm leading-relaxed">
            Peserta langsung terjun menggarap produk dan layanan digital otentik, bukan sekadar tugas administratif.
          </p>
        </div>

        <!-- Keunggulan 2 -->
        <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
          <div class="w-10 h-10 rounded-lg bg-tc-bg border border-tc-border flex items-center justify-center text-tc-accent mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Cross-Department Teamwork</h3>
          <p class="text-tc-muted text-sm leading-relaxed">
            Menyimulasikan alur kerja startup nyata: anak Informatika/RPL berkolaborasi erat dengan tim Marketing dan DKV.
          </p>
        </div>

        <!-- Keunggulan 3 -->
        <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
          <div class="w-10 h-10 rounded-lg bg-tc-bg border border-tc-border flex items-center justify-center text-tc-accent mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Industry Mentorship & Verification</h3>
          <p class="text-tc-muted text-sm leading-relaxed">
            Setiap pengerjaan dievaluasi langsung oleh mentor praktisi, menghasilkan bukti karya live serta sertifikat resmi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. BANNER CTA PENUTUP -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-tc-card border border-tc-border rounded-3xl p-8 md:p-12 text-center shadow-xl">
      <h2 class="text-2xl md:text-4xl font-extrabold text-white mb-4">Siap Cetak Portofolio Industri Pertama Kamu?</h2>
      <p class="text-tc-muted max-w-2xl mx-auto text-sm md:text-base mb-8">
        Konsultasikan kebutuhan magang atau pengajuan resmi kampus/sekolah kamu langsung ke tim pendaftaran kami via WhatsApp.
      </p>
      <a href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20bertanya%20mengenai%20program%20magang." target="_blank" rel="noopener noreferrer" class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-8 py-4 rounded-xl transition-all inline-block shadow-lg hover:scale-105">
        Hubungi Gemilang Training
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>