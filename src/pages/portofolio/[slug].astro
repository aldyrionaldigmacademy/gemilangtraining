---
// src/pages/portofolio/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { portofolios, type PortofolioItem } from '../../data/portofolioData';

export function getStaticPaths() {
  return portofolios.map((item) => ({
    params: { slug: item.slug },
    props: { project: item }
  }));
}

interface Props {
  project: PortofolioItem;
}

const { project } = Astro.props;

// Ambil 2 proyek lainnya untuk bagian Proyek Terkait
const otherProjects = portofolios.filter((p) => p.slug !== project.slug).slice(0, 2);

// Schema.org Article / CaseStudy JSON-LD
const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": project.title,
  "description": project.subtitle,
  "image": project.img,
  "author": {
    "@type": "Organization",
    "name": "Gemilang Training"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Gemilang Training",
    "logo": {
      "@type": "ImageObject",
      "url": "https://infomagangmalang.web.id/logo.webp"
    }
  },
  "about": {
    "@type": "Thing",
    "name": project.badge
  }
};
---

<BaseLayout 
  title={`${project.title} - Studi Kasus Portofolio Gemilang Training`} 
  description={project.subtitle}
  image={project.img}
  isHome={false}
  hideBreadcrumb={true}
>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />
  </slot>

  <Navbar slot="header" />

  <!-- ======================================================= -->
  <!-- 1. CORPORATE PAGE HERO SECTION                         -->
  <!-- ======================================================= -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden border-b border-tc-border/60 bg-gradient-to-b from-tc-card/80 via-tc-bg to-tc-bg">
    <!-- Subtle glow effect -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-tc-accent/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 bg-tc-card/90 border border-tc-accent/30 text-tc-accent px-4 py-2 rounded-full text-xs font-semibold tracking-wide shadow-lg mb-6">
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>Studi Kasus Portofolio Proyek</span>
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
        {project.title}
      </h1>

      <!-- Subtitle -->
      <p class="text-tc-muted text-base sm:text-lg md:text-xl max-w-3xl mx-auto leading-relaxed mb-8">
        {project.subtitle}
      </p>

      <!-- Breadcrumbs Corporate -->
      <nav aria-label="Breadcrumb" class="inline-flex items-center gap-2 text-xs md:text-sm text-tc-muted bg-tc-card/60 backdrop-blur-md px-5 py-2.5 rounded-full border border-tc-border">
        <a href="/" class="hover:text-tc-accent transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Beranda
        </a>
        <span class="text-tc-border">/</span>
        <a href="/portofolio" class="hover:text-tc-accent transition-colors">Portofolio</a>
        <span class="text-tc-border">/</span>
        <span class="text-white font-medium truncate max-w-[200px] sm:max-w-xs">{project.title}</span>
      </nav>

    </div>
  </section>

  <!-- ======================================================= -->
  <!-- 2. FLOATING STAT COUNTER BAR                           -->
  <!-- ======================================================= -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20 mb-16">
    <div class="bg-tc-card/95 backdrop-blur-md border border-tc-border rounded-2xl shadow-2xl p-6 md:p-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 divide-y lg:divide-y-0 lg:divide-x divide-tc-border/60">
        {project.stats.map((stat, idx) => (
          <div class={`flex items-center gap-4 ${idx > 0 && idx % 2 === 0 ? 'pt-6 lg:pt-0' : ''} ${idx === 1 ? 'pt-0' : ''} ${idx > 0 ? 'lg:pl-6' : ''}`}>
            <div class="w-12 h-12 rounded-xl bg-tc-bg border border-tc-border flex items-center justify-center shrink-0 text-tc-accent shadow-inner">
              {stat.icon === 'speedometer' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              )}
              {stat.icon === 'trending-up' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              )}
              {stat.icon === 'trending-down' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6"></path></svg>
              )}
              {stat.icon === 'clock' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              )}
              {stat.icon === 'calendar' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              )}
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">{stat.value}</div>
              <div class="text-xs text-tc-muted font-medium mt-0.5">{stat.label}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- 3. MAIN CASE STUDY CONTENT CONTAINER                   -->
  <!-- ======================================================= -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 pb-20">

    <!-- SUBSECTION 1: RINGKASAN EKSEKUTIF & SIDEBAR METADATA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column (8 cols): Executive Summary & Featured Image -->
      <div class="lg:col-span-8 space-y-6">
        
        <!-- Direct Answer / Executive Summary Box -->
        <div class="bg-tc-card rounded-2xl border border-tc-border p-6 sm:p-8 shadow-xl relative overflow-hidden">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="bg-tc-accent/20 border border-tc-accent text-tc-accent text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
              {project.executiveSummary.badge}
            </span>
            <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              {project.executiveSummary.verified}
            </span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3">
            {project.executiveSummary.title}
          </h2>

          <p class="text-tc-muted text-sm sm:text-base leading-relaxed">
            {project.executiveSummary.content}
          </p>
        </div>

        <!-- Featured Image with Badge overlay -->
        <div class="rounded-2xl border border-tc-border overflow-hidden bg-tc-card shadow-2xl relative group">
          <div class="h-72 sm:h-96 w-full overflow-hidden">
            <img 
              src={project.img} 
              alt={project.title} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <!-- Bottom overlay banner -->
          <div class="p-4 bg-tc-card/95 border-t border-tc-border flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <span class="text-xs text-tc-muted flex items-center gap-2">
              <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              {project.executiveSummary.caption}
            </span>
            <span class="text-xs font-semibold px-3 py-1 rounded-md bg-emerald-950/80 border border-emerald-500/40 text-emerald-300">
              {project.executiveSummary.metricBadge}
            </span>
          </div>
        </div>

      </div>

      <!-- Right Column (4 cols): Metadata Proyek Sticky -->
      <div class="lg:col-span-4">
        <div class="bg-tc-card rounded-2xl border border-tc-border p-6 shadow-xl sticky top-28 space-y-5">
          <div class="flex items-center gap-2 border-b border-tc-border pb-4">
            <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-base font-bold text-white">Metadata Proyek</h3>
          </div>

          <!-- Klien / Mitra -->
          <div>
            <span class="text-xs text-tc-muted block mb-1">Klien / Institusi Mitra:</span>
            <span class="text-sm font-semibold text-white block">📍 {project.metadata.client}</span>
            <span class="text-xs text-tc-accent">{project.lokasi}</span>
          </div>

          <!-- Kategori Jasa -->
          <div>
            <span class="text-xs text-tc-muted block mb-1.5">Kategori Bidang:</span>
            <span class="inline-block text-xs font-bold text-tc-accent bg-tc-bg px-3 py-1.5 rounded-lg border border-tc-border">
              {project.metadata.category}
            </span>
          </div>

          <!-- Pendekatan Desain -->
          <div>
            <span class="text-xs text-tc-muted block mb-1">Pendekatan & Metode:</span>
            <span class="text-xs font-medium text-white leading-relaxed block">
              {project.metadata.approach}
            </span>
          </div>

          <!-- Stack Teknologi -->
          <div>
            <span class="text-xs text-tc-muted block mb-2">Teknologi & Tools:</span>
            <div class="flex flex-wrap gap-1.5">
              {project.metadata.stack.map((item) => (
                <span class="text-[11px] bg-tc-bg text-tc-muted px-2.5 py-1 rounded-md border border-tc-border/80 font-mono">
                  {item}
                </span>
              ))}
            </div>
          </div>

          <!-- Durasi Pengerjaan -->
          <div>
            <span class="text-xs text-tc-muted block mb-1">Durasi Pengerjaan:</span>
            <span class="text-xs font-semibold text-white block">
              ⏱ {project.metadata.duration}
            </span>
          </div>

          <!-- Tim Pelaksana -->
          <div class="border-b border-tc-border pb-5">
            <span class="text-xs text-tc-muted block mb-1">Tim Mentor & Peserta:</span>
            <span class="text-xs text-tc-muted block leading-relaxed">
              👥 {project.metadata.team}
            </span>
          </div>

          <!-- CTA Button -->
          <div>
            <a 
              href={project.metadata.consultationUrl || "https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20tertarik%20konsultasi%20mengenai%20proyek%20portofolio"} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold py-3 px-4 rounded-xl transition-all duration-300 block text-xs shadow-lg hover:scale-[1.02]"
            >
              Konsultasikan Proyek Serupa &rarr;
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- SUBSECTION 2: TANTANGAN VS SOLUSI (DUAL-CARD CONTRAST) -->
    <div class="space-y-6">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-1.5 rounded-full border border-tc-border inline-block mb-2">
          Studi Komparasi Kasus
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white">Tantangan Lapangan vs Solusi Rekayasa</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Kartu Tantangan (Red/Rose accent) -->
        <div class="bg-tc-card rounded-2xl border border-rose-500/30 p-6 sm:p-8 space-y-4 shadow-xl relative overflow-hidden">
          <div class="flex items-center gap-3 border-b border-rose-500/20 pb-4">
            <div class="w-10 h-10 rounded-xl bg-rose-950/60 border border-rose-500/30 flex items-center justify-center text-rose-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
            <div>
              <h4 class="text-base sm:text-lg font-bold text-white">Tantangan & Kendala Awal</h4>
              <span class="text-xs text-rose-400 font-medium">Permasalahan Sebelum Intervensi</span>
            </div>
          </div>

          <ul class="space-y-3.5 text-xs sm:text-sm text-tc-muted">
            {project.challenges.map((c) => (
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <strong class="text-white block mb-0.5">{c.title}:</strong>
                  <span>{c.desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Kartu Solusi (Emerald/Success accent) -->
        <div class="bg-tc-card rounded-2xl border border-emerald-500/30 p-6 sm:p-8 space-y-4 shadow-xl relative overflow-hidden">
          <div class="flex items-center gap-3 border-b border-emerald-500/20 pb-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-950/60 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div>
              <h4 class="text-base sm:text-lg font-bold text-white">Solusi Rekayasa Gemilang Training</h4>
              <span class="text-xs text-emerald-400 font-medium">Intervensi Arsitektur & Pelatihan Terapan</span>
            </div>
          </div>

          <ul class="space-y-3.5 text-xs sm:text-sm text-tc-muted">
            {project.solutions.map((s) => (
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <div>
                  <strong class="text-white block mb-0.5">{s.title}:</strong>
                  <span>{s.desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

    <!-- SUBSECTION 3: STRATEGI & ALUR KERJA 3 TAHAP -->
    <div class="bg-tc-card rounded-3xl border border-tc-border p-6 sm:p-10 shadow-2xl space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-bg px-4 py-1.5 rounded-full border border-tc-border inline-block">
          Metodologi Pengerjaan
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white">Tahapan Eksekusi Terstruktur</h3>
        <p class="text-tc-muted text-xs sm:text-sm">
          Setiap fase dijalankan dengan standar industri agency serta pendampingan langsung oleh mentor kepada peserta magang.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {project.workflow.map((item, idx) => (
          <div class="bg-tc-bg rounded-2xl border border-tc-border p-6 flex flex-col justify-between space-y-4 hover:border-tc-accent transition-all duration-300">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class={`text-xs font-bold px-3 py-1 rounded-full ${idx === 0 ? 'bg-primary-950 text-blue-400 border border-blue-500/30' : idx === 1 ? 'bg-emerald-950 text-emerald-400 border border-emerald-500/30' : 'bg-amber-950 text-amber-400 border border-amber-500/30'}`}>
                  {item.stage}
                </span>
                <span class="text-[11px] text-tc-muted font-mono">{item.timeline}</span>
              </div>
              <h4 class="text-base font-bold text-white mb-2">{item.title}</h4>
              <p class="text-xs text-tc-muted leading-relaxed">{item.desc}</p>
            </div>
            <div class="border-t border-tc-border/60 pt-3 flex items-center gap-1.5 text-xs text-tc-accent font-medium">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>{item.badge}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- SUBSECTION 4: PERBANDINGAN HASIL NYATA (BEFORE VS AFTER TABLE) -->
    <div class="space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-1.5 rounded-full border border-tc-border inline-block">
          Metrik Dampak Nyata
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white">Perbandingan Sebelum vs Sesudah Implementasi</h3>
        <p class="text-tc-muted text-xs sm:text-sm">
          Hasil riil yang terverifikasi melalui pengukuran analitik dan uji kinerja pasca peluncuran solusi.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-tc-border bg-tc-card shadow-2xl">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-tc-bg border-b border-tc-border text-tc-muted uppercase font-mono text-[11px]">
            <tr>
              <th scope="col" class="py-4 px-6">Parameter Pengukuran</th>
              <th scope="col" class="py-4 px-6 text-rose-400">Kondisi Awal (Sebelum)</th>
              <th scope="col" class="py-4 px-6 text-emerald-400">Kondisi Baru (Sesudah)</th>
              <th scope="col" class="py-4 px-6 text-tc-accent">Hasil Peningkatan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-tc-border/60">
            {project.impactMetrics.map((row) => (
              <tr class="hover:bg-tc-bg/50 transition-colors">
                <td class="py-4 px-6 font-semibold text-white flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-tc-accent shrink-0"></span>
                  {row.param}
                </td>
                <td class="py-4 px-6 text-rose-400/90 font-medium">{row.before}</td>
                <td class="py-4 px-6 text-emerald-400 font-bold">{row.after}</td>
                <td class="py-4 px-6">
                  <span class="inline-block bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 font-bold text-xs px-3 py-1 rounded-md">
                    {row.improvement}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- SUBSECTION 5: PILAR MAGANG & KOMPETENSI PESERTA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Kolom Kiri: Highlight Pilar Magang (5 cols) -->
      <div class="lg:col-span-5 bg-gradient-to-br from-[#0F2B48] to-[#1E3D60] rounded-2xl border border-blue-400/30 p-6 sm:p-8 flex flex-col justify-between shadow-2xl text-white">
        <div class="space-y-4">
          <span class="inline-block text-xs font-bold text-slate-950 bg-tc-accent px-3 py-1.5 rounded-full uppercase tracking-wider">
            {project.internshipPillars.badge}
          </span>
          <h4 class="text-xl sm:text-2xl font-extrabold text-white leading-tight">
            {project.internshipPillars.title}
          </h4>
