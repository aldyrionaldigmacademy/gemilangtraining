---
// src/pages/blog/magang-mahasiswa-informatika-malang1.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Magang Mahasiswa Informatika Malang Jalur dan Cara Daftar";
const pageDesc = "Panduan magang mahasiswa informatika Malang: tugas nyata, skill, tools, output portofolio, dan alur daftar. Baca sekarang dan siapkan langkah pertamamu.";
const pageUrl = "https://infomagangmalang.web.id/blog/magang-mahasiswa-informatika-malang1";
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/magang-mahasiswa-informatika-malang-1a.webp";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
