---
// src/pages/blog/contoh-surat-lamaran-magang-mahasiswa.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Contoh Surat Lamaran Magang Mahasiswa Informatika";
const pageDesc = "Contoh surat lamaran magang mahasiswa Informatika tanpa pengalaman kerja, termasuk format email.";
const publishDate = "2026-11-19";
const publishIsoDate = "2026-11-19T15:00:00+07:00";
const pageSlug = "/blog/contoh-surat-lamaran-magang-mahasiswa";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/contoh-surat-lamaran-magang-mahasiswa-1.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/contoh-surat-lamaran-magang-mahasiswa-2.webp";
const authorName = "Tim Redaksi Gemilang Training";
const keywordsList = "contoh surat lamaran magang mahasiswa, surat lamaran magang informatika, surat lamaran tanpa pengalaman kerja, format surat lamaran email, magang mahasiswa informatika malang";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Organization",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        secondImageUrl
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah surat lamaran dan surat pengantar kampus itu sama?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak. Surat lamaran ditulis sendiri oleh mahasiswa, sedangkan surat pengantar diterbitkan kampus dengan mencantumkan NIM, prodi, dan periode."
          }
        },
        {
          "@type": "Question",
          "name": "Apa yang dilampirkan bersama surat lamaran?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lampirannya CV terbaru, surat pengantar kampus, KHS atau transkrip, dan tautan portofolio atau GitHub. Semuanya dikirim dalam PDF."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama durasi magangnya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durasi yang tersedia 3-6 bulan, dipilih saat mengecek persyaratan dan disesuaikan dengan kewajiban kampus."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/contoh-surat-lamaran-magang-mahasiswa-1.webp"
  imageAlt="Mahasiswa Informatika menulis surat lamaran di laptop dengan GitHub terbuka"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Mahasiswa Informatika menulis surat lamaran di laptop dengan GitHub terbuka" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Template & Format" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Template &amp; Format</span>
            <time datetime={publishIsoDate}>19 November 2026 • 15:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            Contoh Surat Lamaran Magang Mahasiswa Informatika Tanpa Pengalaman Kerja
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/contoh-surat-lamaran-magang-mahasiswa-1.webp" 
            alt="Mahasiswa Informatika menulis surat lamaran di laptop dengan GitHub terbuka" 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Mahasiswa menulis surat lamaran di laptop dengan GitHub terbuka.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
            <span>Daftar Isi Panduan</span>
            <span id="toc-icon" class="text-xs font-bold" style="color: #eab308; font-variant-emoji: text;">▼</span>
          </button>
          <div id="toc-content" class="text-xs text-tc-muted space-y-2 pt-2 border-t border-tc-border/60">
            <ul class="space-y-1.5 list-disc list-inside">
              <li><a href="#cara-menulis" class="hover:text-tc-accent transition-colors">1. Bagaimana Menulis Surat Lamaran Magang?</a></li>
              <li><a href="#tanpa-pengalaman" class="hover:text-tc-accent transition-colors">2. Apa yang Ditulis Jika Belum Punya Pengalaman?</a></li>
              <li><a href="#contoh-surat" class="hover:text-tc-accent transition-colors">3. Seperti Apa Contoh Surat Lamaran untuk Mahasiswa Informatika?</a></li>
              <li><a href="#format-email" class="hover:text-tc-accent transition-colors">4. Bagaimana Format Surat Lamaran Magang via Email?</a></li>
              <li><a href="#cek-sebelum-kirim" class="hover:text-tc-accent transition-colors">5. Apa Saja yang Dicek Sebelum Surat Dikirim?</a></li>
              <li><a href="#kata-alumni" class="hover:text-tc-accent transition-colors">6. Apa Kata Alumni?</a></li>
              <li><a href="#faq-section" class="hover:text-tc-accent transition-colors">7. FAQ Surat Lamaran Magang Mahasiswa</a></li>
            </ul>
          </div>
        </div>

        <div class="space-y-8 text-tc-muted text-sm md:text-base leading-relaxed">
          <p>
            <strong>Contoh surat lamaran magang mahasiswa Informatika tanpa pengalaman kerja</strong> cukup menonjolkan motivasi, skill teknis, dan proyek kuliah. Satu halaman sudah cukup.
          </p>
          <p>
            Di bawah ini ada struktur surat, template untuk Informatika, contoh versi email, dan cek akhir sebelum kirim.
          </p>
          <p>
            Menurut Kristel Gilvarry, Marketing Specialist dan Karir Editor, surat lamaran berfungsi sebagai personal statement. Surat inilah yang dibaca rekruter sebelum CV, jadi harus spesifik soal motivasi dan potensi belajar.
          </p>
          <p>
            Surat lamaran hanya satu bagian dari berkas yang diminta. Daftar lengkapnya ada di <a href="/blog/syarat-pendaftaran-magang-dan-pkl" class="text-tc-accent hover:underline">checklist berkas PKL dan magang</a>.
          </p>

          <section id="cara-menulis" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana Menulis Surat Lamaran Magang?</h2>
            <p>
              Surat lamaran magang ditulis berurutan: tanggal dan tujuan, salam, identitas, paragraf pembuka, isi, lampiran, lalu penutup. Panjangnya cukup satu halaman.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Tempat dan tanggal di pojok kanan atas.</li>
              <li>Tujuan: HRD atau pembimbing di Gemilang Training Malang.</li>
              <li>Salam pembuka formal, "Dengan hormat,".</li>
              <li>Identitas: nama, NIM, jurusan, kampus, domisili, nomor HP, dan email.</li>
              <li>Paragraf pembuka berisi maksud dan bidang yang diminati, misalnya Web Development atau SEO dan konten.</li>
              <li>Paragraf isi berisi skill teknis dan proyek kuliah.</li>
              <li>Daftar lampiran, lalu penutup dan nama terang.</li>
            </ul>
          </section>

          <!-- Gambar 2 -->
          <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
            <img 
              src="/assets/img/contoh-surat-lamaran-magang-mahasiswa-2.webp" 
              alt="Mahasiswi mencetak CV di tempat fotokopi dekat kampus" 
              class="w-full h-auto max-h-[380px] object-cover"
              loading="lazy"
            />
            <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
              Mahasiswa mencetak CV di tempat fotokopi dekat kampus.
            </figcaption>
          </figure>

          <section id="tanpa-pengalaman" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa yang Ditulis Jika Belum Punya Pengalaman?</h2>
            <p>
              Jika belum punya pengalaman kerja, tulis proyek kuliah, skill teknis, dan alasan spesifik memilih tempat tujuan. Ketiganya menggantikan riwayat kerja.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Tonjolkan proyek, misalnya antarmuka responsif Bootstrap, tugas pemrograman web, atau repositori GitHub.</li>
              <li>Sebut skill spesifik: HTML/CSS, Bootstrap, Astro JS, Git, Python, atau Node.js.</li>
              <li>Hindari klaim kosong seperti "saya pekerja keras", tunjukkan buktinya.</li>
            </ul>
            <p>
              Rekruter jarang membaca kalimat klise sampai habis. Tautan GitHub yang aktif lebih meyakinkan.
            </p>
          </section>

          <!-- BACA JUGA BOX SISIPAN -->
          <div class="my-6">
            <a 
              href="/blog/cara-melamar-pkl-lewat-whatsapp" 
              class="block bg-tc-bg hover:bg-tc-card border-l-4 border-tc-accent p-5 rounded-2xl border border-tc-border transition-all shadow-lg group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold text-tc-accent uppercase tracking-wider block mb-1">BACA JUGA PANDUAN PENGIRIMAN</span>
                  <h4 class="text-white font-bold text-sm md:text-base group-hover:text-tc-accent transition-colors">
                    Cara Melamar PKL atau Magang Lewat WhatsApp &amp; Contoh Pesannya &rarr;
                  </h4>
                </div>
              </div>
            </a>
          </div>

          <section id="contoh-surat" class="space-y-4">
            <h2 class="text-xl md:text-2xl font-bold text-white">Seperti Apa Contoh Surat Lamaran untuk Mahasiswa Informatika?</h2>
            <p>
              Berikut template yang bisa kamu salin dan sesuaikan.
            </p>
            <pre class="bg-tc-bg p-5 rounded-2xl border border-tc-border text-xs md:text-sm text-tc-muted font-mono overflow-x-auto whitespace-pre-wrap leading-relaxed">
[Kota], [Tanggal]
Perihal  : Permohonan Magang Mahasiswa
Lampiran : 1 (satu) berkas

Yth. Tim HRD dan Pembimbing Gemilang Training Malang
Mojolangu, Lowokwaru, Kota Malang

Dengan hormat,
Saya yang bertanda tangan di bawah ini:
Nama            : [Nama Lengkap]
NIM             : [NIM]
Program Studi   : [Teknik Informatika / Sistem Informasi]
Perguruan Tinggi: [Nama Kampus]
No. HP/WA       : [Nomor]
Email           : [Email]

Saya mengajukan permohonan magang di Gemilang Training Malang
selama [3 / 6] bulan pada bidang [Web Development / SEO dan Konten].

Saya sudah mempelajari dasar pengembangan web dan Git. Walau
belum punya pengalaman kerja formal, saya mengerjakan proyek
kuliah berupa antarmuka responsif dengan Bootstrap dan mencoba
membuat website cepat dengan Astro JS. Tautan proyek ada di CV.

Saya tertarik pada sistem belajar berbasis proyek nyata dengan
bimbingan mentor praktisi, dan ingin belajar sambil berkontribusi.

Bersama surat ini saya lampirkan:
1. CV terbaru
2. Surat pengantar kampus
3. KHS / transkrip nilai
4. Tautan portofolio / GitHub

Saya berharap dapat mengikuti wawancara singkat dan pemetaan
kemampuan. Terima kasih atas perhatian Bapak/Ibu.

Hormat saya,
(Tanda tangan)
[Nama Lengkap]
            </pre>
          </section>

          <section id="format-email" class="space-y-4">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana Format Surat Lamaran Magang via Email?</h2>
            <p>
              Format via email: isi surat ditulis singkat di badan email, sedangkan CV dan berkas lain dilampirkan sebagai PDF. Subjek harus jelas dan langsung menyebut tujuan.
            </p>
            <p>
              Glints memuat contoh surat lamaran via email sebagai pembanding. Versi di bawah sudah disesuaikan untuk mahasiswa Informatika.
            </p>
            <pre class="bg-tc-bg p-5 rounded-2xl border border-tc-border text-xs md:text-sm text-tc-muted font-mono overflow-x-auto whitespace-pre-wrap leading-relaxed">
Subjek: Lamaran Magang Mahasiswa - [Nama Lengkap] - Informatika

Yth. Tim HRD Gemilang Training Malang,
Perkenalkan, saya [Nama Lengkap], mahasiswa [Prodi] [Kampus].
Saya bermaksud melamar magang selama [3 / 6] bulan di bidang
[Web Development / SEO dan Konten].

Saya melampirkan CV, surat pengantar kampus, KHS, dan tautan
portofolio GitHub. Saya bersedia mengikuti wawancara dan skill
mapping.

Terima kasih atas waktunya.
Hormat saya,
[Nama Lengkap] | [Nomor HP]
            </pre>
            <p>
              Alamat email tujuan sebaiknya dicek di <a href="/kontak" class="text-tc-accent hover:underline">halaman kontak</a>. Kalau belum ada, kirim lewat WhatsApp admin di +62 819-4343-1484.
            </p>
          </section>

          <section id="cek-sebelum-kirim" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa Saja yang Dicek Sebelum Surat Dikirim?</h2>
            <p>
              Sebelum dikirim, periksa nama instansi, kelengkapan identitas, ejaan, panjang surat, dan nama file lampiran. Lima hal ini paling sering terlewat.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Nama tujuan dan bidang yang diminati sudah benar.</li>
              <li>NIM, prodi, dan periode magang tertulis jelas.</li>
              <li>Panjang surat tidak lebih dari satu halaman.</li>
              <li>Lampiran berupa PDF dengan nama rapi, misalnya <code class="text-tc-accent">CV_NamaLengkap_Informatika.pdf</code>.</li>
              <li>Tautan GitHub atau portofolio bisa dibuka.</li>
            </ul>
            <p>
              Setelah itu, tahap berikutnya ada di halaman <a href="/alur-pendaftaran" class="text-tc-accent hover:underline">alur pendaftaran</a>: pengajuan berkas, wawancara singkat, skill mapping, dan penerbitan surat balasan.
            </p>
          </section>

          <section id="kata-alumni" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa Kata Alumni?</h2>
            <blockquote class="bg-tc-bg p-4 rounded-xl border-l-4 border-tc-accent space-y-1">
              <p class="text-white font-semibold text-sm">Fajar Ramadhan (Mahasiswa Informatika, alumni Gemilang Training Malang)</p>
              <p class="text-tc-muted text-xs italic">"Magang di sini beneran ngerjain proyek nyata. Saya yang dari jurusan Informatika jadi paham cara bangun website cepat dengan Astro dan Bootstrap."</p>
            </blockquote>
            <p>
              Karakter program di Gemilang Training memang berbasis proyek nyata dengan direct mentorship. Fokusnya pada website modern (Astro JS, Bootstrap 5, Blogspot), SEO on-page, dan penulisan konten digital.
            </p>
            <p>
              Surat lamaran tanpa pengalaman kerja tetap bisa kuat kalau berisi proyek kuliah, skill teknis, dan motivasi yang spesifik. Satu halaman, bahasa formal, lampiran PDF yang rapi.
            </p>
            <p>
              Gemilang Training melayani Malang untuk mahasiswa Informatika yang ingin belajar lewat proyek nyata. Cek pilihan di halaman <a href="/program" class="text-tc-accent hover:underline">program</a>, lalu kirim berkasmu lewat <a href="/kontak" class="text-tc-accent hover:underline">halaman kontak</a> atau WhatsApp admin di +62 819-4343-1484.
            </p>
          </section>
        </div>

        <!-- KOTAK AUTHOR (PENULIS) -->
        <div class="my-8 p-6 bg-tc-bg border border-tc-border rounded-2xl flex flex-col sm:flex-row items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold text-xl shrink-0">
            GT
          </div>
          <div class="space-y-1 text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start gap-2">
              <h4 class="text-white font-bold text-base">{authorName}</h4>
              <span class="bg-tc-accent/20 text-tc-accent text-[10px] font-semibold px-2 py-0.5 rounded-full border border-tc-accent/40">Verified Author</span>
            </div>
            <p class="text-tc-muted text-xs leading-relaxed">
              Tim redaksi Gemilang Training Malang untuk panduan surat lamaran magang mahasiswa Informatika, portofolio GitHub, dan persiapan seleksi.
            </p>
          </div>
        </div>

        <!-- CTA PROMO WHATSAPP -->
        <div class="bg-gradient-to-r from-tc-bg to-tc-card border border-tc-accent/50 rounded-3xl p-6 md:p-8 text-center space-y-4 shadow-2xl">
          <h3 class="text-xl font-bold text-white">Kirim Lamaran Magang Mahasiswa Informatika</h3>
          <p class="text-tc-muted text-xs md:text-sm max-w-lg mx-auto">
            Siapkan CV, surat pengantar kampus, dan tautan GitHub Anda, lalu kirim ke admin Gemilang Training di Malang.
          </p>
          <a 
            href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20mahasiswa%20Informatika%20ingin%20mengirimkan%20berkas%20lamaran%20magang." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-6 py-3 rounded-xl transition-all shadow-lg text-xs md:text-sm"
          >
            <span>Kirim Lamaran via WA</span>
          </a>
        </div>

        <!-- FAQ ACCORDION SECTION -->
        <section id="faq-section" class="border-t border-tc-border pt-8 space-y-4">
          <h3 class="text-xl font-bold text-white">FAQ Surat Lamaran Magang Mahasiswa</h3>
          <div class="space-y-3">
            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apakah surat lamaran dan surat pengantar kampus itu sama?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Tidak. Surat lamaran ditulis sendiri oleh mahasiswa, sedangkan surat pengantar diterbitkan kampus dengan mencantumkan NIM, prodi, dan periode.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apa yang dilampirkan bersama surat lamaran?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Lampirannya CV terbaru, surat pengantar kampus, KHS atau transkrip, dan tautan portofolio atau GitHub. Semuanya dikirim dalam PDF.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Berapa lama durasi magangnya?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Durasi yang tersedia 3-6 bulan, dipilih saat mengecek persyaratan dan disesuaikan dengan kewajiban kampus.
              </p>
            </details>
          </div>
        </section>

      </article>

      <!-- SIDEBAR (KANAN) -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-24 space-y-6">
          
          <!-- Box Fast Contact -->
          <div class="bg-tc-card p-6 rounded-3xl border border-tc-border space-y-4 shadow-xl">
            <h4 class="text-white font-bold text-base">Jalur Magang Informatika</h4>
            <p class="text-tc-muted text-xs leading-relaxed">
              Fokus Astro JS, Bootstrap 5, WordPress, Blogspot &amp; SEO dasar di Mojolangu, Kota Malang.
            </p>
            <a 
              href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20bertanya%20mengenai%20magang%20mahasiswa%20Informatika." 
              target="_blank" 
              rel="noopener noreferrer"
              class="block text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold py-2.5 rounded-xl text-xs transition-all"
