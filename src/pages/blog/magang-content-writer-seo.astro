---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  image="/assets/img/peserta-magang-content-writer-seo-struktur-heading.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta name="keywords" content="magang content writer seo, tugas magang content writer, skill content writer seo pemula, contoh artikel seo, alur menulis artikel seo, magang penulisan artikel seo malang, portofolio magang content writer, pkl content writer smk, magang mahasiswa content writer" />
