---
// src/pages/blog/cara-melamar-pkl-lewat-whatsapp.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Cara Melamar PKL Lewat WhatsApp, Contoh Pesannya";
const pageDesc = "Cara melamar PKL lewat WhatsApp dengan etika yang benar, plus contoh pesan untuk siswa, mahasiswa, dan orang tua.";
const publishDate = "2026-11-19";
const publishIsoDate = "2026-11-19T19:00:00+07:00";
const pageSlug = "/blog/cara-melamar-pkl-lewat-whatsapp";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/cara-melamar-pkl-lewat-whatsapp-1.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/cara-melamar-pkl-lewat-whatsapp-2.webp";
const authorName = "Tim Redaksi Gemilang Training";
const keywordsList = "cara melamar pkl lewat whatsapp, contoh pesan daftar pkl whatsapp, etika kirim lamaran whatsapp, cara daftar magang via wa, lampiran pdf lamaran pkl";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Organization",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        secondImageUrl
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Kapan waktu terbaik mengirim pesan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Senin sampai Jumat pukul 08.00-17.00 WIB, sesuai jam operasional admin. Hindari malam hari dan hari libur."
          }
        },
        {
          "@type": "Question",
          "name": "Perlu follow-up kalau belum dibalas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perlu, tetapi cukup satu kali setelah 3-5 hari kerja. Kirim pesan sopan tanpa mengirim pesan beruntun."
          }
        },
        {
          "@type": "Question",
          "name": "Format file apa yang sebaiknya dikirim?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PDF, dengan nama file rapi seperti CV_NamaLengkap_Jurusan.pdf atau SuratPengantar_NamaSekolah.pdf agar mudah dikenali admin."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/cara-melamar-pkl-lewat-whatsapp-1.webp"
  imageAlt="Siswa SMK mengetik pesan lamaran PKL lewat WhatsApp di ponsel"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Siswa SMK mengetik pesan lamaran PKL lewat WhatsApp di ponsel" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Panduan Pengiriman" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Panduan Pengiriman</span>
            <time datetime={publishIsoDate}>19 November 2026 • 19:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            Cara Melamar PKL atau Magang Lewat WhatsApp, Contoh Pesan yang Sopan dan Jelas
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/cara-melamar-pkl-lewat-whatsapp-1.webp" 
            alt="Siswa SMK mengetik pesan lamaran PKL lewat WhatsApp di ponsel" 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Siswa SMK mengetik pesan WhatsApp di ponsel sambil memegang map.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
            <span>Daftar Isi Panduan</span>
            <span id="toc-icon" class="text-xs font-bold" style="color: #eab308; font-variant-emoji: text;">▼</span>
          </button>
          <div id="toc-content" class="text-xs text-tc-muted space-y-2 pt-2 border-t border-tc-border/60">
            <ul class="space-y-1.5 list-disc list-inside">
              <li><a href="#boleh-wa" class="hover:text-tc-accent transition-colors">1. Apakah Boleh Melamar PKL Lewat WhatsApp?</a></li>
              <li><a href="#etika-wa" class="hover:text-tc-accent transition-colors">2. Bagaimana Etika Mengirim Pesannya?</a></li>
              <li><a href="#pesan-smk" class="hover:text-tc-accent transition-colors">3. Seperti Apa Contoh Pesan untuk Siswa SMK?</a></li>
              <li><a href="#pesan-mahasiswa" class="hover:text-tc-accent transition-colors">4. Seperti Apa Contoh Pesan untuk Mahasiswa?</a></li>
              <li><a href="#pesan-orang-tua" class="hover:text-tc-accent transition-colors">5. Seperti Apa Contoh Pesan untuk Orang Tua?</a></li>
              <li><a href="#lampiran-pesan" class="hover:text-tc-accent transition-colors">6. Apa yang Dilampirkan dalam Pesan?</a></li>
              <li><a href="#hindari-penipuan" class="hover:text-tc-accent transition-colors">7. Bagaimana Menghindari Penipuan Lowongan?</a></li>
              <li><a href="#kata-alumni" class="hover:text-tc-accent transition-colors">8. Apa Kata Alumni?</a></li>
              <li><a href="#faq-section" class="hover:text-tc-accent transition-colors">9. FAQ Melamar PKL / Magang via WhatsApp</a></li>
            </ul>
          </div>
        </div>

        <div class="space-y-8 text-tc-muted text-sm md:text-base leading-relaxed">
          <p>
            <strong>Cara melamar PKL lewat WhatsApp</strong> itu boleh, asal pesan singkat, formal, dan berisi berkas PDF yang rapi. Kirim di jam kerja agar cepat dibalas. Di bawah ini ada etika singkat, tiga contoh pesan untuk siswa, mahasiswa, dan orang tua, serta daftar lampiran.
          </p>
          <p>
            Pengajuan di Gemilang Training dipusatkan lewat WhatsApp resmi. Durasi PKL 3-6 bulan, dan untuk siswa SMK pengiriman surat disarankan 2-4 minggu sebelum penerjunan.
          </p>
          <p>
            Pesan yang baik hanya sebagian dari persiapan. Berkas lengkapnya ada di <a href="/blog/syarat-pendaftaran-magang-dan-pkl" class="text-tc-accent hover:underline">daftar berkas PKL yang perlu disiapkan</a> sebelum menekan tombol kirim.
          </p>

          <section id="boleh-wa" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apakah Boleh Melamar PKL Lewat WhatsApp?</h2>
            <p>
              Boleh, khususnya di Gemilang Training karena pendaftaran diterima lewat tombol WhatsApp di situs dan nomor admin resmi. Pastikan nomor yang kamu hubungi sama dengan yang tertera di <a href="/kontak" class="text-tc-accent hover:underline">halaman kontak</a>.
            </p>
            <p>
              Cara ini cocok untuk mengajukan berkas dan menanyakan kuota. Namun, WhatsApp bukan pengganti surat resmi sekolah atau kampus. Jadi surat permohonan atau surat pengantar tetap harus ada, lalu dikirim sebagai PDF.
            </p>
          </section>

          <!-- Gambar 2 -->
          <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
            <img 
              src="/assets/img/cara-melamar-pkl-lewat-whatsapp-2.webp" 
              alt="Mahasiswa memeriksa nama file PDF sebelum mengirim lamaran lewat WhatsApp" 
              class="w-full h-auto max-h-[380px] object-cover"
              loading="lazy"
            />
            <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
              Mahasiswa mengecek nama file PDF di laptop sebelum dikirim.
            </figcaption>
          </figure>

          <section id="etika-wa" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana Etika Mengirim Pesannya?</h2>
            <p>
              Etika melamar lewat WhatsApp berarti profil rapi, waktu kirim tepat, bahasa formal, file bernama jelas, dan sabar menunggu. Lima hal ini membuat pesan mudah ditindaklanjuti.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Pakai foto profil yang jelas dan nama asli, bukan nama gaul.</li>
              <li>Kirim pada jam kerja, Senin sampai Jumat pukul 08.00-17.00 WIB. Hindari malam hari dan hari libur.</li>
              <li>Pakai bahasa formal dan tanpa singkatan seperti "sy", "utk", atau "gk".</li>
              <li>Satukan berkas dalam PDF dengan nama seperti <code class="text-tc-accent">CV_NamaLengkap_Jurusan.pdf</code> atau <code class="text-tc-accent">SuratPengantar_NamaSekolah.pdf</code>.</li>
              <li>Kalau belum dibalas dalam 3-5 hari kerja, kirim satu pesan follow-up yang sopan.</li>
            </ul>
            <p>
              Hendik Darmawan dari Snap Careers menekankan agar identitas dan maksud dijelaskan ringkas di awal pesan, dengan nama file PDF yang profesional. Farijihan Putri dari Dibimbing menambahkan bahwa etika ditentukan oleh ketepatan waktu kirim dan kesabaran menunggu tanpa spam.
            </p>
          </section>

          <!-- BACA JUGA BOX SISIPAN -->
          <div class="my-6">
            <a 
              href="/blog/syarat-pendaftaran-magang-dan-pkl" 
              class="block bg-tc-bg hover:bg-tc-card border-l-4 border-tc-accent p-5 rounded-2xl border border-tc-border transition-all shadow-lg group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold text-tc-accent uppercase tracking-wider block mb-1">BACA JUGA ARTIKEL PILAR</span>
                  <h4 class="text-white font-bold text-sm md:text-base group-hover:text-tc-accent transition-colors">
                    Syarat dan Berkas PKL dan Magang, Checklist Lengkap &rarr;
                  </h4>
                </div>
              </div>
            </a>
          </div>

          <section id="pesan-smk" class="space-y-4">
            <h2 class="text-xl md:text-2xl font-bold text-white">Seperti Apa Contoh Pesan untuk Siswa SMK?</h2>
            <p>
              Pesan siswa SMK berisi salam, identitas, maksud pengajuan PKL, dan keterangan lampiran surat permohonan.
            </p>
            <pre class="bg-tc-bg p-5 rounded-2xl border border-tc-border text-xs md:text-sm text-tc-muted font-mono overflow-x-auto whitespace-pre-wrap leading-relaxed">
Selamat pagi, Bapak/Ibu Admin Gemilang Training.
Perkenalkan, nama saya [Nama Lengkap], siswa kelas [XI/XII]
jurusan [Jurusan] dari [Nama Sekolah].
Saya bermaksud mengajukan PKL di Gemilang Training Malang
selama [3 / 6] bulan, periode [Bulan]. Bersama pesan ini
saya lampirkan Surat Permohonan PKL dari sekolah (PDF)
untuk pengecekan kuota.
Terima kasih atas waktu dan perhatian Bapak/Ibu.
Hormat saya,
[Nama Lengkap] - [Nomor Kontak]
            </pre>
          </section>

          <section id="pesan-mahasiswa" class="space-y-4">
            <h2 class="text-xl md:text-2xl font-bold text-white">Seperti Apa Contoh Pesan untuk Mahasiswa?</h2>
            <p>
              Pesan mahasiswa berisi identitas, prodi, kampus, bidang yang diminati, serta lampiran CV dan surat pengantar kampus.
            </p>
            <pre class="bg-tc-bg p-5 rounded-2xl border border-tc-border text-xs md:text-sm text-tc-muted font-mono overflow-x-auto whitespace-pre-wrap leading-relaxed">
Selamat siang, Bapak/Ibu Admin Gemilang Training.
Perkenalkan, saya [Nama Lengkap], mahasiswa [Prodi] dari
[Nama Kampus]. Saya ingin mengajukan magang selama [3 / 6]
bulan pada bidang [Web Development / SEO dan Konten].
Saya lampirkan CV, tautan portofolio atau GitHub, dan Surat
Pengantar Kampus (PDF). Mohon informasi kuota dan jadwal
wawancara.
Terima kasih, Bapak/Ibu.
Hormat saya,
[Nama Lengkap] - [Nomor Kontak]
            </pre>
          </section>

          <section id="pesan-orang-tua" class="space-y-4">
            <h2 class="text-xl md:text-2xl font-bold text-white">Seperti Apa Contoh Pesan untuk Orang Tua?</h2>
            <p>
              Orang tua cukup menanyakan kuota dan prosedur, sedangkan surat resmi tetap berasal dari sekolah. Pesan sebaiknya jelas siapa yang bertanya dan atas nama siapa.
            </p>
            <pre class="bg-tc-bg p-5 rounded-2xl border border-tc-border text-xs md:text-sm text-tc-muted font-mono overflow-x-auto whitespace-pre-wrap leading-relaxed">
Selamat siang, Bapak/Ibu Admin Gemilang Training.
Saya [Nama Orang Tua], orang tua dari [Nama Anak], siswa
kelas [XI/XII] jurusan [Jurusan] di [Nama Sekolah].
Saya ingin menanyakan ketersediaan kuota dan prosedur
pendaftaran PKL. Surat permohonan resmi akan diajukan oleh
pihak sekolah.
Terima kasih atas informasinya.
[Nama Orang Tua] - [Nomor Kontak]
            </pre>
          </section>

          <section id="lampiran-pesan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa yang Dilampirkan dalam Pesan?</h2>
            <p>
              Lampirannya mengikuti kategori pelamar: surat permohonan sekolah untuk siswa, serta surat pengantar kampus dan CV untuk mahasiswa. Semua dalam bentuk PDF.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Siswa SMK: scan PDF surat permohonan PKL yang sudah ditandatangani dan distempel.</li>
              <li>Mahasiswa: surat pengantar kampus (dengan NIM, prodi, jumlah mahasiswa, tanggal mulai) dan CV, plus tautan GitHub jika ada.</li>
              <li>Orang tua: tidak wajib melampirkan apa pun saat bertanya, kecuali diminta admin.</li>
            </ul>
            <p>
              Soal isi surat, ada contohnya di <a href="/blog/contoh-surat-permohonan-pkl" class="text-tc-accent hover:underline">surat permohonan PKL SMK</a> dan <a href="/blog/contoh-surat-lamaran-magang-mahasiswa" class="text-tc-accent hover:underline">surat lamaran mahasiswa Informatika</a>.
            </p>
          </section>

          <section id="hindari-penipuan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana Menghindari Penipuan Lowongan?</h2>
            <p>
              Hubungi hanya nomor resmi yang tertera di situs, dan waspadai pihak yang meminta biaya administrasi. Gemilang Training tidak memungut biaya pendaftaran tersembunyi.
            </p>
            <p>
              Cek ulang nomor di <a href="/kontak" class="text-tc-accent hover:underline">halaman kontak</a> sebelum mengirim berkas. Kebiasaan kecil ini mencegah berkas pribadimu jatuh ke pihak yang salah.
            </p>
          </section>

          <section id="kata-alumni" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa Kata Alumni?</h2>
            <blockquote class="bg-tc-bg p-4 rounded-xl border-l-4 border-tc-accent space-y-1">
              <p class="text-white font-semibold text-sm">Siti Nurhaliza (Siswa PKL Bisnis Digital &amp; Pemasaran)</p>
              <p class="text-tc-muted text-xs italic">"Waktu PKL di sini, praktik Digital Marketing-nya langsung ke kasus nyata. Riset keyword SEO dan pembuatan artikel beneran kepakai dan bikin portofolio saya makin berbobot!"</p>
            </blockquote>
            <blockquote class="bg-tc-bg p-4 rounded-xl border-l-4 border-tc-accent space-y-1">
              <p class="text-white font-semibold text-sm">Dion Arisandi (Siswa PKL DKV &amp; Multimedia)</p>
              <p class="text-tc-muted text-xs italic">"Bimbingan PKL-nya intensif banget. Produksi video konten dan pengelolaan media web saya benar-benar di-review langsung oleh mentor praktisi."</p>
            </blockquote>
            <p>
              Melamar PKL lewat WhatsApp aman dilakukan selama pesan formal, dikirim di jam kerja, dan berkasnya PDF yang rapi. Satu pesan follow-up setelah 3-5 hari kerja sudah cukup.
            </p>
            <p>
              Gemilang Training melayani Malang untuk siswa SMK dan mahasiswa. Lihat pilihan di halaman <a href="/program" class="text-tc-accent hover:underline">program</a>, pahami tahapnya di <a href="/alur-pendaftaran" class="text-tc-accent hover:underline">alur pendaftaran</a>, lalu kirim pesanmu lewat <a href="/kontak" class="text-tc-accent hover:underline">halaman kontak</a> atau ke +62 819-4343-1484.
            </p>
          </section>
        </div>

        <!-- KOTAK AUTHOR (PENULIS) -->
        <div class="my-8 p-6 bg-tc-bg border border-tc-border rounded-2xl flex flex-col sm:flex-row items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold text-xl shrink-0">
            GT
          </div>
          <div class="space-y-1 text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start gap-2">
              <h4 class="text-white font-bold text-base">{authorName}</h4>
              <span class="bg-tc-accent/20 text-tc-accent text-[10px] font-semibold px-2 py-0.5 rounded-full border border-tc-accent/40">Verified Author</span>
            </div>
            <p class="text-tc-muted text-xs leading-relaxed">
              Tim redaksi Gemilang Training Malang untuk panduan etika pengiriman berkas via WhatsApp, contoh pesan lamaran, dan keamanan pendaftaran.
            </p>
          </div>
        </div>

        <!-- CTA PROMO WHATSAPP -->
        <div class="bg-gradient-to-r from-tc-bg to-tc-card border border-tc-accent/50 rounded-3xl p-6 md:p-8 text-center space-y-4 shadow-2xl">
          <h3 class="text-xl font-bold text-white">Kirim Pesan &amp; Berkas via WhatsApp Resmi</h3>
          <p class="text-tc-muted text-xs md:text-sm max-w-lg mx-auto">
            Hubungi admin resmi Gemilang Training di Malang (Senin–Jumat, 08.00–17.00 WIB) untuk pengecekan kuota dan pendaftaran.
          </p>
          <a 
            href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20mengajukan%20pendaftaran%20PKL%20atau%20magang." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-6 py-3 rounded-xl transition-all shadow-lg text-xs md:text-sm"
          >
            <span>Chat Admin Resmi via WA</span>
          </a>
        </div>

        <!-- FAQ ACCORDION SECTION -->
        <section id="faq-section" class="border-t border-tc-border pt-8 space-y-4">
          <h3 class="text-xl font-bold text-white">FAQ Melamar PKL / Magang via WhatsApp</h3>
          <div class="space-y-3">
            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Kapan waktu terbaik mengirim pesan?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Senin sampai Jumat pukul 08.00-17.00 WIB, sesuai jam operasional admin. Hindari malam hari dan hari libur.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Perlu follow-up kalau belum dibalas?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Perlu, tetapi cukup satu kali setelah 3-5 hari kerja. Kirim pesan sopan tanpa mengirim pesan beruntun.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Format file apa yang sebaiknya dikirim?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
