const schemaBlogIndex = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#collection`,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDesc,
      "inLanguage": "id-ID",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id"
      }
    },
    {
      "@type": "ItemList",
      "itemListElement": articles.map((article, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `${pageUrl}/${article.slug}`,
        "name": article.title
      }))
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  image="/assets/img/tempat-magang-malang-1.webp"
  type="website"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaBlogIndex)} />
  </head>

  <section class="py-12 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- SECTION HEADER -->
    <div class="text-center max-w-3xl mx-auto mb-8">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Edukasi & Insight Industri
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Blog & Warta Edukasi Magang
      </h1>
      <p class="text-tc-muted text-base md:text-lg">
        Artikel edukatif, panduan memilih tempat magang, tempat PKL SMK RPL, syarat berkas & contoh surat PKL/magang, magang mahasiswa Informatika Web Engineering, pelatihan kejuruan, dan kabar program terkini Gemilang Training Kota Malang.
      </p>
    </div>

    <!-- FITUR SEARCH BAR & FILTER KLASTER -->
    <div class="max-w-4xl mx-auto space-y-4">
      <div class="relative">
        <input 
          type="text" 
          id="blog-search-input" 
          placeholder="Cari judul artikel, topik, atau kata kunci..." 
          class="w-full bg-tc-card border border-tc-border rounded-2xl py-3.5 pl-12 pr-4 text-sm text-white placeholder-tc-muted focus:outline-none focus:border-tc-accent transition-colors shadow-lg"
        />
        <svg class="w-5 h-5 text-tc-muted absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2">
        <button type="button" data-cluster="all" class="cluster-btn bg-tc-accent text-slate-950 font-bold text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all">
          Semua Artikel
        </button>
        <button type="button" data-cluster="PKL SMK RPL" class="cluster-btn bg-tc-card hover:border-tc-accent text-tc-muted hover:text-white border border-tc-border text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all">
          PKL SMK RPL
        </button>
        <button type="button" data-cluster="Tempat Magang Malang" class="cluster-btn bg-tc-card hover:border-tc-accent text-tc-muted hover:text-white border border-tc-border text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all">
          Panduan Magang Malang
        </button>
        <button type="button" data-cluster="Magang Informatika" class="cluster-btn bg-tc-card hover:border-tc-accent text-tc-muted hover:text-white border border-tc-border text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all">
          Magang Informatika
        </button>
        <button type="button" data-cluster="Pariwisata & Konten" class="cluster-btn bg-tc-card hover:border-tc-accent text-tc-muted hover:text-white border border-tc-border text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all">
          Pariwisata & Konten
        </button>
        <button type="button" data-cluster="Berkas & Pendaftaran" class="cluster-btn bg-tc-card hover:border-tc-accent text-tc-muted hover:text-white border border-tc-border text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all">
          Berkas & Pendaftaran
        </button>
        <button type="button" data-cluster="Pelatihan & Skill" class="cluster-btn bg-tc-card hover:border-tc-accent text-tc-muted hover:text-white border border-tc-border text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all">
          Pelatihan, Portofolio & AI
        </button>
      </div>
    </div>

    <!-- PESAN TIDAK DITEMUKAN (HIDDEN BY DEFAULT) -->
    <div id="no-results-msg" class="hidden text-center py-12 bg-tc-card/40 rounded-2xl border border-tc-border/60">
      <p class="text-tc-muted text-sm">Tidak ada artikel yang cocok dengan kata kunci pencarianmu.</p>
    </div>

    <!-- GRID ARTIKEL TERHUBUNG -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="article-grid">
      {articles.map((article) => (
        <article 
          class="article-card bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between group shadow-xl"
          data-title={article.title.toLowerCase()}
          data-desc={article.desc.toLowerCase()}
          data-tag={article.tag.toLowerCase()}
          data-cluster={article.cluster}
        >
          <div>
            <!-- 1. Gambar Thumbnail Foto di Atas -->
            <div class="h-52 overflow-hidden relative border-b border-tc-border/60">
              <img 
                src={article.img} 
                alt={article.alt} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                {article.category}
              </span>
            </div>

            <!-- 2. Isi Konten Artikel -->
            <div class="p-6 space-y-3">
              <!-- Tag & Cluster Badge -->
              <div class="flex flex-wrap items-center gap-2">
                <span class="bg-tc-bg border border-tc-border text-tc-accent text-xs font-semibold px-3 py-1 rounded-full inline-block">
                  {article.tag}
                </span>
                <span class="text-[11px] font-mono text-tc-muted">
                  {article.cluster}
                </span>
              </div>

              <!-- Judul Artikel -->
              <h2 class="text-lg md:text-xl font-bold text-white group-hover:text-tc-accent transition-colors leading-snug pt-1">
                <a href={`/blog/${article.slug}`}>
                  {article.title}
                </a>
              </h2>

              <!-- Deskripsi Ringkas -->
              <p class="text-tc-muted text-xs md:text-sm leading-relaxed line-clamp-3">
                {article.desc}
              </p>
            </div>
          </div>

          <!-- 3. Footer Kartu (Tanggal di Kiri + Tombol Baca di Kanan) -->
          <div class="px-6 pb-6 pt-3 border-t border-tc-border/60 flex items-center justify-between">
            <span class="text-xs font-mono text-tc-muted">{article.date}</span>
            <a 
              href={`/blog/${article.slug}`} 
              class="text-xs font-bold text-tc-accent hover:text-white inline-flex items-center gap-1 transition-colors"
            >
              Baca Selengkapnya &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupBlogFilterAndSearch() {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
    const clusterButtons = document.querySelectorAll('.cluster-btn');
    const articleCards = document.querySelectorAll('.article-card');
    const noResultsMsg = document.getElementById('no-results-msg');

    let activeCluster = 'all';

    function applyFilters() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      articleCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const tag = card.getAttribute('data-tag') || '';
        const cluster = card.getAttribute('data-cluster') || '';

        const matchesCluster = activeCluster === 'all' || cluster === activeCluster;
        const matchesQuery = title.includes(query) || desc.includes(query) || tag.includes(query) || cluster.toLowerCase().includes(query);

        if (matchesCluster && matchesQuery) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters);
    }

    clusterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activeCluster = btn.getAttribute('data-cluster') || 'all';

        clusterButtons.forEach(b => {
          b.className = 'cluster-btn bg-tc-card hover:border-tc-accent text-tc-muted hover:text-white border border-tc-border text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all';
        });

        btn.className = 'cluster-btn bg-tc-accent text-slate-950 font-bold text-xs px-4 py-1.5 rounded-full cursor-pointer transition-all';
        applyFilters();
      });
    });
  }

  setupBlogFilterAndSearch();
  document.addEventListener('astro:page-load', setupBlogFilterAndSearch);
</script>
