---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// Database Artikel Blog Terstruktur (Pembaruan 3 November 2026)
const articles = [
  {
    slug: "pelatihan-kejuruan-terpadu-sinkronisasi-industri-skariga",
    category: "Panduan Utama",
    tag: "Pillar Page",
    title: "Pelatihan Kejuruan Terpadu & Sinkronisasi Industri SKARIGA: Menyelaraskan Keterampilan dengan Kebutuhan Dunia Kerja",
    desc: "Panduan pelatihan kejuruan terpadu dan sinkronisasi industri SKARIGA di Malang: dua jalur pelatihan, alur belajar, dan cara memilih program yang tepat.",
    date: "03 Nov 2026",
    img: "/assets/img/artikel2b.webp"
  },
  {
    slug: "pelatihan-portofolio-materi-dan-praktik-siap-kerja",
    category: "Portofolio",
    tag: "Karir & Vokasi",
    title: "Pelatihan Portofolio: Materi dan Praktik Menyusun Karya agar Siap Kerja",
    desc: "Panduan pelatihan pembuatan portofolio untuk siswa SMK dan mahasiswa: materi, isi portofolio tiap jurusan, langkah menyusun, dan kesalahan umum yang perlu dihindari.",
    date: "03 Nov 2026",
    img: "/assets/img/artikel2c.webp"
  },
  {
    slug: "pelatihan-ai-dan-prompt-untuk-bisnis-marketing-pemasaran",
    category: "AI & Prompt",
    tag: "Tech & Growth",
    title: "Pelatihan AI dan Prompt untuk Bisnis, Marketing, dan Pemasaran: Bekerja Lebih Cepat dan Terarah",
    desc: "Panduan pelatihan AI dan prompt untuk bisnis, marketing, dan pemasaran: struktur prompt yang baik, contoh penggunaan, etika, dan alur latihan praktis.",
    date: "03 Nov 2026",
    img: "/assets/img/artikel3a.webp"
  }
];
---

<BaseLayout title="Blog & Edukasi Karier Digital - Gemilang Training" isHome={false}>
  <Navbar slot="header" />

  <section class="py-12 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    <!-- SECTION HEADER -->
    <div class="text-center max-w-3xl mx-auto mb-8">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Edukasi & Insight Industri
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Blog & Warta Edukasi Magang
      </h1>
      <p class="text-tc-muted text-base md:text-lg">
        Artikel edukatif, panduan berkas PKL, tips seleksi industri, dan kabar program terkini Gemilang Training Kota Malang.
      </p>
    </div>

    <!-- FITUR SEARCH BAR INTERAKTIF -->
    <div class="max-w-2xl mx-auto">
      <div class="relative">
        <input 
          type="text" 
          id="blog-search-input" 
          placeholder="Cari judul artikel, topik, atau kata kunci..." 
          class="w-full bg-tc-card border border-tc-border rounded-2xl py-3.5 pl-12 pr-4 text-sm text-white placeholder-tc-muted focus:outline-none focus:border-tc-accent transition-colors shadow-lg"
        />
        <svg class="w-5 h-5 text-tc-muted absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <!-- PESAN TIDAK DITEMUKAN (HIDDEN BY DEFAULT) -->
    <div id="no-results-msg" class="hidden text-center py-12 bg-tc-card/40 rounded-2xl border border-tc-border/60">
      <p class="text-tc-muted text-sm">Tidak ada artikel yang cocok dengan kata kunci pencarianmu.</p>
    </div>

    <!-- GRID ARTIKEL (3 KARTU BARU BERBAHAN CLEAN URL) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="article-grid">
      {articles.map((article) => (
        <article 
          class="article-card bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between group shadow-xl"
          data-title={article.title.toLowerCase()}
          data-desc={article.desc.toLowerCase()}
          data-tag={article.tag.toLowerCase()}
        >
          <div>
            <!-- 1. Gambar Thumbnail Foto di Atas -->
            <div class="h-52 overflow-hidden relative border-b border-tc-border/60">
              <img 
                src={article.img} 
                alt={article.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                {article.category}
              </span>
            </div>

            <!-- 2. Isi Konten Artikel -->
            <div class="p-6 space-y-3">
              <!-- Category Badge -->
              <div>
                <span class="bg-tc-bg border border-tc-border text-tc-accent text-xs font-semibold px-3 py-1 rounded-full inline-block">
                  {article.tag}
                </span>
              </div>

              <!-- Judul Artikel -->
              <h2 class="text-lg md:text-xl font-bold text-white group-hover:text-tc-accent transition-colors leading-snug pt-1">
                <a href={`/blog/${article.slug}`}>
                  {article.title}
                </a>
              </h2>

              <!-- Deskripsi Ringkas -->
              <p class="text-tc-muted text-xs md:text-sm leading-relaxed line-clamp-3">
                {article.desc}
              </p>
            </div>
          </div>

          <!-- 3. Footer Kartu (Tanggal di Kiri + Tombol Baca di Kanan) -->
          <div class="px-6 pb-6 pt-3 border-t border-tc-border/60 flex items-center justify-between">
            <span class="text-xs font-mono text-tc-muted">{article.date}</span>
            <a 
              href={`/blog/${article.slug}`} 
              class="text-xs font-bold text-tc-accent hover:text-white inline-flex items-center gap-1 transition-colors"
            >
              Baca Selengkapnya &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Logika Pencarian Artikel Real-Time
  function setupBlogSearch() {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
    const articleCards = document.querySelectorAll('.article-card');
    const noResultsMsg = document.getElementById('no-results-msg');

    if (!searchInput || !articleCards.length) return;

    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      articleCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const tag = card.getAttribute('data-tag') || '';

        if (title.includes(query) || desc.includes(query) || tag.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Tampilkan/Sembunyikan pesan hasil pencarian kosong
      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }
    });
  }

  // Jalankan saat halaman dimuat & saat navigasi Astro
  setupBlogSearch();
  document.addEventListener('astro:page-load', setupBlogSearch);
</script>