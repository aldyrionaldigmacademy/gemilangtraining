---
// src/pages/blog/magang-berbasis-proyek-nyata.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Magang Berbasis Proyek Nyata vs Magang Administratif";
const pageDesc = "Apa itu magang berbasis proyek nyata dan apa bedanya dengan magang administratif? Pahami ciri, hasil portofolio, dan cara memilih program magang yang tepat.";
const publishDate = "2026-11-20";
const publishIsoDate = "2026-11-20T19:00:00+07:00";
const pageSlug = "/blog/magang-berbasis-proyek-nyata";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/magang-berbasis-proyek-nyata-1.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/magang-berbasis-proyek-nyata-2.webp";
const authorName = "Tim Redaksi Gemilang Training";
const keywordsList = "magang berbasis proyek nyata, magang berbasis proyek, project-based learning magang, magang vs magang administratif, tempat magang dengan proyek, portofolio dari magang, magang mentor praktisi";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Organization",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        secondImageUrl
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah magang berbasis proyek hanya cocok untuk mahasiswa informatika?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak. Pendekatannya bisa diterapkan di berbagai bidang digital, seperti pemasaran, desain, dan multimedia. Untuk jalur mahasiswa di Gemilang Training, program yang tersedia ditujukan bagi mahasiswa Informatika, sedangkan jalur PKL untuk siswa SMK mencakup jurusan bisnis dan kreatif lainnya."
          }
        },
        {
          "@type": "Question",
          "name": "Bisakah hasil proyek magang dicantumkan di CV?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bisa, dan sebaiknya begitu. Cantumkan nama proyek, peran Anda, teknologi yang dipakai, dan tautan hasilnya bila sudah tayang. Detail ini membantu perekrut menilai kemampuan nyata. Pastikan Anda hanya mencantumkan bagian yang memang Anda kerjakan."
          }
        },
        {
          "@type": "Question",
          "name": "Siapa yang menentukan proyek yang dikerjakan peserta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Penentuannya biasanya melibatkan peserta dan mentor. Di Gemilang Training, sesi wawancara dan pemetaan kemampuan membantu mentor mengetahui minat peserta, misalnya pembuatan website atau optimasi SEO dan konten, sebelum proyek dibagikan. Dengan begitu tugas lebih sesuai dengan kemampuan awal."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah magang berbasis proyek lebih berat dibanding magang administratif?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tuntutannya berbeda. Magang berbasis proyek menuntut hasil yang berfungsi dan siap dievaluasi, sehingga peserta perlu aktif belajar dan menerima masukan. Namun dengan bimbingan bertahap, bebannya bisa diatur. Tantangan tersebut biasanya sepadan dengan keterampilan dan karya yang diperoleh."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/magang-berbasis-proyek-nyata-1.webp"
  imageAlt="Mahasiswa mengerjakan proyek digital menggunakan laptop sebagai bagian dari magang berbasis proyek nyata"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Mahasiswa mengerjakan proyek digital menggunakan laptop sebagai bagian dari magang berbasis proyek nyata" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Project-Based Learning" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Project-Based Learning</span>
            <time datetime={publishIsoDate}>20 November 2026 • 19:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            {pageTitle}
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/magang-berbasis-proyek-nyata-1.webp" 
            alt="Mahasiswa mengerjakan proyek digital menggunakan laptop sebagai bagian dari magang berbasis proyek nyata" 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Mahasiswa mengerjakan proyek digital menggunakan laptop sebagai bagian dari magang berbasis proyek nyata.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
            <span>Daftar Isi Panduan</span>
            <span id="toc-icon" class="text-xs font-bold" style="color: #eab308; font-variant-emoji: text;">▼</span>
          </button>
          <div id="toc-content" class="text-xs text-tc-muted space-y-2 pt-2 border-t border-tc-border/60">
            <ul class="space-y-1.5 list-disc list-inside">
              <li><a href="#pengertian-proyek-nyata" class="hover:text-tc-accent transition-colors">1. Pengertian Magang Berbasis Proyek Nyata</a></li>
              <li><a href="#perbedaan-proyek-administratif" class="hover:text-tc-accent transition-colors">2. Perbedaan Magang Berbasis Proyek dan Magang Administratif</a></li>
              <li><a href="#karakteristik-pbl" class="hover:text-tc-accent transition-colors">3. Karakteristik Kegiatan Pembelajaran Berbasis Proyek</a></li>
              <li><a href="#keterlibatan-peserta" class="hover:text-tc-accent transition-colors">4. Keterlibatan Peserta dalam Proses Pengerjaan Proyek</a></li>
              <li><a href="#contoh-hasil" class="hover:text-tc-accent transition-colors">5. Contoh Hasil Pekerjaan yang Relevan dengan Bidang Digital</a></li>
              <li><a href="#hubungan-portofolio" class="hover:text-tc-accent transition-colors">6. Hubungan Proyek dengan Pengembangan Keterampilan dan Portofolio</a></li>
              <li><a href="#hal-diperhatikan" class="hover:text-tc-accent transition-colors">7. Hal yang Perlu Diperhatikan sebelum Memilih Program Magang</a></li>
              <li><a href="#gambaran-pbl-gemilang" class="hover:text-tc-accent transition-colors">8. Gambaran Pendekatan Project-Based Learning di Gemilang Training</a></li>
              <li><a href="#faq-section" class="hover:text-tc-accent transition-colors">9. FAQ Magang Berbasis Proyek Nyata</a></li>
              <li><a href="#kesimpulan" class="hover:text-tc-accent transition-colors">10. Kesimpulan</a></li>
            </ul>
          </div>
        </div>

        <div class="space-y-8 text-tc-muted text-sm md:text-base leading-relaxed">
          <p>
            <strong>Magang berbasis proyek nyata</strong> melibatkan peserta langsung dalam pengerjaan produk yang benar-benar dipakai, dengan hasil terukur, sedangkan magang administratif berfokus pada tugas pendukung kantor.
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>Magang berbasis proyek menjadikan pekerjaan sungguhan, seperti website atau konten yang tayang, sebagai sarana belajar utama.</li>
            <li>Perbedaan utamanya ada pada jenis tugas, bentuk hasil, dan pola bimbingan.</li>
            <li>Magang administratif tetap bermanfaat untuk budaya kerja, tetapi hasilnya lebih sulit ditunjukkan sebagai karya.</li>
            <li>Hasil magang berbasis proyek dapat dikembangkan menjadi portofolio untuk melamar kerja.</li>
            <li>Sebelum memilih program, periksa jenis proyek, pembimbing, bentuk evaluasi, dan hasil yang dibawa pulang.</li>
          </ul>
          <p>
            Saat membandingkan tempat magang, mahasiswa sering hanya melihat nama perusahaan dan lokasi. Padahal hal yang paling menentukan manfaat magang adalah apa yang sebenarnya dikerjakan setiap hari. Dua orang yang magang selama jumlah bulan yang sama bisa pulang dengan bekal yang jauh berbeda: satu membawa karya yang bisa ditunjukkan, satu lagi membawa pengalaman administrasi umum.
          </p>

          <section id="pengertian-proyek-nyata" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Pengertian Magang Berbasis Proyek Nyata</h2>
            <p>
              Magang berbasis proyek nyata adalah magang yang menjadikan pekerjaan sungguhan, seperti website atau konten yang dipublikasikan, sebagai sarana belajar utama peserta.
            </p>
            <p>
              Pada model ini, peserta tidak sekadar mengamati atau membantu pekerjaan orang lain. Mereka memegang bagian dari proyek yang punya tujuan, tenggat, dan hasil akhir yang digunakan pihak lain—misalnya membangun website yang dibuka publik atau menulis artikel yang diterbitkan.
            </p>
          </section>

          <!-- Gambar 2 -->
          <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
            <img 
              src="/assets/img/magang-berbasis-proyek-nyata-2.webp" 
              alt="Mahasiswa melakukan riset digital dan analisis informasi menggunakan laptop untuk mendukung pengerjaan proyek magang" 
              class="w-full h-auto max-h-[380px] object-cover"
              loading="lazy"
            />
            <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
              Mahasiswa melakukan riset digital dan analisis informasi menggunakan laptop untuk mendukung pengerjaan proyek magang.
            </figcaption>
          </figure>

          <section id="perbedaan-proyek-administratif" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Perbedaan Magang Berbasis Proyek dan Magang Administratif</h2>
            <p>
              Perbedaan utamanya ada pada jenis tugas, bentuk hasil, dan pola bimbingan: proyek menghasilkan karya terukur, sedangkan tugas administratif menghasilkan dukungan operasional.
            </p>
            <div class="overflow-x-auto rounded-2xl border border-tc-border">
              <table class="w-full text-left border-collapse text-xs md:text-sm">
                <thead class="bg-tc-bg text-white">
                  <tr>
                    <th class="p-3.5 border-b border-tc-border font-bold">Aspek</th>
                    <th class="p-3.5 border-b border-tc-border font-bold">Magang berbasis proyek</th>
                    <th class="p-3.5 border-b border-tc-border font-bold">Magang administratif</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-tc-border/60">
                  <tr>
                    <td class="p-3.5 font-semibold text-white">Jenis tugas</td>
                    <td class="p-3.5">Mengerjakan bagian proyek, misalnya halaman web, artikel, atau desain</td>
                    <td class="p-3.5">Mengarsipkan dokumen, input data, menyiapkan surat, membantu kebutuhan kantor</td>
                  </tr>
                  <tr>
                    <td class="p-3.5 font-semibold text-white">Hasil akhir</td>
                    <td class="p-3.5">Karya yang dapat ditunjukkan, seperti website tayang atau artikel terbit</td>
                    <td class="p-3.5">Dukungan operasional yang sulit dijadikan karya</td>
                  </tr>
                  <tr>
                    <td class="p-3.5 font-semibold text-white">Bimbingan</td>
                    <td class="p-3.5">Mentor praktisi mengevaluasi hasil secara berkala</td>
                    <td class="p-3.5">Arahan umum dari staf atau atasan</td>
                  </tr>
                  <tr>
                    <td class="p-3.5 font-semibold text-white">Keterampilan yang berkembang</td>
                    <td class="p-3.5">Keterampilan teknis spesifik di bidang digital</td>
                    <td class="p-3.5">Ketelitian, kedisiplinan, dan budaya kerja kantor</td>
                  </tr>
                  <tr>
                    <td class="p-3.5 font-semibold text-white">Nilai untuk portofolio</td>
                    <td class="p-3.5">Tinggi, karena ada bukti kerja</td>
                    <td class="p-3.5">Lebih terbatas, umumnya lewat surat keterangan</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p>
              Perlu dicatat, magang administratif bukan pengalaman yang sia-sia. Peserta tetap belajar disiplin kerja, komunikasi, dan alur birokrasi organisasi. Namun bagi mahasiswa informatika atau bidang digital yang ingin membangun keterampilan teknis, model berbasis proyek biasanya lebih selaras dengan tujuan.
            </p>
          </section>

          <section id="karakteristik-pbl" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Karakteristik Kegiatan Pembelajaran Berbasis Proyek</h2>
            <p>
              Ciri khasnya meliputi tujuan proyek yang jelas, bimbingan praktisi, tenggat bertahap, evaluasi berkala, dan hasil akhir yang dapat ditunjukkan kepada pihak lain.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Tujuan jelas:</strong> Peserta tahu apa yang dibuat dan untuk siapa.</li>
              <li><strong>Bimbingan praktisi:</strong> Pembimbing berasal dari dunia kerja yang paham standar industri.</li>
              <li><strong>Tahapan bertahap:</strong> Pekerjaan dipecah menjadi target yang bisa dicapai.</li>
              <li><strong>Evaluasi berkala:</strong> Hasil diperiksa secara rutin dan diperbaiki.</li>
              <li><strong>Output yang dapat ditunjukkan:</strong> Ada tautan, berkas, atau karya yang bisa dilihat orang lain.</li>
            </ul>
          </section>

          <section id="keterlibatan-peserta" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Keterlibatan Peserta dalam Proses Pengerjaan Proyek</h2>
            <p>
              Peserta terlibat dari memahami kebutuhan proyek, mengerjakan bagian tugasnya, menerima review, merevisi, hingga mempublikasikan hasil, bukan hanya membantu pekerjaan di sekitar proyek.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Memahami kebutuhan:</strong> Peserta mengetahui tujuan, target pengguna, dan batasan proyek.</li>
              <li><strong>Mengerjakan bagian tertentu:</strong> Misalnya satu halaman, satu rangkaian artikel, atau satu komponen.</li>
              <li><strong>Menerima review:</strong> Mentor memberi masukan terhadap kode, tampilan, atau tulisan.</li>
              <li><strong>Merevisi:</strong> Peserta memperbaiki hasil berdasarkan masukan.</li>
              <li><strong>Mempublikasikan:</strong> Hasil akhir ditayangkan dan dapat diakses.</li>
            </ul>
          </section>

          <!-- BACA JUGA BOX SISIPAN -->
          <div class="my-6">
            <a 
              href="/blog/magang-mahasiswa-informatika-malang" 
              class="block bg-tc-bg hover:bg-tc-card border-l-4 border-tc-accent p-5 rounded-2xl border border-tc-border transition-all shadow-lg group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold text-tc-accent uppercase tracking-wider block mb-1">BACA JUGA ARTIKEL PILAR</span>
                  <h4 class="text-white font-bold text-sm md:text-base group-hover:text-tc-accent transition-colors">
                    Magang Mahasiswa Informatika Malang Posisi Web Engineering &rarr;
                  </h4>
                </div>
              </div>
            </a>
          </div>

          <section id="contoh-hasil" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Contoh Hasil Pekerjaan yang Relevan dengan Bidang Digital</h2>
            <p>
              Contoh hasilnya adalah website responsif, artikel SEO yang terbit, landing page, laporan performa halaman, dan konten visual yang dapat dilampirkan ke portofolio.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Pengembangan web:</strong> Website multi-halaman, tampilan responsif, atau portal informasi.</li>
              <li><strong>SEO dan konten:</strong> Artikel yang dioptimalkan untuk mesin pencari dan sudah tayang.</li>
              <li><strong>Landing page:</strong> Halaman promosi dengan struktur yang jelas.</li>
              <li><strong>Laporan performa:</strong> Catatan kecepatan halaman dan perbaikan yang dilakukan.</li>
              <li><strong>Konten visual:</strong> Aset grafis atau video untuk kebutuhan promosi atau edukasi.</li>
            </ul>
          </section>

          <section id="hubungan-portofolio" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Hubungan Proyek dengan Pengembangan Keterampilan dan Portofolio</h2>
            <p>
              Setiap proyek melatih keterampilan spesifik sekaligus meninggalkan bukti kerja, sehingga portofolio dan CV mahasiswa terisi karya, bukan sekadar daftar kegiatan.
            </p>
            <p>
              Membangun website melatih HTML, CSS, dan struktur halaman, sedangkan hasil tayangnya menjadi bukti. Menulis artikel SEO melatih riset kata kunci dan struktur konten, sedangkan artikel yang terbit menjadi bukti. Portofolio yang disusun dari proyek magang memudahkan Anda menjelaskan peran, teknologi yang dipakai, dan masalah yang diselesaikan.
            </p>
          </section>

          <section id="hal-diperhatikan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Hal yang Perlu Diperhatikan sebelum Memilih Program Magang</h2>
            <p>
              Periksa jenis proyek, siapa pembimbingnya, bentuk evaluasi, hasil yang dapat dibawa pulang, dan kesesuaiannya dengan ketentuan kampus sebelum memutuskan tempat magang.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Proyek apa yang akan saya kerjakan, dan apakah hasilnya tayang atau dipakai?</li>
              <li>Siapa pembimbing saya, dan seberapa sering hasil saya dievaluasi?</li>
              <li>Teknologi atau keterampilan apa yang akan saya praktikkan?</li>
              <li>Apa yang bisa saya bawa pulang: karya, sertifikat, atau penilaian kampus?</li>
              <li>Apakah penyelenggara membantu logbook dan penilaian dari kampus?</li>
              <li>Apakah jadwal dan durasinya sesuai ketentuan program studi saya?</li>
            </ul>
          </section>

          <section id="gambaran-pbl-gemilang" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Gambaran Pendekatan Project-Based Learning di Gemilang Training</h2>
            <p>
              Gemilang Training menerapkan Project-Based Learning: peserta mengerjakan proyek website dan konten bersama mentor praktisi, lalu membawa portofolio dan sertifikat resmi sesuai ketentuan program.
            </p>
            <p>
              Mahasiswa Informatika dibimbing membangun website dengan Astro, Bootstrap 5, WordPress, dan Blogspot, menerapkan SEO dasar, serta menulis artikel yang terbit secara online. Mentor praktisi mengevaluasi hasil secara rutin, termasuk struktur kode, kecepatan halaman, dan kualitas tulisan. Di akhir periode, peserta merekap karya yang sudah online sebagai portofolio, mengisi penilaian kampus, dan menerima sertifikat resmi kelulusan magang. Contoh proyek dapat dilihat di halaman <a href="/portofolio" class="text-tc-accent hover:underline">portofolio</a>, dan profil lembaga ada di halaman <a href="/tentang-kami" class="text-tc-accent hover:underline">tentang kami</a>.
            </p>
          </section>

          <section id="kesimpulan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Kesimpulan</h2>
            <p>
              Magang berbasis proyek nyata memberi peserta tanggung jawab atas karya yang benar-benar dipakai, sehingga keterampilan teknis berkembang dan bukti kerja terkumpul. Magang administratif tetap punya manfaat untuk budaya kerja, tetapi hasilnya sulit dijadikan portofolio.
            </p>
            <p>
              Jika Anda ingin magang yang menghasilkan karya nyata dan portofolio, daftarkan diri ke Gemilang Training. Pelajari rincian program di halaman <a href="/program/magang-mahasiswa" class="text-tc-accent hover:underline">program magang mahasiswa</a>, lalu ajukan pendaftaran lewat admin.
            </p>
          </section>
        </div>

        <!-- KOTAK AUTHOR (PENULIS) -->
        <div class="my-8 p-6 bg-tc-bg border border-tc-border rounded-2xl flex flex-col sm:flex-row items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold text-xl shrink-0">
            GT
          </div>
