---
// src/pages/blog/tempat-magang-malang.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Tempat Magang di Malang 2027 dan Cara Memilihnya";
const pageDesc = "Temukan jenis tempat magang di Malang, cara memilih yang sesuai jurusan, dan checklist verifikasi sebelum mendaftar. Baca panduan lengkapnya dan mulai melamar.";
const publishDate = "2026-11-22";
const publishIsoDate = "2026-11-22T11:00:00+07:00";
const pageSlug = "/tempat-magang-malang";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/tempat-magang-malang-1.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/tempat-magang-malang-2.webp";
const authorName = "Tim Redaksi & Pembimbing Gemilang Training";
const keywordsList = "tempat magang di Malang 2027, tempat magang Malang, cara memilih tempat magang, checklist verifikasi magang, Gemilang Training Malang";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Organization",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        secondImageUrl
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Di mana saja tempat magang di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tempat magang di Malang tersedia di instansi pemerintah, BUMN dan BUMD, perusahaan swasta, startup, UMKM, hotel, wisata, rumah sakit, dan lembaga pendidikan di Kota Malang, Kota Batu, dan Kabupaten Malang."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah wajib ada perjanjian tertulis untuk magang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perjanjian tertulis sangat disarankan, dan dalam skema pemagangan resmi perjanjian wajib memuat hak dan kewajiban, program, jangka waktu, serta besaran uang saku sesuai Peraturan Menteri Ketenagakerjaan Nomor 6 Tahun 2020."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah magang di Malang pasti dibayar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak selalu. Uang saku tergantung jenis program dan kesepakatan, sehingga pelamar perlu menanyakannya sebelum menerima tawaran dan meminta jawaban tertulis."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah boleh magang di luar jurusan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Boleh jika kampus atau sekolah menyetujui dan tugasnya tetap relevan dengan kompetensi yang ingin dikembangkan, tetapi kecocokan dengan jurusan lebih mudah dinilai dan dikonversi."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana jika tempat magang meminta biaya pendaftaran?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Permintaan biaya pendaftaran adalah tanda bahaya. Hentikan komunikasi, jangan transfer uang, dan konfirmasi ke kampus atau sekolah serta kanal resmi penyelenggara."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/tempat-magang-malang-1.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Daftar periksa sebelum mendaftar magang di Malang" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Artikel Pilar" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Artikel Pilar</span>
            <time datetime={publishIsoDate}>22 November 2026 • 11:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            {pageTitle}
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/tempat-magang-malang-1.webp" 
            alt="Daftar periksa sebelum mendaftar magang di Malang" 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Daftar periksa sebelum mendaftar magang di Malang.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
            <span>Daftar Isi Panduan</span>
            <span id="toc-icon" class="text-xs">▼</span>
          </button>
          <div id="toc-content" class="text-xs text-tc-muted space-y-2 pt-2 border-t border-tc-border/60">
            <ul class="space-y-1.5 list-disc list-inside">
              <li><a href="#jenis-tempat" class="hover:text-tc-accent transition-colors">1. Apa saja jenis tempat magang di Malang?</a></li>
              <li><a href="#cocok-jurusan" class="hover:text-tc-accent transition-colors">2. Jenis tempat magang apa yang cocok untuk jurusan saya?</a></li>
              <li><a href="#cara-memilih" class="hover:text-tc-accent transition-colors">3. Bagaimana cara memilih tempat magang di Malang?</a></li>
              <li><a href="#hal-dicek" class="hover:text-tc-accent transition-colors">4. Apa yang harus dicek sebelum mendaftar magang?</a></li>
              <li><a href="#tawaran-layak" class="hover:text-tc-accent transition-colors">5. Bagaimana tahu tawaran magang itu layak?</a></li>
              <li><a href="#uang-saku" class="hover:text-tc-accent transition-colors">6. Apakah magang dibayar dan berapa uang sakunya?</a></li>
              <li><a href="#model-kerja" class="hover:text-tc-accent transition-colors">7. Magang WFH, hybrid, atau onsite, mana yang cocok?</a></li>
              <li><a href="#kesalahan-umum" class="hover:text-tc-accent transition-colors">8. Apa kesalahan umum saat mencari tempat magang?</a></li>
              <li><a href="#waktu-mencari" class="hover:text-tc-accent transition-colors">9. Kapan sebaiknya mulai mencari tempat magang?</a></li>
              <li><a href="#faq-section" class="hover:text-tc-accent transition-colors">10. FAQ tentang Tempat Magang di Malang</a></li>
              <li><a href="#kesimpulan" class="hover:text-tc-accent transition-colors">11. Kesimpulan</a></li>
            </ul>
          </div>
        </div>

        <div class="space-y-8 text-tc-muted text-sm md:text-base leading-relaxed">
          <p>
            <strong>Tempat magang di Malang</strong> mencakup kantor pemerintah, perusahaan swasta, startup, UMKM, hotel, dan lembaga pendidikan; pilih yang sesuai jurusan, jelas perjanjiannya, dan terverifikasi.
          </p>
          <p>
            Tempat magang di Malang terbagi menjadi instansi pemerintah, BUMN dan BUMD, perusahaan swasta, startup dan agensi digital, UMKM, serta sektor jasa seperti hotel dan rumah sakit.
          </p>
          <p>
            Pilihan terbaik bergantung pada kecocokan tugas dengan jurusan, kejelasan pembimbing, jadwal, dan keterjangkauan lokasi dari kos atau rumah.
          </p>

          <section id="jenis-tempat" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa saja jenis tempat magang di Malang?</h2>
            <p>
              Jenis tempat magang di Malang meliputi instansi pemerintah, BUMN dan BUMD, perusahaan swasta, startup, UMKM, serta sektor jasa seperti hotel, wisata, dan layanan kesehatan.
            </p>
            <p>
              Malang Raya terdiri dari Kota Malang, Kota Batu, dan Kabupaten Malang. Ketiga wilayah ini memiliki karakter ekonomi yang berbeda, sehingga peluang magangnya juga berbeda.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Instansi pemerintah dan lembaga publik.</strong> Dinas, kecamatan, kelurahan, dan lembaga daerah umumnya membuka magang untuk administrasi, hukum, pemerintahan, statistik, dan komunikasi publik. Prosesnya formal dan biasanya membutuhkan surat pengantar dari kampus atau sekolah.</li>
              <li><strong>BUMN dan BUMD.</strong> Seleksinya cenderung ketat dengan dokumen lengkap, tetapi pembimbing dan alur kerjanya biasanya jelas.</li>
              <li><strong>Perusahaan swasta dan industri.</strong> Manufaktur, distribusi, ritel, dan logistik di sekitar Malang Raya membuka magang untuk teknik, akuntansi, manajemen, dan sumber daya manusia.</li>
              <li><strong>Startup, agensi digital, dan software house.</strong> Bidang ini membuka posisi desain, pemrograman, konten, dan pemasaran digital. Model kerjanya sering fleksibel, termasuk jarak jauh.</li>
              <li><strong>UMKM dan usaha lokal.</strong> Usaha kuliner, kerajinan, dan perdagangan memberi tanggung jawab yang luas, tetapi struktur bimbingan dan uang saku perlu dipastikan sejak awal.</li>
              <li><strong>Sektor jasa.</strong> Hotel, restoran, destinasi wisata di Kota Batu, bank, klinik, rumah sakit, dan lembaga pendidikan membuka magang untuk jurusan pariwisata, kesehatan, keuangan, dan pendidikan.</li>
            </ul>
          </section>

          <!-- Gambar 2 -->
          <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
            <img 
              src="/assets/img/tempat-magang-malang-2.webp" 
              alt="Mahasiswa berdiskusi dengan pembimbing" 
              class="w-full h-auto max-h-[380px] object-cover"
              loading="lazy"
            />
            <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
              Mahasiswa berdiskusi dengan pembimbing.
            </figcaption>
          </figure>

          <section id="cocok-jurusan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Jenis tempat magang apa yang cocok untuk jurusan saya?</h2>
            <p>
              Pilih tempat magang yang tugas hariannya memakai kompetensi inti jurusan Anda, karena kecocokan tugas menentukan keterampilan yang dapat dicantumkan pada CV setelah magang selesai.
            </p>
            <p>
              Berikut pemetaan umum. Pemetaan ini bukan aturan baku, sehingga tetap sesuaikan dengan kurikulum kampus atau sekolah.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Informatika, sistem informasi, dan RPL SMK:</strong> startup, software house, agensi digital, bagian teknologi informasi di perusahaan atau instansi.</li>
              <li><strong>Ekonomi, akuntansi, dan manajemen:</strong> kantor akuntan, bank, bagian keuangan perusahaan, dan UMKM yang membutuhkan pembukuan.</li>
              <li><strong>Komunikasi dan desain komunikasi visual:</strong> agensi kreatif, media lokal, humas instansi, dan tim konten perusahaan.</li>
              <li><strong>Hukum dan ilmu pemerintahan:</strong> kantor hukum, instansi pemerintah, dan lembaga bantuan hukum.</li>
              <li><strong>Kesehatan dan keperawatan:</strong> rumah sakit, puskesmas, dan klinik, dengan pembimbing klinik yang jelas.</li>
              <li><strong>Pariwisata dan perhotelan:</strong> hotel dan destinasi wisata di Kota Batu dan Malang Raya.</li>
              <li><strong>Teknik dan SMK teknik:</strong> bengkel, pabrik, kontraktor, dan unit pemeliharaan fasilitas.</li>
              <li><strong>Pendidikan:</strong> sekolah, lembaga kursus, dan pusat pelatihan.</li>
            </ul>
          </section>

          <section id="cara-memilih" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana cara memilih tempat magang di Malang?</h2>
            <p>
              Pilih tempat magang dengan membandingkan kesesuaian tugas, kejelasan pembimbing, jadwal, lokasi, dan keterbukaan uang saku, lalu verifikasi legalitasnya sebelum mengirim lamaran.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Tentukan tujuan magang.</strong> Tujuannya bisa memenuhi syarat akademik, membangun portofolio, atau membuka peluang kerja.</li>
              <li><strong>Periksa deskripsi tugas.</strong> Tugas yang jelas dan terukur menandakan tempat magang punya rencana, bukan sekadar mencari tenaga tambahan.</li>
              <li><strong>Pastikan ada pembimbing.</strong> Pembimbing lapangan membantu evaluasi, penilaian, dan tanda tangan laporan.</li>
              <li><strong>Cocokkan jadwal dengan kuliah atau sekolah.</strong> Durasi dan hari kerja harus sesuai ketentuan kampus atau sekolah.</li>
              <li><strong>Hitung biaya nyata.</strong> Biaya kos, bensin atau transportasi online, dan makan siang memengaruhi kelayakan lokasi.</li>
              <li><strong>Tanyakan uang saku dan fasilitas.</strong> Tanyakan secara sopan dan minta jawaban tertulis.</li>
              <li><strong>Verifikasi tempat magang.</strong> Cocokkan alamat, kontak resmi, dan keberadaan perusahaan di kanal resmi.</li>
            </ul>
          </section>

          <section id="hal-dicek" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa yang harus dicek sebelum mendaftar magang?</h2>
            <p>
              Sebelum mendaftar magang, cek legalitas tempat, deskripsi tugas, durasi, jam kerja, uang saku, model kerja, perjanjian tertulis, dan keluaran berupa sertifikat atau surat keterangan.
            </p>
            <p>Gunakan daftar berikut sebagai checklist pribadi.</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Nama perusahaan, alamat, dan kontak resmi dapat dihubungi dan konsisten di beberapa kanal.</li>
              <li>Proses seleksi tidak meminta pembayaran dalam bentuk apa pun.</li>
              <li>Posisi dan deskripsi tugas ditulis jelas.</li>
              <li>Durasi, jam kerja, dan hari kerja disebutkan.</li>
              <li>Uang saku atau kompensasi lain dijelaskan, termasuk jadwal pembayarannya.</li>
              <li>Model kerja, yaitu WFH, hybrid, atau onsite, disebutkan.</li>
              <li>Pembimbing lapangan atau penanggung jawab disebutkan.</li>
              <li>Ada perjanjian atau surat penerimaan tertulis.</li>
              <li>Kampus atau sekolah mengetahui dan menyetujui tempat magang tersebut.</li>
              <li>Keluaran akhir seperti sertifikat, surat keterangan, atau penilaian dijelaskan.</li>
              <li>Aspek keselamatan kerja dan lingkungan kerja yang aman dijelaskan, terutama untuk siswa SMK dan pekerjaan lapangan.</li>
            </ul>
          </section>

          <section id="tawaran-layak" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana tahu tawaran magang itu layak?</h2>
            <p>
              Tawaran magang layak jika identitas penyelenggara dapat diverifikasi, tugas dan hak peserta dijelaskan terbuka, serta tanpa permintaan biaya, data berlebihan, atau tekanan segera setuju.
            </p>
            <p>
              GASA dalam laporan State of Scams in Indonesia 2025 mencatat 49 persen respondennya pernah mengalami penipuan pekerjaan (dilaporkan Bisnis.com, 31 Oktober 2025).
            </p>
            <p>
              Sementara itu, SEEK mencatat Indonesia menyumbang 38 persen dari seluruh upaya penipuan lowongan kerja di Asia Pasifik pada periode Juli 2024 sampai Juni 2025.
            </p>
            <p>
              Angka-angka ini menunjukkan bahwa pencari magang perlu memeriksa setiap tawaran.
            </p>
          </section>

          <section id="uang-saku" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apakah magang dibayar dan berapa uang sakunya?</h2>
            <p>
              Magang dalam skema pemagangan resmi memberi hak uang saku, bukan gaji, dan besarnya ditetapkan dalam perjanjian karena belum ada nominal minimum yang diatur secara khusus.
            </p>
            <p>
              Peraturan Menteri Ketenagakerjaan Nomor 6 Tahun 2020 tentang Penyelenggaraan Pemagangan di Dalam Negeri mencantumkan uang saku sebagai hak peserta dan mewajibkan besarannya tertulis dalam perjanjian pemagangan.
            </p>
            <p>
              Peraturan yang sama membatasi jangka waktu pemagangan paling lama satu tahun. Teks resminya dapat dibaca di Berita Negara Republik Indonesia Nomor 351 Tahun 2020 di peraturan.go.id.
            </p>
            <p>
              Sebagai pembanding biaya hidup, Upah Minimum Kota Malang 2026 ditetapkan sebesar Rp3.736.101 dan berlaku sejak 1 Januari 2026. Angka ini bukan batas minimal uang saku, karena upah minimum berlaku untuk pekerja, bukan peserta magang akademik.
            </p>
          </section>

          <section id="model-kerja" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Magang WFH, hybrid, atau onsite, mana yang cocok?</h2>
            <p>
              Magang onsite cocok untuk pekerjaan praktik langsung, WFH untuk tugas digital terukur, dan hybrid untuk keseimbangan keduanya, selama kampus atau sekolah mengizinkan.
            </p>
            <p>
              Pilihan model kerja memengaruhi biaya transportasi, kualitas bimbingan, dan penilaian. Mahasiswa informatika dan desain lebih mungkin menemukan peluang WFH atau hybrid, sedangkan siswa SMK teknik dan mahasiswa kesehatan umumnya membutuhkan praktik langsung.
            </p>
          </section>

          <section id="kesalahan-umum" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa kesalahan umum saat mencari tempat magang?</h2>
            <p>
              Kesalahan umum pencari magang adalah melamar tanpa verifikasi, tidak menanyakan uang saku dan jam kerja, mengabaikan aturan kampus, serta menerima tawaran tanpa perjanjian tertulis.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Melamar ke banyak tempat tanpa memeriksa legalitasnya.</li>
              <li>Menerima tawaran lisan tanpa dokumen penerimaan.</li>
              <li>Memilih tempat hanya karena nama besar, padahal tugasnya tidak sesuai jurusan.</li>
              <li>Mengabaikan biaya transportasi dan kos sehingga uang saku tidak cukup.</li>
              <li>Mendaftar terlalu mepet dengan jadwal magang kampus atau sekolah.</li>
              <li>Membagikan dokumen pribadi, seperti foto KTP dan rekening, sebelum identitas penyelenggara terverifikasi.</li>
            </ul>
          </section>

          <!-- BACA JUGA BOX SISIPAN -->
          <div class="my-6">
            <a 
              href="/blog/magang-web-development-malang-skill-proyek" 
              class="block bg-tc-bg hover:bg-tc-card border-l-4 border-tc-accent p-5 rounded-2xl border border-tc-border transition-all shadow-lg group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold text-tc-accent uppercase tracking-wider block mb-1">BACA JUGA ARTIKEL TERKAIT</span>
                  <h4 class="text-white font-bold text-sm md:text-base group-hover:text-tc-accent transition-colors">
                    Magang Web Development di Malang: Skill, Proyek, dan Cara Mempersiapkan Diri &rarr;
                  </h4>
                </div>
              </div>
            </a>
          </div>

          <section id="waktu-mencari" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Kapan sebaiknya mulai mencari tempat magang?</h2>
            <p>
              Mulailah mencari tempat magang dua sampai tiga bulan sebelum jadwal magang, karena seleksi, surat pengantar kampus, dan penandatanganan perjanjian membutuhkan waktu.
            </p>
            <p>
              Waktu tersebut juga memberi ruang untuk membandingkan beberapa tawaran dan memverifikasinya. Siapkan CV, surat lamaran, transkrip atau rapor, dan surat pengantar dari kampus atau sekolah sebelum membuka pencarian.
            </p>
          </section>

          <section id="kesimpulan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Kesimpulan</h2>
            <p>
              Cari tempat magang di Malang dengan urutan: tentukan tujuan, cocokkan tugas dengan jurusan, verifikasi penyelenggara, tanyakan uang saku dan model kerja, minta perjanjian tertulis.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Gunakan checklist sebelum mendaftar untuk setiap tawaran.</li>
              <li>Bandingkan minimal tiga pilihan tempat magang.</li>
              <li>Hitung biaya transportasi dan kos secara nyata.</li>
              <li>Simpan bukti komunikasi dan dokumen penerimaan.</li>
