---
// src/pages/blog/persiapan-pkl-rpl.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Persiapan PKL RPL Skill Dasar dan Dokumen yang Perlu Siap";
const pageDesc = "Persiapan PKL RPL meliputi skill dasar web, dokumen sekolah, perlengkapan, dan sikap kerja. Cek daftarnya lalu tanya admin sebelum mendaftar PKL di Malang.";
const publishDate = "2026-11-25";
const publishIsoDate = "2026-11-25T12:18:00+07:00";
const pageSlug = "/blog/persiapan-pkl-rpl";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/persiapan-pkl-rpl-1.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/persiapan-pkl-rpl-2.webp";
const authorName = "Sholikhatun Nikmah";
const keywordsList = "persiapan pkl rpl, skill dasar pkl rpl, dokumen pkl rpl, perlengkapan pkl rpl, latihan sebelum pkl rpl";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "https://infomagangmalang.web.id/blog/persiapan-pkl-rpl#article",
      "isPartOf": {
        "@id": "https://infomagangmalang.web.id/blog/persiapan-pkl-rpl"
      },
      "headline": "Persiapan PKL RPL Skill Dasar dan Dokumen yang Perlu Siap",
      "description": "Persiapan PKL RPL meliputi skill dasar web, dokumen sekolah, perlengkapan, dan sikap kerja. Cek daftarnya lalu tanya admin sebelum mendaftar PKL di Malang.",
      "keywords": "persiapan pkl rpl, skill dasar pkl rpl, dokumen pkl rpl, perlengkapan pkl rpl, latihan sebelum pkl rpl",
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://infomagangmalang.web.id/blog/persiapan-pkl-rpl"
      },
      "datePublished": "2026-11-25T12:18:00+07:00",
      "dateModified": "2026-11-25T12:18:00+07:00",
      "author": {
        "@type": "Person",
        "name": "Sholikhatun Nikmah"
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        "https://infomagangmalang.web.id/assets/img/persiapan-pkl-rpl-1.webp",
        "https://infomagangmalang.web.id/assets/img/persiapan-pkl-rpl-2.webp"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://infomagangmalang.web.id/blog/persiapan-pkl-rpl#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah siswa RPL harus mahir ngoding sebelum PKL?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak harus mahir. Pemahaman dasar HTML dan CSS serta kemauan belajar sudah menjadi modal yang cukup, karena program PKL di Gemilang Training dibimbing bertahap dari dasar."
          }
        },
        {
          "@type": "Question",
          "name": "Kapan waktu terbaik mulai menyiapkan berkas PKL?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mulailah segera setelah sekolah mengumumkan jadwal PKL. Waktu pastinya mengikuti kalender sekolah, sehingga siswa perlu menanyakannya kepada guru pembimbing agar berkas tidak terlambat."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara mengetahui tempat PKL RPL dapat dipercaya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Periksa alamat, kegiatan nyata, mentor, dan bukti karya peserta sebelumnya. Hubungi admin dan minta penjelasan tertulis tentang tugas, tools, serta output PKL sebelum menyerahkan data pribadi."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah perlu sertifikat sebelum PKL?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak ada kewajiban umum untuk memiliki sertifikat sebelum PKL. Persyaratan dapat berbeda di tiap tempat, jadi siswa sebaiknya menanyakannya langsung kepada admin tempat PKL."
          }
        }
      ]
    }
  ]
