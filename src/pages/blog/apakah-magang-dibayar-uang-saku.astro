---
// src/pages/blog/apakah-magang-dibayar-uang-saku.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Hak dan Fasilitas Peserta Magang serta Cara Mengonfirmasinya";
const pageDesc = "Apakah magang dibayar? Pahami uang saku, bedanya dengan gaji, aturan dasarnya, dan cara menanyakannya dengan sopan. Baca panduan lengkapnya sekarang juga.";
const publishDate = "2026-11-22";
const publishIsoDate = "2026-11-22T16:00:00+07:00";
const pageSlug = "/blog/apakah-magang-dibayar-uang-saku";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/ciri-tawaran-magang-perlu-diwaspadai-1.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/ciri-tawaran-magang-perlu-diwaspadai-2.webp";
const authorName = "Tim Redaksi Gemilang Training";
const keywordsList = "apakah magang dibayar, uang saku magang, beda uang saku dan gaji, uang saku magang Malang, cara menanyakan uang saku magang";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Organization",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        secondImageUrl
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah uang saku magang harus sama dengan UMK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak otomatis. Belum ada nominal minimum uang saku pemagangan yang diatur khusus, tetapi program tertentu seperti Magang Nasional menetapkan uang saku setara upah minimum."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah magang akademik di kampus wajib dibayar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bergantung pada program dan kesepakatan. Tanyakan ke kampus dan penyelenggara, lalu pastikan jawabannya tercantum dalam surat penerimaan atau perjanjian."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah boleh meminta uang transport jika magang tidak dibayar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Boleh bertanya secara sopan. Penyelenggara dapat menolak, tetapi kejelasan tentang fasilitas membantu Anda memutuskan apakah magang tersebut terjangkau."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/ciri-tawaran-magang-perlu-diwaspadai-1.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Peserta magang membaca perjanjian magang" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Panduan Magang" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Panduan Magang</span>
            <time datetime={publishIsoDate}>22 November 2026 • 16:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            {pageTitle}
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/ciri-tawaran-magang-perlu-diwaspadai-1.webp" 
            alt="Peserta magang membaca perjanjian magang" 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Peserta magang membaca perjanjian magang.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
            <span>Daftar Isi Panduan</span>
            <span id="toc-icon" class="text-xs font-bold" style="color: #eab308; font-variant-emoji: text;">▼</span>
          </button>
          <div id="toc-content" class="text-xs text-tc-muted space-y-2 pt-2 border-t border-tc-border/60">
            <ul class="space-y-1.5 list-disc list-inside">
              <li><a href="#ringkasan-inti" class="hover:text-tc-accent transition-colors">1. Ringkasan Inti</a></li>
              <li><a href="#wajib-dibayar" class="hover:text-tc-accent transition-colors">2. Apakah magang wajib dibayar?</a></li>
              <li><a href="#beda-uang-saku-gaji" class="hover:text-tc-accent transition-colors">3. Apa beda uang saku dan gaji?</a></li>
              <li><a href="#uang-saku-malang" class="hover:text-tc-accent transition-colors">4. Berapa uang saku magang yang wajar di Malang?</a></li>
              <li><a href="#menanyakan-sopan" class="hover:text-tc-accent transition-colors">5. Bagaimana menanyakan uang saku magang dengan sopan?</a></li>
              <li><a href="#tanpa-uang-saku" class="hover:text-tc-accent transition-colors">6. Bagaimana jika magang tanpa uang saku karena kewajiban kampus atau sekolah?</a></li>
              <li><a href="#faq-section" class="hover:text-tc-accent transition-colors">7. FAQ tentang Uang Saku Magang</a></li>
              <li><a href="#kesimpulan" class="hover:text-tc-accent transition-colors">8. Kesimpulan</a></li>
            </ul>
          </div>
        </div>

        <div class="space-y-8 text-tc-muted text-sm md:text-base leading-relaxed">
          <p>
            <strong>Apakah magang dibayar?</strong> Pada pemagangan resmi, peserta berhak atas uang saku yang besarannya disepakati dalam perjanjian, sedangkan magang akademik dapat berbeda sehingga wajib ditanyakan.
          </p>

          <section id="ringkasan-inti" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Ringkasan Inti</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li>Peraturan Menteri Ketenagakerjaan Nomor 6 Tahun 2020 mencantumkan uang saku sebagai hak peserta pemagangan dan mewajibkan besarannya tertulis dalam perjanjian.</li>
              <li>Uang saku berbeda dari gaji dan tidak otomatis sama dengan upah minimum, karena belum ada nominal minimum khusus yang diatur.</li>
              <li>Upah Minimum Kota Malang 2026 sebesar Rp3.736.101 dapat dipakai sebagai pembanding biaya hidup.</li>
              <li>Program Magang Nasional 2026 memberi uang saku setara upah minimum provinsi atau kabupaten atau kota sesuai domisili magang.</li>
              <li>Tanyakan uang saku secara sopan sebelum menerima tawaran dan minta jawaban tertulis.</li>
            </ul>
          </section>

          <!-- Gambar 2 -->
          <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
            <img 
              src="/assets/img/ciri-tawaran-magang-perlu-diwaspadai-2.webp" 
              alt="Kandidat magang berdiskusi dengan sopan" 
              class="w-full h-auto max-h-[380px] object-cover"
              loading="lazy"
            />
            <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
              Kandidat magang berdiskusi dengan sopan.
            </figcaption>
          </figure>

          <section id="wajib-dibayar" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apakah magang wajib dibayar?</h2>
            <p>
              Pemagangan resmi memberi hak uang saku kepada peserta, sedangkan magang akademik bergantung pada program dan kesepakatan sehingga status pembayarannya perlu dikonfirmasi sebelum mulai.
            </p>
            <p>
              Peraturan Menteri Ketenagakerjaan Nomor 6 Tahun 2020 menyebut uang saku sebagai salah satu hak peserta pemagangan di dalam negeri, bersama bimbingan, jaminan keselamatan dan kesehatan kerja, serta sertifikat. Besaran uang saku dicantumkan dalam perjanjian pemagangan.
            </p>
            <p>
              Magang yang dilakukan karena kewajiban kurikulum dapat berada di kerangka berbeda. Beberapa kajian akademik juga membahas Peraturan Menteri Pendidikan, Kebudayaan, Riset, dan Teknologi Nomor 63 Tahun 2024 tentang magang mahasiswa.
            </p>
            <p>
              Karena rincian setiap program dapat berbeda, baca ketentuan program dan konfirmasi ke kampus atau sekolah.
            </p>
          </section>

          <section id="beda-uang-saku-gaji" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Apa beda uang saku dan gaji?</h2>
            <p>
              Uang saku adalah kompensasi bagi peserta pemagangan yang besarnya disepakati, sedangkan gaji adalah hak pekerja berdasarkan hubungan kerja dan umumnya mengacu pada upah minimum.
            </p>
            <p>Perbedaan praktisnya:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Dasar hukum.</strong> Uang saku pemagangan diatur Peraturan Menteri Ketenagakerjaan Nomor 6 Tahun 2020, sedangkan upah pekerja diatur undang-undang ketenagakerjaan dan aturan pengupahan.</li>
              <li><strong>Status.</strong> Peserta pemagangan berstatus peserta pembelajaran, bukan pekerja dengan hubungan kerja penuh.</li>
              <li><strong>Besaran.</strong> Uang saku tidak otomatis setara upah minimum, kecuali program tertentu menetapkannya demikian.</li>
              <li><strong>Tujuan.</strong> Uang saku membantu biaya selama magang, sedangkan upah adalah imbalan atas pekerjaan.</li>
            </ul>
            <p>
              Perbedaan status ini tidak berarti peserta boleh diperlakukan seperti pekerja penuh tanpa hak. Peserta tetap berhak atas bimbingan, keselamatan kerja, dan perlakuan yang adil sesuai perjanjian.
            </p>
          </section>

          <section id="uang-saku-malang" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Berapa uang saku magang yang wajar di Malang?</h2>
            <p>
              Uang saku magang di Malang bervariasi menurut penyelenggara dan program, sehingga acuan utamanya adalah perjanjian tertulis, biaya hidup nyata, dan ketentuan program yang Anda ikuti.
            </p>
            <p>
              Sebagai pembanding, Upah Minimum Kota Malang 2026 ditetapkan Rp3.736.101 dan Upah Minimum Kabupaten Malang 2026 Rp3.802.862 berdasarkan Keputusan Gubernur Jawa Timur Nomor 100.3.3.1/937/013/2025, berlaku sejak 1 Januari 2026. Angka ini bukan kewajiban uang saku, tetapi membantu Anda menilai apakah tawaran terlalu rendah dibandingkan biaya hidup.
            </p>
            <p>
              Kemnaker menyatakan peserta program Magang Nasional 2026 menerima uang saku setara upah minimum sesuai domisili magang (dilaporkan detikFinance, 7 Juli 2026). Program pemerintah ini memiliki ketentuan sendiri, sehingga syaratnya tidak otomatis berlaku di semua tempat magang.
            </p>
            <p>
              Karena nominal tidak diseragamkan, hitung kebutuhan nyata Anda: sewa kos, transportasi, makan siang, dan biaya internet bila bekerja dari rumah.
            </p>
          </section>

          <section id="menanyakan-sopan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana menanyakan uang saku magang dengan sopan?</h2>
            <p>
              Tanyakan uang saku magang saat wawancara atau setelah ada tanda minat, dengan bahasa netral, lalu minta jawaban tertulis dalam surat penerimaan atau perjanjian.
            </p>
            <p>Contoh kalimat yang bisa dipakai:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>"Terima kasih atas kesempatannya. Boleh saya tahu apakah program magang ini memberikan uang saku atau tunjangan lain?"</li>
              <li>"Apakah ada fasilitas seperti uang transport atau makan selama magang?"</li>
              <li>"Jika ada uang saku, kapan jadwal pembayarannya dan apakah dicantumkan dalam perjanjian?"</li>
              <li>"Agar saya dapat menyesuaikan dengan biaya hidup di Malang, bisakah rincian ini dicantumkan pada surat penerimaan?"</li>
            </ul>
            <p>
              Waktu terbaik bertanya adalah saat wawancara akhir atau setelah ada tanda minat dari penyelenggara.
            </p>
          </section>

          <!-- BACA JUGA BOX SISIPAN -->
          <div class="my-6">
            <a 
              href="/blog/tempat-magang-malang" 
              class="block bg-tc-bg hover:bg-tc-card border-l-4 border-tc-accent p-5 rounded-2xl border border-tc-border transition-all shadow-lg group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold text-tc-accent uppercase tracking-wider block mb-1">BACA JUGA ARTIKEL TERKAIT</span>
                  <h4 class="text-white font-bold text-sm md:text-base group-hover:text-tc-accent transition-colors">
                    Tempat Magang di Malang 2027 dan Cara Memilihnya &rarr;
                  </h4>
                </div>
              </div>
            </a>
          </div>

          <section id="tanpa-uang-saku" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bagaimana jika magang tanpa uang saku karena kewajiban kampus atau sekolah?</h2>
            <p>
              Magang tanpa uang saku dapat dipertimbangkan jika tujuannya akademik, tugasnya jelas, ada pembimbing, dan biayanya terjangkau, tetapi beban kerja tetap harus wajar.
            </p>
            <p>
              Survei yang dimuat Koran Jakarta pada 19 Juni 2023 terhadap 215 responden yang pernah magang saat menjadi pelajar atau mahasiswa menemukan bahwa 53 persen sering bekerja di luar jam kerja dan membawa pekerjaan ke rumah. Temuan ini menunjukkan pentingnya membatasi beban kerja, terutama bila tidak ada uang saku.
            </p>
            <p>Pertimbangkan hal berikut sebelum menerima magang tanpa uang saku:</p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Durasi dan jam kerja ditulis jelas dan tidak berlebihan.</li>
              <li>Tugas bersifat pembelajaran, bukan menggantikan karyawan penuh waktu.</li>
              <li>Ada pembimbing, penilaian, dan sertifikat atau surat keterangan.</li>
              <li>Biaya transportasi dan makan dapat Anda tanggung selama masa magang.</li>
            </ul>
          </section>

          <section id="kesimpulan" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Kesimpulan</h2>
            <p>
              Jawaban apakah magang dibayar bergantung pada jenis program: pemagangan resmi memberi hak uang saku, sedangkan magang akademik wajib dikonfirmasi, dan semua kesepakatan sebaiknya tertulis.
            </p>
            <ul class="list-disc pl-5 space-y-2">
              <li>Bedakan uang saku dari gaji.</li>
              <li>Gunakan upah minimum Malang sebagai pembanding, bukan kewajiban.</li>
              <li>Tanyakan uang saku dengan kalimat netral dan sopan.</li>
              <li>Minta rincian tertulis pada surat penerimaan atau perjanjian.</li>
              <li>Hitung biaya hidup nyata sebelum menerima tawaran.</li>
            </ul>
            <p>
              Informasi dalam artikel ini bersifat umum dan bukan nasihat hukum. Untuk sengketa uang saku atau hak peserta, konsultasikan dengan kampus, dinas ketenagakerjaan, atau konsultan hukum.
            </p>
          </section>
        </div>

        <!-- KOTAK AUTHOR (PENULIS) -->
        <div class="my-8 p-6 bg-tc-bg border border-tc-border rounded-2xl flex flex-col sm:flex-row items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold text-xl shrink-0">
            GT
          </div>
          <div class="space-y-1 text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start gap-2">
              <h4 class="text-white font-bold text-base">{authorName}</h4>
              <span class="bg-tc-accent/20 text-tc-accent text-[10px] font-semibold px-2 py-0.5 rounded-full border border-tc-accent/40">Verified Author</span>
            </div>
            <p class="text-tc-muted text-xs leading-relaxed">
              Tim redaksi Gemilang Training Malang untuk panduan hak peserta magang, uang saku, dan etika konfirmasi program magang.
            </p>
          </div>
        </div>

        <!-- CTA PROMO WHATSAPP -->
        <div class="bg-gradient-to-r from-tc-bg to-tc-card border border-tc-accent/50 rounded-3xl p-6 md:p-8 text-center space-y-4 shadow-2xl">
          <h3 class="text-xl font-bold text-white">Konsultasi Program Magang di Gemilang Training</h3>
          <p class="text-tc-muted text-xs md:text-sm max-w-lg mx-auto">
            Tanyakan detail alur, ketentuan program, dan kesesuaian bidang praktik bersama admin resmi kami di Malang.
          </p>
          <a 
            href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20bertanya%20mengenai%20ketentuan%20dan%20program%20magang." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-6 py-3 rounded-xl transition-all shadow-lg text-xs md:text-sm"
          >
            <span>Konsultasi via WA</span>
          </a>
        </div>

        <!-- FAQ ACCORDION SECTION -->
        <section id="faq-section" class="border-t border-tc-border pt-8 space-y-4">
          <h3 class="text-xl font-bold text-white">FAQ tentang Uang Saku Magang</h3>
          <p class="text-tc-muted text-xs md:text-sm leading-relaxed">
            Berikut jawaban singkat untuk pertanyaan yang sering muncul seputar pembayaran magang, ditulis agar dapat dipahami tanpa membaca bagian lain artikel.
          </p>
          <div class="space-y-3">
            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apakah uang saku magang harus sama dengan UMK?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Tidak otomatis. Belum ada nominal minimum uang saku pemagangan yang diatur khusus, tetapi program tertentu seperti Magang Nasional menetapkan uang saku setara upah minimum.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apakah magang akademik di kampus wajib dibayar?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Bergantung pada program dan kesepakatan. Tanyakan ke kampus dan penyelenggara, lalu pastikan jawabannya tercantum dalam surat penerimaan atau perjanjian.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apakah boleh meminta uang transport jika magang tidak dibayar?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Boleh bertanya secara sopan. Penyelenggara dapat menolak, tetapi kejelasan tentang fasilitas membantu Anda memutuskan apakah magang tersebut terjangkau.
              </p>
            </details>
          </div>
        </section>

      </article>

      <!-- SIDEBAR (KANAN) -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-24 space-y-6">
          
          <!-- Box Fast Contact -->
          <div class="bg-tc-card p-6 rounded-3xl border border-tc-border space-y-4 shadow-xl">
            <h4 class="text-white font-bold text-base">Konsultasi Program Magang</h4>
            <p class="text-tc-muted text-xs leading-relaxed">
              Diskusikan ketentuan program, jadwal praktik, dan kesesuaian jurusan di Malang.
