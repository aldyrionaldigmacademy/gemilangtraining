      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://infomagangmalang.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://infomagangmalang.web.id/blog"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Mengenali Magang Berbasis Proyek Nyata dan Hasil yang Bisa Kamu Bawa Pulang",
          "item": "https://infomagangmalang.web.id/blog/ciri-magang-berbasis-proyek-nyata"
        }
