const pageUrl = "https://infomagangmalang.web.id/blog/ciri-magang-berbasis-proyek-nyata";
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/ciri-magang-berbasis-proyek-nyata-1.webp";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
