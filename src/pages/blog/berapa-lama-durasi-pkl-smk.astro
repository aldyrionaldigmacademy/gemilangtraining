---
// src/pages/blog/berapa-lama-durasi-pkl-smk.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Berapa Lama PKL SMK? Durasi Menurut Panduan Kemendikbud dan Cara Menghitungnya";
const metaTitle = "Berapa Lama PKL SMK? Durasi Menurut Panduan Kemendikbud dan Cara Menghitungnya";
const pageDesc = "Berapa lama durasi PKL SMK? Kelas XII minimal 16 minggu (736 JP), SMK 4 tahun 10 bulan. Cek hitungannya, lalu daftar PKL SMK lewat Info Magang Malang.";
const publishDate = "2026-11-21";
const publishIsoDate = "2026-11-21T16:00:00+07:00";
const pageSlug = "/blog/berapa-lama-durasi-pkl-smk";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/durasi-PKL-SMK-3.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/Siswa-SMK-PKL-di-Malang.webp";
const authorName = "Yolanda Deva Apriliana Putri";
const keywordsList = "berapa lama durasi pkl smk, berapa bulan pkl smk, pkl smk kelas berapa, durasi pkl kurikulum merdeka, perbedaan pkl smk 3 tahun dan 4 tahun, cara menghitung jp pkl smk, tempat pkl smk malang";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Berapa Lama Durasi PKL SMK Sesuai Kemendikbud 2026",
      "description": pageDesc,
      "inLanguage": "id-ID",
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "image": [ogImageUrl, secondImageUrl],
      "author": {
        "@type": "Person",
        "name": authorName,
        "url": "https://infomagangmalang.web.id/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Info Magang Malang",
        "url": "https://infomagangmalang.web.id/"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "about": "Durasi PKL SMK Kurikulum Merdeka",
      "keywords": keywordsList
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Berapa bulan PKL SMK?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PKL SMK program 3 tahun berlangsung minimal satu semester atau 16 minggu efektif, setara sekitar 4 bulan kalender, di kelas XII. SMK program 4 tahun menjalani PKL minimal 10 bulan di kelas XIII. Di industri, durasi penempatan umumnya 3 sampai 6 bulan mengikuti kalender akademik sekolah."
          }
        },
        {
          "@type": "Question",
          "name": "PKL SMK kelas berapa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Panduan Kemendikbudristek menempatkan PKL di kelas XII untuk SMK program 3 tahun dan kelas XIII untuk SMK program 4 tahun. Sebagian SMK di Malang menjadwalkan PKL mulai kelas XI sesuai kalender akademik, sehingga siswa perlu memeriksa jadwal resmi sekolah masing-masing sebelum mendaftar ke tempat PKL."
          }
        },
        {
          "@type": "Question",
          "name": "Apa bedanya PKL SMK 3 tahun dan 4 tahun?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SMK program 3 tahun melaksanakan PKL di kelas XII selama minimal 16 minggu efektif (736 JP). SMK program 4 tahun melaksanakannya di kelas XIII selama minimal 10 bulan (1.216 JP). Perbedaan utamanya ada pada kelas pelaksanaan, lama waktu, dan total jam pelajaran yang wajib dipenuhi siswa."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa total JP minimal untuk PKL SMK di Kurikulum Merdeka?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Total JP minimal PKL pada Kurikulum Merdeka adalah 736 JP untuk SMK program 3 tahun dan 1.216 JP untuk SMK program 4 tahun, menurut Panduan PKL sebagai Mata Pelajaran dari Kemendikbudristek. Sebagian dokumen sekolah mencantumkan angka berbeda, sehingga sekolah perlu memastikan edisi panduan yang dipakai."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara menghitung 736 JP ke dalam minggu atau bulan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bagi total JP dengan jumlah JP per minggu. Untuk SMK 3 tahun, 736 JP dibagi 46 JP per minggu menghasilkan 16 minggu, atau sekitar 3,7 bulan jika dibagi 4,3 minggu per bulan. Hasil ini dibulatkan menjadi 4 bulan kalender, di luar waktu pembekalan dan asesmen."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah PKL SMK bisa dilaksanakan di kelas XI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PKL SMK bisa dilaksanakan di kelas XI jika sekolah menetapkannya dalam kalender akademik, karena sebagian SMK di Malang menjadwalkan PKL lebih awal. Ketentuan Kemendikbudristek menempatkan PKL di kelas XII (program 3 tahun) dan kelas XIII (program 4 tahun), sehingga siswa wajib memastikan jadwal ke guru koordinator PKL."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana jika kalender sekolah berbeda dari ketentuan standar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jika kalender akademik sekolah berbeda dari ketentuan standar, ikuti kalender sekolah dan pastikan total durasi serta JP tetap memenuhi batas minimal panduan. Guru koordinator PKL menyesuaikan tanggal mulai, tanggal selesai, dan penempatan industri, sehingga siswa hanya perlu mengonfirmasi jadwal sebelum mendaftar."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={metaTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/durasi-PKL-SMK-3.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
