---
// src/pages/blog/magang-wordpress-developer.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Magang WordPress Developer Tugas dan Skill Pemula";
const pageDesc = "Pelajari tugas, skill, dan output magang WordPress developer untuk pemula, serta cara daftar. Mulai bangun portofolio website bersama mentor.";
const publishDate = "2026-11-25";
const publishIsoDate = "2026-11-25T15:00:00+07:00";
const pageSlug = "/blog/magang-wordpress-developer";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/magang-wordpress-developer-1.webp";
