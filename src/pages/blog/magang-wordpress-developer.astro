const keywordsList = "magang wordpress developer, tugas magang wordpress, skill magang wordpress pemula, perbedaan wordpress developer dan web developer, cara daftar magang wordpress";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "https://infomagangmalang.web.id/blog/magang-wordpress-developer#article",
      "isPartOf": {
        "@id": "https://infomagangmalang.web.id/blog/magang-wordpress-developer"
      },
      "headline": "Magang WordPress Developer Tugas dan Skill Pemula",
      "description": "Pelajari tugas, skill, dan output magang WordPress developer untuk pemula, serta cara daftar. Mulai bangun portofolio website bersama mentor.",
      "keywords": "magang wordpress developer, tugas magang wordpress, skill magang wordpress pemula, perbedaan wordpress developer dan web developer, cara daftar magang wordpress",
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://infomagangmalang.web.id/blog/magang-wordpress-developer"
      },
      "datePublished": "2026-11-25T15:00:00+07:00",
      "dateModified": "2026-11-25T15:00:00+07:00",
      "author": {
        "@type": "Person",
        "name": "Sholikhatun Nikmah"
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        "https://infomagangmalang.web.id/assets/img/magang-wordpress-developer-1.webp",
        "https://infomagangmalang.web.id/assets/img/magang-wordpress-developer-2.webp"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://infomagangmalang.web.id/blog/magang-wordpress-developer#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa tugas magang WordPress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tugas umumnya meliputi memasang dan mengatur tema, memilih plugin, mengelola halaman dan artikel, serta merapikan tampilan website. Detail tugas dikonfirmasi bersama mentor di tempat magang."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah magang WordPress perlu bisa coding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak wajib untuk pemula. Penggunaan dasar WordPress dapat dipelajari lebih dulu, tetapi HTML dan CSS membantu saat tampilan perlu disesuaikan secara khusus."
          }
        },
        {
          "@type": "Question",
          "name": "Apa bedanya magang WordPress dengan magang web developer biasa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Magang WordPress berfokus pada platform manajemen konten siap pakai, sedangkan magang web developer biasa lebih banyak menulis kode HTML, CSS, dan JavaScript dari awal."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/magang-wordpress-developer-1.webp"
  imageAlt="Developer mengelola dashboard WordPress"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Developer mengelola dashboard WordPress" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Cluster 3 • Web Development" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
