---
// src/pages/blog/magang-web-development-malang-skill-proyek.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Magang Web Development di Malang: Skill, Proyek, dan Cara Mempersiapkan Diri";
const pageDesc = "Magang web development di Malang: skill HTML, CSS, JavaScript, Front-End, Back-End, Full-Stack, proyek website responsif, Git dan GitHub, serta cara mempersiapkan diri.";
const publishDate = "2026-11-22";
const publishIsoDate = "2026-11-22T08:00:00+07:00";
const pageSlug = "/magang-web-development-malang-skill-proyek";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/Peserta-magang-mengerjakan-proyek-website-responsif.webp";
const authorName = "Content Writer - Tim Gemilang Training";
const keywordsList = "magang web development Malang, magang programmer Malang, magang RPL Malang, magang front-end, Gemilang Training Malang";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Person",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        "https://infomagangmalang.web.id/assets/img/Mentor-mengevaluasi-hasil-kode-peserta-magang.webp"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa saja yang dipelajari di magang web development?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "HTML, CSS, JavaScript, Front-End, Back-End, Full-Stack, dan pembuatan website responsif, dengan tools Git dan GitHub."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama magangnya?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durasi program 6 bulan sampai 1 tahun, mengikuti program dan kesepakatan."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah harus sudah mahir coding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak harus mahir, tetapi pemahaman dasar membantu. Konsultasikan kesiapan Anda lewat WhatsApp resmi."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara mendapatkan sertifikat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ikuti kegiatan penuh waktu, selesaikan proyek magang, isi jurnal, dan lulus evaluasi mentor."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/Peserta-magang-mengerjakan-proyek-website-responsif.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Peserta magang mengerjakan proyek website responsif di Gemilang Training." />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Artikel Utama (Pillar)" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Artikel Utama (Pillar)</span>
            <time datetime={publishIsoDate}>22 November 2026 • 08:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            {pageTitle}
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/Peserta-magang-mengerjakan-proyek-website-responsif.webp" 
            alt="Peserta magang mengerjakan proyek website responsif di Gemilang Training." 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Peserta magang mengerjakan proyek website responsif di Gemilang Training.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
            <span>Daftar Isi Panduan</span>
            <span id="toc-icon" class="text-xs">▼</span>
          </button>
          <div id="toc-content" class="text-xs text-tc-muted space-y-2 pt-2 border-t border-tc-border/60">
            <ul class="space-y-1.5 list-disc list-inside">
              <li><a href="#skill-dipelajari" class="hover:text-tc-accent transition-colors">1. Skill yang Dipelajari Selama Magang Web Development</a></li>
              <li><a href="#proyek-hasil" class="hover:text-tc-accent transition-colors">2. Proyek dan Hasil yang Bisa Dibawa Pulang</a></li>
              <li><a href="#persiapan-diri" class="hover:text-tc-accent transition-colors">3. Cara Mempersiapkan Diri Sebelum Magang</a></li>
              <li><a href="#syarat-sertifikat" class="hover:text-tc-accent transition-colors">4. Syarat Sertifikat Magang</a></li>
              <li><a href="#kesalahan-umum" class="hover:text-tc-accent transition-colors">5. Kesalahan Umum Calon Peserta Magang</a></li>
              <li><a href="#cara-mendaftar" class="hover:text-tc-accent transition-colors">6. Cara Mendaftar Magang di Gemilang Training</a></li>
              <li><a href="#checklist-webdev" class="hover:text-tc-accent transition-colors">7. Checklist Magang Web Development</a></li>
              <li><a href="#faq-section" class="hover:text-tc-accent transition-colors">8. Pertanyaan yang Sering Diajukan</a></li>
            </ul>
          </div>
        </div>

        <div class="space-y-8 text-tc-muted text-sm md:text-base leading-relaxed">
          <p>
            <strong>Magang web development di Malang</strong> paling berguna jika peserta mengerjakan proyek nyata, bukan hanya mengamati. Di Gemilang Training, jalur RPL mencakup HTML, CSS, JavaScript, Front-End, Back-End, Full-Stack, dan pembuatan website responsif, dengan Git dan GitHub sebagai tools. Program di Gemilang Training berdurasi 6 bulan sampai 1 tahun, sesuai program dan kesepakatan.
          </p>
          <p>
            Banyak calon peserta bingung harus menguasai apa sebelum magang dan hasil apa yang bisa dibawa pulang. Artikel dari <strong>infomagangmalang.web.id</strong> ini menjawab keduanya: skill yang dipelajari, proyek yang dikerjakan, dan persiapan sebelum mendaftar.
          </p>

          <section id="skill-dipelajari" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Skill yang Dipelajari Selama Magang Web Development</h2>

            <div class="overflow-x-auto my-6 border border-tc-border rounded-2xl bg-tc-bg">
              <table class="w-full text-left text-xs md:text-sm">
                <thead class="bg-tc-card text-white font-bold border-b border-tc-border">
                  <tr>
                    <th class="p-3">Skill</th>
                    <th class="p-3 text-tc-accent">Gambaran aktivitas</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-tc-border/60">
                  <tr>
                    <td class="p-3 font-semibold text-white">HTML, CSS, JavaScript</td>
                    <td class="p-3 text-tc-accent">Dasar pembuatan halaman web</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">Front-End</td>
                    <td class="p-3 text-tc-accent">Membangun tampilan yang dilihat pengguna</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">Back-End</td>
                    <td class="p-3 text-tc-accent">Mengelola sisi server dan logika website</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">Full-Stack</td>
                    <td class="p-3 text-tc-accent">Menggabungkan Front-End dan Back-End dalam satu proyek</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">Website responsif</td>
                    <td class="p-3 text-tc-accent">Tampilan yang menyesuaikan berbagai ukuran layar</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">Git dan GitHub</td>
                    <td class="p-3 text-tc-accent">Mencatat dan menyimpan perubahan kode</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- Gambar 2 -->
          <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
            <img 
              src="/assets/img/Mentor-mengevaluasi-hasil-kode-peserta-magang.webp" 
              alt="Mentor mengevaluasi hasil kode peserta magang di Gemilang Training." 
              class="w-full h-auto max-h-[380px] object-cover"
              loading="lazy"
            />
            <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
              Mentor mengevaluasi hasil kode peserta magang di Gemilang Training.
            </figcaption>
          </figure>

          <section id="proyek-hasil" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Proyek dan Hasil yang Bisa Dibawa Pulang</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Website responsif</strong> sebagai proyek magang yang dapat dinilai mentor.</li>
              <li><strong>Riwayat kode di GitHub</strong> sebagai bukti proses kerja.</li>
              <li><strong>Jurnal kegiatan</strong> yang menjadi bahan laporan.</li>
              <li><strong>Sertifikat magang</strong> jika ketentuan terpenuhi.</li>
            </ul>
          </section>

          <section id="persiapan-diri" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Cara Mempersiapkan Diri Sebelum Magang</h2>
            <ol class="list-decimal pl-5 space-y-2">
              <li><strong>Kenali dasar web.</strong> Pelajari sekilas HTML, CSS, dan JavaScript agar tidak mulai dari nol.</li>
              <li><strong>Pahami alur Git.</strong> Cukup konsep dasar mencatat dan mengirim perubahan kode.</li>
              <li><strong>Siapkan perangkat dan koneksi.</strong> Pastikan Anda bisa mengikuti kegiatan penuh waktu.</li>
              <li><strong>Cocokkan jadwal.</strong> Durasi 6 bulan sampai 1 tahun perlu sesuai jadwal sekolah atau kampus.</li>
              <li><strong>Siapkan pertanyaan untuk mentor.</strong> Tanyakan proyek, penilaian, dan syarat sertifikat sejak awal.</li>
            </ol>
          </section>

          <section id="syarat-sertifikat" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Syarat Sertifikat Magang</h2>
            <p>
              Sertifikat diberikan setelah peserta mengikuti kegiatan penuh waktu, menyelesaikan proyek magang, mengisi jurnal, dan lulus evaluasi dari mentor.
            </p>
          </section>

          <section id="kesalahan-umum" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Kesalahan Umum Calon Peserta Magang</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Hanya mencari nama tempat.</strong> Nama besar belum tentu memberi proyek yang relevan.</li>
              <li><strong>Tidak menanyakan penilaian dan jurnal.</strong> Dokumen akhir bisa terlambat atau tidak sesuai.</li>
              <li><strong>Menganggap sertifikat otomatis.</strong> Sertifikat bergantung pada kegiatan yang diselesaikan.</li>
              <li><strong>Tidak menyimpan hasil proyek.</strong> Tanpa bukti kerja, kontribusi sulit dijelaskan.</li>
            </ul>
            <p>
              Tertarik di bidang pemasaran? Baca <a href="/blog/magang-digital-marketing-malang-skill" class="text-tc-accent underline hover:text-white transition-colors">magang digital marketing di Malang</a>. Bingung memilih tempat? Lihat <a href="/blog/cara-memilih-tempat-magang-malang" class="text-tc-accent underline hover:text-white transition-colors">cara memilih tempat magang di Malang</a>.
            </p>
          </section>

          <!-- BACA JUGA BOX SISIPAN -->
          <div class="my-6">
            <a 
              href="/blog/magang-digital-marketing-malang-skill" 
              class="block bg-tc-bg hover:bg-tc-card border-l-4 border-tc-accent p-5 rounded-2xl border border-tc-border transition-all shadow-lg group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold text-tc-accent uppercase tracking-wider block mb-1">BACA JUGA ARTIKEL TERKAIT</span>
                  <h4 class="text-white font-bold text-sm md:text-base group-hover:text-tc-accent transition-colors">
                    Magang Digital Marketing di Malang: Apa yang Dikerjakan dan Skill yang Dibutuhkan &rarr;
                  </h4>
                </div>
              </div>
            </a>
          </div>

          <section id="cara-mendaftar" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Cara Mendaftar Magang di Gemilang Training</h2>
            <ol class="list-decimal pl-5 space-y-2">
              <li>Baca halaman program yang sesuai bidang Anda.</li>
              <li>Pastikan periode magang sesuai jadwal.</li>
              <li>Isi formulir pendaftaran.</li>
              <li>Siapkan surat pengantar jika diminta.</li>
              <li>Konfirmasi melalui WhatsApp resmi untuk membahas kecocokan bidang.</li>
            </ol>
          </section>

          <section id="checklist-webdev" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Checklist Magang Web Development</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li>Materi mencakup Front-End, Back-End, dan Full-Stack</li>
              <li>Ada proyek website responsif</li>
              <li>Git dan GitHub dipakai</li>
              <li>Jurnal dan syarat sertifikat jelas</li>
              <li>Durasi sudah cocok dengan jadwal</li>
            </ul>
          </section>
        </div>

        <!-- KOTAK AUTHOR (PENULIS) -->
        <div class="my-8 p-6 bg-tc-bg border border-tc-border rounded-2xl flex flex-col sm:flex-row items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold text-xl shrink-0">
            GT
          </div>
          <div class="space-y-1 text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start gap-2">
              <h4 class="text-white font-bold text-base">{authorName}</h4>
              <span class="bg-tc-accent/20 text-tc-accent text-[10px] font-semibold px-2 py-0.5 rounded-full border border-tc-accent/40">Verified Author</span>
            </div>
            <p class="text-tc-muted text-xs leading-relaxed">
              Tim redaksi dan pembimbing praktik Gemilang Training Malang untuk program web development dan proyek aplikasi web nyata.
            </p>
          </div>
        </div>

        <!-- CTA PROMO WHATSAPP -->
        <div class="bg-gradient-to-r from-tc-bg to-tc-card border border-tc-accent/50 rounded-3xl p-6 md:p-8 text-center space-y-4 shadow-2xl">
          <h3 class="text-xl font-bold text-white">Cek Program Magang Sekarang</h3>
          <p class="text-tc-muted text-xs md:text-sm max-w-lg mx-auto">
            Lihat program dan persyaratan pendaftaran Gemilang Training, lalu konfirmasi melalui WhatsApp resmi.
          </p>
          <a 
            href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20konsultasi%20Magang%20Web%20Development." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-6 py-3 rounded-xl transition-all shadow-lg text-xs md:text-sm"
          >
            <span>Konsultasi via WA</span>
          </a>
        </div>

        <!-- FAQ ACCORDION SECTION -->
        <section id="faq-section" class="border-t border-tc-border pt-8 space-y-4">
          <h3 class="text-xl font-bold text-white">Pertanyaan yang Sering Diajukan</h3>
          <div class="space-y-3">
            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apa saja yang dipelajari di magang web development?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                HTML, CSS, JavaScript, Front-End, Back-End, Full-Stack, dan pembuatan website responsif, dengan tools Git dan GitHub.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Berapa lama magangnya?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Durasi program 6 bulan sampai 1 tahun, mengikuti program dan kesepakatan.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apakah harus sudah mahir coding?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Tidak harus mahir, tetapi pemahaman dasar membantu. Konsultasikan kesiapan Anda lewat WhatsApp resmi.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Bagaimana cara mendapatkan sertifikat?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Ikuti kegiatan penuh waktu, selesaikan proyek magang, isi jurnal, dan lulus evaluasi mentor.
              </p>
            </details>
          </div>
        </section>

      </article>

      <!-- SIDEBAR (KANAN) -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-24 space-y-6">
          
          <!-- Box Fast Contact -->
          <div class="bg-tc-card p-6 rounded-3xl border border-tc-border space-y-4 shadow-xl">
            <h4 class="text-white font-bold text-base">Konsultasi Web Development</h4>
            <p class="text-tc-muted text-xs leading-relaxed">
              Tanyakan materi Front-End, Back-End, Full-Stack, Git/GitHub, dan jadwal magang di Malang.
            </p>
            <a 
              href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20konsultasi%20Magang%20Web%20Development." 
              target="_blank" 
              rel="noopener noreferrer"
              class="block text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold py-2.5 rounded-xl text-xs transition-all"
            >
              Chat WA: +62 819-4343-1484
            </a>
          </div>

          <!-- Card Artikel Rekomendasi (Saling Terhubung dengan Artikel 2 & 3) -->
          <div class="bg-tc-card p-6 rounded-3xl border border-tc-border space-y-4 shadow-xl">
            <h4 class="text-white font-bold text-base border-b border-tc-border pb-3">Artikel Rekomendasi</h4>
            
            <div class="space-y-4">
              <div class="space-y-2 group">
                <img src="/assets/img/Peserta-magang-menyusun-rencana-konten-media-sosial.webp" alt="Peserta magang menyusun rencana konten media sosial di Gemilang Training." class="w-full h-28 object-cover rounded-xl border border-tc-border" />
                <span class="text-[10px] font-mono text-tc-accent uppercase">Artikel Pendukung (Support)</span>
                <h5 class="text-xs font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
                  <a href="/blog/magang-digital-marketing-malang-skill">
                    Magang Digital Marketing di Malang: Apa yang Dikerjakan dan Skill yang Dibutuhkan
                  </a>
                </h5>
              </div>

              <div class="space-y-2 group">
                <img src="/assets/img/Calon-peserta-magang-berdiskusi-dengan-mentor.webp" alt="Calon peserta magang berdiskusi dengan mentor di Gemilang Training." class="w-full h-28 object-cover rounded-xl border border-tc-border" />
                <span class="text-[10px] font-mono text-tc-accent uppercase">Artikel Pendukung (Support)</span>
                <h5 class="text-xs font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
                  <a href="/blog/cara-memilih-tempat-magang-malang">
