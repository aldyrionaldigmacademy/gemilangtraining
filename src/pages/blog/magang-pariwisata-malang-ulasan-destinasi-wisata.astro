  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/magang-pariwisata-malang-ulasan-destinasi-wisata-1.webp"
  imageAlt="Peserta magang pariwisata menyusun blog ulasan destinasi wisata di laptop"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Peserta magang pariwisata menyusun blog ulasan destinasi wisata di laptop" />
