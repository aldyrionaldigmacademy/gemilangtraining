---
// src/pages/blog/aturan-semester-sks-magang-informatika.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Magang Informatika Semester Berapa Cek Aturan Kampus";
const pageDesc = "Magang informatika semester berapa? Cek cara membaca aturan semester, durasi, dan konversi SKS di kampusmu. Pelajari langkahnya sebelum mengajukan magang.";
const pageUrl = "https://infomagangmalang.web.id/blog/aturan-semester-sks-magang-informatika";
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/aturan-semester-sks-magang-informatika-1.webp";

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://infomagangmalang.web.id/blog/aturan-semester-sks-magang-informatika#article",
      "headline": "Kapan Mahasiswa Informatika Boleh Magang dan Cara Cek Aturan SKS di Kampus",
      "description": "Magang informatika semester berapa? Cek cara membaca aturan semester, durasi, dan konversi SKS di kampusmu. Pelajari langkahnya sebelum mengajukan magang.",
      "inLanguage": "id-ID",
      "mainEntityOfPage": "https://infomagangmalang.web.id/blog/aturan-semester-sks-magang-informatika",
