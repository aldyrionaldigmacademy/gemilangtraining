      "datePublished": "2026-11-23T09:00:00+07:00",
      "dateModified": "2026-11-23T09:00:00+07:00",
      "author": {
        "@type": "Person",
        "name": "Sholikhatun Nikmah"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Info Magang Malang (Gemilang Training)",
        "url": "https://infomagangmalang.web.id/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/logo.webp"
        }
      },
      "keywords": "magang informatika semester berapa, konversi sks magang informatika, aturan magang mahasiswa informatika, syarat krs magang"
    },
    {
