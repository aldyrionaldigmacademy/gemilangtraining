      "@id": "https://infomagangmalang.web.id/blog/aturan-semester-sks-magang-informatika#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah mahasiswa semester awal boleh magang?",
          "acceptedAnswer": {
