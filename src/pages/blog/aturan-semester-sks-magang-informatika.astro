        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://infomagangmalang.web.id/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://infomagangmalang.web.id/blog"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Kapan Mahasiswa Informatika Boleh Magang dan Cara Cek Aturan SKS di Kampus",
          "item": "https://infomagangmalang.web.id/blog/aturan-semester-sks-magang-informatika"
