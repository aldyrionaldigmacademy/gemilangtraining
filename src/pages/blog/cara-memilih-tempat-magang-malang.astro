---
// src/pages/blog/cara-memilih-tempat-magang-malang.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Cara Memilih Tempat Magang di Malang: 4 Hal yang Dicek Sebelum Daftar";
const pageDesc = "Cara memilih tempat magang di Malang: cek kesesuaian bidang, hasil kerja, pembimbing, jurnal, dan sertifikat sebelum mendaftar. Lengkap dengan checklist.";
const publishDate = "2026-11-22";
const publishIsoDate = "2026-11-22T10:00:00+07:00";
const pageSlug = "/cara-memilih-tempat-magang-malang";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/Calon-peserta-magang-berdiskusi-dengan-mentor.webp";
const authorName = "Tim Redaksi Gemilang Training";
const keywordsList = "tempat magang Malang, cara memilih tempat magang, magang di Malang, syarat sertifikat magang, Gemilang Training Malang";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Organization",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        "https://infomagangmalang.web.id/assets/img/Pengecekan-syarat-program-dan-jurnal-magang.webp"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah tempat magang harus sesuai bidang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya. Kegiatan yang sesuai membantu menerapkan kompetensi dan membuat jurnal lebih relevan."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama magang di Gemilang Training?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durasi program 6 bulan sampai 1 tahun, mengikuti program dan kesepakatan."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana cara mendapat sertifikat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ikuti kegiatan penuh waktu, selesaikan proyek magang, isi jurnal, dan lulus evaluasi mentor."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana jika bidang saya belum tercantum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Konsultasikan dulu melalui WhatsApp resmi."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/Calon-peserta-magang-berdiskusi-dengan-mentor.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Calon peserta magang berdiskusi dengan mentor di Gemilang Training." />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Artikel Pendukung (Support)" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Artikel Pendukung (Support)</span>
            <time datetime={publishIsoDate}>22 November 2026 • 10:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            {pageTitle}
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/Calon-peserta-magang-berdiskusi-dengan-mentor.webp" 
            alt="Calon peserta magang berdiskusi dengan mentor di Gemilang Training." 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Calon peserta magang berdiskusi dengan mentor di Gemilang Training.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
            <span>Daftar Isi Panduan</span>
            <span id="toc-icon" class="text-xs font-bold" style="color: #eab308; font-variant-emoji: text;">▼</span>
          </button>
          <div id="toc-content" class="text-xs text-tc-muted space-y-2 pt-2 border-t border-tc-border/60">
            <ul class="space-y-1.5 list-disc list-inside">
              <li><a href="#empat-hal" class="hover:text-tc-accent transition-colors">1. Empat Hal yang Perlu Dicek</a></li>
              <li><a href="#contoh-gambaran" class="hover:text-tc-accent transition-colors">2. Contoh Gambaran di Gemilang Training</a></li>
              <li><a href="#bukti-diminta" class="hover:text-tc-accent transition-colors">3. Bukti yang Sebaiknya Diminta</a></li>
              <li><a href="#kesalahan-memilih" class="hover:text-tc-accent transition-colors">4. Kesalahan Umum Saat Memilih Tempat Magang</a></li>
              <li><a href="#checklist-memilih" class="hover:text-tc-accent transition-colors">5. Checklist Memilih Tempat Magang</a></li>
              <li><a href="#faq-section" class="hover:text-tc-accent transition-colors">6. Pertanyaan yang Sering Diajukan</a></li>
            </ul>
          </div>
        </div>

        <div class="space-y-8 text-tc-muted text-sm md:text-base leading-relaxed">
          <p>
            <strong>Tempat magang</strong> yang baik memiliki kegiatan yang sesuai bidang, hasil kerja yang jelas, pembimbing yang jelas, serta jurnal dan sertifikat dengan syarat yang transparan. Empat hal ini sebaiknya dicek sebelum Anda menandatangani apa pun.
          </p>
          <p>
            Artikel dari <strong>infomagangmalang.web.id</strong> ini membantu Anda menilai tempat magang di Malang secara praktis, lengkap dengan kesalahan umum dan checklist.
          </p>

          <section id="empat-hal" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Empat Hal yang Perlu Dicek</h2>
            <ol class="list-decimal pl-5 space-y-2">
              <li><strong>Kesesuaian dengan bidang.</strong> Kegiatan harus berkaitan dengan kompetensi yang Anda pelajari.</li>
              <li><strong>Aktivitas dan hasil kerja.</strong> Pilih tempat yang memberi pekerjaan dengan hasil yang bisa ditunjukkan.</li>
              <li><strong>Pembimbing dan penilaian.</strong> Harus jelas siapa pembimbingnya dan bagaimana kegiatan dinilai.</li>
              <li><strong>Jurnal dan sertifikat.</strong> Syarat penerimaan sertifikat harus jelas sejak awal.</li>
            </ol>
          </section>

          <section id="contoh-gambaran" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Contoh Gambaran di Gemilang Training</h2>

            <div class="overflow-x-auto my-6 border border-tc-border rounded-2xl bg-tc-bg">
              <table class="w-full text-left text-xs md:text-sm">
                <thead class="bg-tc-card text-white font-bold border-b border-tc-border">
                  <tr>
                    <th class="p-3">Bidang</th>
                    <th class="p-3 text-tc-accent">Materi dan aktivitas</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-tc-border/60">
                  <tr>
                    <td class="p-3 font-semibold text-white">RPL / web development</td>
                    <td class="p-3 text-tc-accent">HTML, CSS, JavaScript, Front-End, Back-End, Full-Stack, website responsif; tools Git dan GitHub</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">DKV</td>
                    <td class="p-3 text-tc-accent">Desain grafis, UI/UX, branding, aset visual media sosial; tools Figma</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">BDP</td>
                    <td class="p-3 text-tc-accent">Pemasaran digital, social media marketing, e-commerce, periklanan</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">TKJ</td>
                    <td class="p-3 text-tc-accent">Kompetensi teknologi digital, pengelolaan server website dasar, dasar cloud</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-semibold text-white">Multimedia</td>
                    <td class="p-3 text-tc-accent">Content creation, video editing, motion graphics, pemasaran audio-visual</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- Gambar 2 -->
          <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
            <img 
              src="/assets/img/Pengecekan-syarat-program-dan-jurnal-magang.webp" 
              alt="Pengecekan syarat program, jurnal, dan mekanisme penilaian magang di Gemilang Training." 
              class="w-full h-auto max-h-[380px] object-cover"
              loading="lazy"
            />
            <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
              Pengecekan syarat program, jurnal, dan mekanisme penilaian magang di Gemilang Training.
            </figcaption>
          </figure>

          <section id="bukti-diminta" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Bukti yang Sebaiknya Diminta</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Contoh jurnal kegiatan</strong> untuk melihat cara aktivitas dicatat.</li>
              <li><strong>Mekanisme penilaian dari mentor,</strong> termasuk kriterianya.</li>
              <li><strong>Syarat sertifikat secara tertulis.</strong></li>
              <li><strong>Dokumentasi kegiatan nyata,</strong> bukan hanya brosur.</li>
            </ul>
          </section>

          <section id="kesalahan-memilih" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Kesalahan Umum Saat Memilih Tempat Magang</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li>Hanya melihat nama tempat.</li>
              <li>Tidak menanyakan jurnal dan penilaian.</li>
              <li>Menerima sertifikat tanpa tahu syaratnya.</li>
              <li>Memilih bidang yang tidak sesuai kompetensi.</li>
            </ul>
            <p>
              Ingin gambaran bidang tertentu? Baca <a href="/blog/magang-web-development-malang-skill-proyek" class="text-tc-accent underline hover:text-white transition-colors">magang web development di Malang</a> atau <a href="/blog/magang-digital-marketing-malang-skill" class="text-tc-accent underline hover:text-white transition-colors">magang digital marketing di Malang</a>.
            </p>
          </section>

          <!-- BACA JUGA BOX SISIPAN -->
          <div class="my-6">
            <a 
              href="/blog/magang-web-development-malang-skill-proyek" 
              class="block bg-tc-bg hover:bg-tc-card border-l-4 border-tc-accent p-5 rounded-2xl border border-tc-border transition-all shadow-lg group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold text-tc-accent uppercase tracking-wider block mb-1">BACA JUGA ARTIKEL UTAMA</span>
                  <h4 class="text-white font-bold text-sm md:text-base group-hover:text-tc-accent transition-colors">
                    Magang Web Development di Malang: Skill, Proyek, dan Cara Mempersiapkan Diri &rarr;
                  </h4>
                </div>
              </div>
            </a>
          </div>

          <section id="checklist-memilih" class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold text-white">Checklist Memilih Tempat Magang</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li>Kegiatan sesuai bidang</li>
              <li>Materi, tools, dan hasil kerja jelas</li>
              <li>Pembimbing dan penilaian diketahui</li>
              <li>Jurnal dan syarat sertifikat tertulis</li>
              <li>Durasi sudah dicocokkan dengan jadwal</li>
            </ul>
          </section>
        </div>

        <!-- KOTAK AUTHOR (PENULIS) -->
        <div class="my-8 p-6 bg-tc-bg border border-tc-border rounded-2xl flex flex-col sm:flex-row items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold text-xl shrink-0">
            GT
          </div>
          <div class="space-y-1 text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start gap-2">
              <h4 class="text-white font-bold text-base">{authorName}</h4>
              <span class="bg-tc-accent/20 text-tc-accent text-[10px] font-semibold px-2 py-0.5 rounded-full border border-tc-accent/40">Verified Author</span>
            </div>
            <p class="text-tc-muted text-xs leading-relaxed">
              Tim redaksi Gemilang Training Malang untuk panduan seleksi tempat magang dan kesesuaian bidang praktik.
            </p>
          </div>
        </div>

        <!-- CTA PROMO WHATSAPP -->
        <div class="bg-gradient-to-r from-tc-bg to-tc-card border border-tc-accent/50 rounded-3xl p-6 md:p-8 text-center space-y-4 shadow-2xl">
          <h3 class="text-xl font-bold text-white">Cek Program Magang Sekarang</h3>
          <p class="text-tc-muted text-xs md:text-sm max-w-lg mx-auto">
            Lihat program dan persyaratan pendaftaran Gemilang Training, lalu pilih bidang yang paling sesuai.
          </p>
          <a 
            href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20konsultasi%20memilih%20tempat%20magang%20di%20Malang." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-6 py-3 rounded-xl transition-all shadow-lg text-xs md:text-sm"
          >
            <span>Konsultasi via WA</span>
          </a>
        </div>

        <!-- FAQ ACCORDION SECTION -->
        <section id="faq-section" class="border-t border-tc-border pt-8 space-y-4">
          <h3 class="text-xl font-bold text-white">Pertanyaan yang Sering Diajukan</h3>
          <div class="space-y-3">
            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Apakah tempat magang harus sesuai bidang?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Ya. Kegiatan yang sesuai membantu menerapkan kompetensi dan membuat jurnal lebih relevan.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Berapa lama magang di Gemilang Training?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Durasi program 6 bulan sampai 1 tahun, mengikuti program dan kesepakatan.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Bagaimana cara mendapat sertifikat?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Ikuti kegiatan penuh waktu, selesaikan proyek magang, isi jurnal, dan lulus evaluasi mentor.
              </p>
            </details>

            <details class="bg-tc-bg p-4 rounded-xl border border-tc-border group cursor-pointer">
              <summary class="text-xs md:text-sm font-semibold text-white flex justify-between items-center list-none select-none">
                <span>Bagaimana jika bidang saya belum tercantum?</span>
                <span class="text-tc-accent text-xs group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-tc-muted text-xs mt-2 border-t border-tc-border/40 pt-2 leading-relaxed">
                Konsultasikan dulu melalui WhatsApp resmi.
              </p>
            </details>
          </div>
        </section>

      </article>

      <!-- SIDEBAR (KANAN) -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-24 space-y-6">
          
          <!-- Box Fast Contact -->
          <div class="bg-tc-card p-6 rounded-3xl border border-tc-border space-y-4 shadow-xl">
            <h4 class="text-white font-bold text-base">Konsultasi Pilihan Magang</h4>
            <p class="text-tc-muted text-xs leading-relaxed">
              Diskusikan kesesuaian bidang, jurnal, syarat sertifikat, dan durasi magang di Malang.
            </p>
            <a 
              href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20konsultasi%20memilih%20tempat%20magang%20di%20Malang." 
              target="_blank" 
              rel="noopener noreferrer"
              class="block text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold py-2.5 rounded-xl text-xs transition-all"
            >
              Chat WA: +62 819-4343-1484
            </a>
          </div>

          <!-- Card Artikel Rekomendasi (Saling Terhubung dengan Artikel 1 & 2) -->
          <div class="bg-tc-card p-6 rounded-3xl border border-tc-border space-y-4 shadow-xl">
            <h4 class="text-white font-bold text-base border-b border-tc-border pb-3">Artikel Rekomendasi</h4>
            
            <div class="space-y-4">
              <div class="space-y-2 group">
                <img src="/assets/img/Peserta-magang-mengerjakan-proyek-website-responsif.webp" alt="Peserta magang mengerjakan proyek website responsif di Gemilang Training." class="w-full h-28 object-cover rounded-xl border border-tc-border" />
                <span class="text-[10px] font-mono text-tc-accent uppercase">Artikel Utama (Pillar)</span>
                <h5 class="text-xs font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
                  <a href="/blog/magang-web-development-malang-skill-proyek">
                    Magang Web Development di Malang: Skill, Proyek, dan Cara Mempersiapkan Diri
                  </a>
                </h5>
              </div>

              <div class="space-y-2 group">
                <img src="/assets/img/Peserta-magang-menyusun-rencana-konten-media-sosial.webp" alt="Peserta magang menyusun rencana konten media sosial di Gemilang Training." class="w-full h-28 object-cover rounded-xl border border-tc-border" />
                <span class="text-[10px] font-mono text-tc-accent uppercase">Artikel Pendukung (Support)</span>
                <h5 class="text-xs font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
                  <a href="/blog/magang-digital-marketing-malang-skill">
                    Magang Digital Marketing di Malang: Apa yang Dikerjakan dan Skill yang Dibutuhkan
                  </a>
                </h5>
              </div>
            </div>
          </div>

        </div>
      </aside>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const tocToggle = document.getElementById('toc-toggle');
  const tocContent = document.getElementById('toc-content');
  const tocIcon = document.getElementById('toc-icon');

  if (tocToggle && tocContent) {
    tocToggle.addEventListener('click', () => {
      if (tocContent.style.display === 'none') {
        tocContent.style.display = 'block';
        if (tocIcon) {
          tocIcon.textContent = '▼';
          tocIcon.style.color = '#eab308';
        }
      } else {
        tocContent.style.display = 'none';
        if (tocIcon) {
          tocIcon.textContent = '▸';
          tocIcon.style.color = '#eab308';
        }
      }
    });
  }
</script>