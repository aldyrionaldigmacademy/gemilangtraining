---
// src/pages/blog/ciri-tawaran-magang-perlu-diwaspadai.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Ciri Tawaran Magang Mencurigakan dan Cara Cek";
const pageDesc = "Kenali ciri tawaran magang yang mencurigakan dan cara cek tempat magang terpercaya sebelum daftar. Simak langkah verifikasi dan lindungi data Anda sekarang.";
const publishDate = "2026-11-22";
const publishIsoDate = "2026-11-22T12:00:00+07:00";
const pageSlug = "/ciri-tawaran-magang-perlu-diwaspadai";
const pageUrl = `https://infomagangmalang.web.id${pageSlug}`;
const ogImageUrl = "https://infomagangmalang.web.id/assets/img/ciri-tawaran-magang-perlu-diwaspadai-1.webp";
const secondImageUrl = "https://infomagangmalang.web.id/assets/img/ciri-tawaran-magang-perlu-diwaspadai-2.webp";
const authorName = "Tim Redaksi Gemilang Training";
const keywordsList = "ciri tawaran magang mencurigakan, cara cek tempat magang terpercaya, penipuan lowongan magang, verifikasi tempat magang, Gemilang Training Malang";

const schemaArticle = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${pageUrl}#article`,
      "isPartOf": { "@id": pageUrl },
      "headline": pageTitle,
      "description": pageDesc,
      "keywords": keywordsList,
      "inLanguage": "id-ID",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": pageUrl
      },
      "datePublished": publishIsoDate,
      "dateModified": publishIsoDate,
      "author": {
        "@type": "Organization",
        "name": authorName
      },
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Gemilang Training",
        "url": "https://infomagangmalang.web.id",
        "logo": {
          "@type": "ImageObject",
          "url": "https://infomagangmalang.web.id/assets/img/beranda1.webp"
        }
      },
      "image": [
        ogImageUrl,
        secondImageUrl
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah magang yang meminta biaya pendaftaran pasti penipuan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Permintaan biaya pendaftaran adalah tanda bahaya yang kuat dan sebaiknya ditolak. Konfirmasi dulu ke kampus atau sekolah, karena penyelenggara magang yang terpercaya umumnya tidak memungut biaya dari peserta."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah tawaran magang lewat WhatsApp pasti palsu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tidak pasti palsu, tetapi perlu diverifikasi lebih ketat. Cocokkan identitas penyelenggara di situs resmi dan hubungi mereka lewat kanal yang Anda temukan sendiri."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana jika perusahaan terkenal mengirim tawaran magang lewat email gratis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Anggap mencurigakan sampai terkonfirmasi. Pelaku penipuan sering memakai nama perusahaan besar, sehingga cek ulang melalui situs karier resmi perusahaan tersebut."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={keywordsList}
  image="/assets/img/ciri-tawaran-magang-perlu-diwaspadai-1.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content="Mahasiswa memeriksa tawaran magang mencurigakan di ponsel" />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishIsoDate} />
    <meta property="article:modified_time" content={publishIsoDate} />
    <meta property="article:section" content="Cluster 1" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
  </head>

  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- KONTEN UTAMA (KIRI) -->
      <article class="lg:col-span-8 bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border space-y-8 shadow-xl">
        
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-tc-muted">
            <span class="bg-tc-accent text-slate-950 font-bold px-3 py-1 rounded-full uppercase">Cluster 1</span>
            <time datetime={publishIsoDate}>22 November 2026 • 12:00 WIB</time>
            <span>•</span>
            <span>Oleh {authorName}</span>
          </div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-tight">
            {pageTitle}
          </h1>
          <p class="text-tc-muted text-sm md:text-base leading-relaxed">
            {pageDesc}
          </p>
        </header>

        <!-- Gambar 1 -->
        <figure class="rounded-2xl overflow-hidden border border-tc-border bg-tc-bg">
          <img 
            src="/assets/img/ciri-tawaran-magang-perlu-diwaspadai-2.webp" 
            alt="Mahasiswa memeriksa tawaran magang mencurigakan di ponsel" 
            class="w-full h-auto max-h-[420px] object-cover"
            loading="eager"
          />
          <figcaption class="text-center text-tc-muted text-xs p-2.5 bg-tc-bg/80 border-t border-tc-border">
            Mahasiswa memeriksa tawaran magang mencurigakan di ponsel.
          </figcaption>
        </figure>

        <!-- TOC -->
        <div class="bg-tc-bg p-5 rounded-2xl border border-tc-border space-y-3">
          <button type="button" id="toc-toggle" class="w-full flex justify-between items-center text-tc-accent font-bold text-sm cursor-pointer">
