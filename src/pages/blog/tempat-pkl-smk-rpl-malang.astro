---

<BaseLayout 
  title={pageTitle} 
  description={pageDesc} 
  image="/assets/img/tempat-pkl-smk-rpl-malang.webp"
  type="article"
  isHome={false}
>
  <Navbar slot="header" />

  <head slot="head">
    <meta name="keywords" content="tempat pkl smk rpl malang, pkl rpl malang, prakerin smk rpl malang, tugas pkl rpl, syarat daftar pkl smk rpl, gemilang training malang" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:type" content="article" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>

  <article class="py-10 md:py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- BREADCRUMB -->
    <nav class="text-xs text-tc-muted mb-6 flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-tc-accent transition-colors">Beranda</a>
      <span>/</span>
