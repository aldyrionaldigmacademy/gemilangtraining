<script>
  function setupAlurFilter() {
    const btns = document.querySelectorAll('.jalur-btn');
    const panelMahasiswa = document.getElementById('panel-mahasiswa');
    const panelSmk = document.getElementById('panel-smk');
    const panelPariwisata = document.getElementById('panel-pariwisata');
    const heading = document.getElementById('alur-heading');
    const subdesc = document.getElementById('alur-subdesc');
    const waBtn = document.getElementById('sidebar-wa-btn') as HTMLAnchorElement | null;

    if (!btns.length || !panelMahasiswa || !panelSmk || !panelPariwisata) return;

    const switchJalur = (jalur: string, updateUrl = false) => {
      const activeJalur = jalur === 'smk' ? 'smk' : jalur === 'pariwisata' ? 'pariwisata' : 'mahasiswa';

      btns.forEach((b) => {
        const isTarget = b.getAttribute('data-jalur-btn') === activeJalur;
        if (isTarget) {
          b.classList.add('bg-tc-accent', 'text-slate-950', 'font-bold');
          b.classList.remove('text-tc-muted', 'font-semibold');
        } else {
          b.classList.remove('bg-tc-accent', 'text-slate-950', 'font-bold');
          b.classList.add('text-tc-muted', 'font-semibold');
        }
      });

      panelMahasiswa.classList.add('hidden');
      panelSmk.classList.add('hidden');
      panelPariwisata.classList.add('hidden');

      if (activeJalur === 'smk') {
        panelSmk.classList.remove('hidden');
        if (heading) heading.textContent = 'Tahapan Pendaftaran PKL Siswa SMK';
        if (subdesc) {
          subdesc.textContent =
            'Panduan lengkap pengajuan PKL bagi siswa SMK (RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, & Multimedia) mulai dari surat permohonan sekolah hingga sertifikat kelulusan.';
        }
        if (waBtn) {
          waBtn.href =
            'https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20sudah%20membaca%20alur%20pendaftaran%20dan%20ingin%20mendaftar%20PKL%20Siswa%20SMK.';
        }
      } else if (activeJalur === 'pariwisata') {
        panelPariwisata.classList.remove('hidden');
        if (heading) heading.textContent = 'Tahapan Pendaftaran Magang & PKL Pariwisata';
        if (subdesc) {
          subdesc.textContent =
            'Panduan lengkap pengajuan magang & PKL jurusan MBP (Manajemen Bisnis Pariwisata), DEP (Destinasi Pariwisata), Pariwisata, serta SMK Jurusan Pariwisata dengan penempatan di Katun Outbound Malang.';
        }
        if (waBtn) {
          waBtn.href =
            'https://wa.me/6281943431484?text=Halo%20Admin%2C%20saya%20sudah%20membaca%20alur%20pendaftaran%20dan%20ingin%20mendaftar%20Magang%20%2F%20PKL%20Pariwisata%20(Katun%20Outbound%20Malang).';
        }
      } else {
        panelMahasiswa.classList.remove('hidden');
        if (heading) heading.textContent = 'Tahapan Pendaftaran Magang Mahasiswa';
        if (subdesc) {
          subdesc.textContent =
            'Panduan lengkap pengajuan magang bagi mahasiswa jurusan Informatika (D3/D4/S1) mulai dari surat pengantar kampus hingga konversi nilai dan sertifikat.';
        }
        if (waBtn) {
          waBtn.href =
            'https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20sudah%20membaca%20alur%20pendaftaran%20dan%20ingin%20mendaftar%20Magang%20Mahasiswa.';
        }
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('jalur', activeJalur);
        window.history.replaceState({}, '', url.toString());
      }
    };

    // Cek parameter URL saat halaman dibuka (?jalur=smk, ?jalur=pariwisata, atau ?jalur=mahasiswa)
    const params = new URLSearchParams(window.location.search);
    const initialJalur = params.get('jalur') || 'mahasiswa';
    switchJalur(initialJalur, false);

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-jalur-btn') || 'mahasiswa';
        switchJalur(selected, true);
      });
    });
  }

  setupAlurFilter();
  document.addEventListener('astro:page-load', setupAlurFilter);
</script>