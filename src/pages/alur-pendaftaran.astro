---
// src/pages/alur-pendaftaran.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const alurMahasiswa = [
  {
    step: "1",
    badge: "TAHAP 1",
    target: "Magang Mahasiswa",
    title: "Cek Persyaratan & Pilih Fokus Keahlian",
    desc: "Mahasiswa jurusan Informatika (D3/D4/S1) meninjau ketentuan durasi magang (3–6 bulan) serta menentukan minat proyek utama antara Pengembangan Website (Astro, Bootstrap, Blogspot) atau Optimasi SEO & Konten.",
    pic: "Calon Peserta Mahasiswa",
    estimasi: "1 - 2 Hari",
    note: "Pastikan periode tanggal magang sudah sesuai dengan jadwal KRS/kalender akademik kampus."
  },
  {
    step: "2",
    badge: "TAHAP 2",
    target: "Magang Mahasiswa",
    title: "Siapkan CV & Surat Pengantar Kampus",
    desc: "Lengkapi berkas administrasi berupa CV singkat, tautan portofolio/GitHub (jika ada), serta Surat Pengantar Resmi Magang yang ditandatangani oleh Ketua Program Studi / Dekan / bagian akademik kampus.",
    pic: "Mahasiswa & Pihak Kampus",
    estimasi: "2 - 5 Hari Kerja",
    note: "Surat pengantar wajib mencantumkan NIM, program studi, jumlah mahasiswa, dan tanggal mulai magang."
  },
  {
    step: "3",
    badge: "TAHAP 3",
    target: "Magang Mahasiswa",
    title: "Pengajuan Berkas & Konsultasi Kuota via WA",
    desc: "Kirimkan salinan PDF surat pengantar kampus dan CV melalui WhatsApp Admin Gemilang Training untuk pengecekan kuota bimbingan serta konfirmasi jadwal wawancara.",
    pic: "Mahasiswa & Admin",
    estimasi: "15 - 30 Menit",
    note: "Pengajuan dapat dilakukan secara individu maupun kelompok dalam satu surat pengantar."
  },
  {
    step: "4",
    badge: "TAHAP 4",
    target: "Magang Mahasiswa",
    title: "Wawancara Singkat & Skill Mapping",
    desc: "Sesi diskusi santai (online via Google Meet atau datang langsung ke Malang) bersama mentor praktisi untuk memetakan kemampuan teknis awal dan target luaran proyek.",
    pic: "Mentor Gemilang Training",
    estimasi: "1 - 2 Hari Kerja",
    note: null
  },
  {
    step: "5",
    badge: "TAHAP 5",
    target: "Magang Mahasiswa",
    title: "Penerbitan Surat Balasan Penerimaan Magang",
    desc: "Setelah berkas dan hasil pemetaan disetujui, Gemilang Training menerbitkan Surat Balasan Resmi Penerimaan Magang untuk diserahkan mahasiswa ke bagian akademik kampus.",
    pic: "Admin Gemilang Training",
    estimasi: "1 - 2 Hari Kerja",
    note: "Simpan salinan surat balasan resmi sebagai syarat pemberkasan magang di kampus."
  },
  {
    step: "6",
    badge: "TAHAP 6",
    target: "Magang Mahasiswa",
    title: "Konfirmasi Jadwal Masuk & Logbook Kampus",
    desc: "Mahasiswa melakukan konfirmasi kehadiran hari pertama serta menyepakati tata tertib kerja, pembagian jadwal bimbingan mingguan, dan format pengisian logbook harian kampus.",
    pic: "Mahasiswa & Pembimbing Lapangan",
    estimasi: "H-2 Sebelum Mulai",
    note: null
  },
  {
    step: "7",
    badge: "TAHAP 7",
    target: "Magang Mahasiswa",
    title: "Onboarding & Setup Proyek Website",
    desc: "Mulai masuk hari pertama dengan membawa laptop pribadi, setup lingkungan kerja (VS Code, Git, browser tools), dan mulai mengerjakan proyek website Astro, Bootstrap, atau optimasi SEO.",
    pic: "Mahasiswa & Mentor Praktisi",
    estimasi: "Hari Pertama Magang",
    note: null
  },
  {
    step: "8",
    badge: "TAHAP 8",
    target: "Magang Mahasiswa",
    title: "Evaluasi Akhir, Penilaian Kampus & Sertifikat",
    desc: "Di akhir periode magang, mentor mengecek hasil karya website/artikel yang sudah live, mengisi lembar penilaian magang dari kampus, dan menerbitkan Sertifikat Resmi Kelulusan Magang.",
    pic: "Mahasiswa, Mentor & Dosen Pembimbing",
    estimasi: "3 - 6 Bulan (Sesuai Periode)",
    note: "Sertifikat dan portofolio proyek siap digunakan untuk laporan akhir maupun melamar kerja."
  }
];

const alurSmk = [
  {
    step: "1",
    badge: "TAHAP 1",
    target: "PKL Siswa SMK",
    title: "Cek Kuota Jurusan & Periode PKL Sekolah",
    desc: "Siswa atau guru pembimbing meninjau kesesuaian jurusan SMK (RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, atau Multimedia) dan jadwal gelombang PKL dari sekolah.",
    pic: "Siswa SMK / Guru Pembimbing",
    estimasi: "1 - 2 Hari",
    note: "Pengajuan PKL dapat dilakukan per individu maupun berkelompok (1 tim berisi 2–5 siswa)."
  },
  {
    step: "2",
    badge: "TAHAP 2",
    target: "PKL Siswa SMK",
    title: "Siapkan Surat Permohonan PKL dari Sekolah",
    desc: "Mengurus Surat Permohonan Resmi PKL yang ditandatangani oleh Kepala Sekolah / Kaprog / Pokja PKL, dilampiri biodata singkat masing-masing siswa yang diajukan.",
    pic: "Siswa & Pokja PKL Sekolah",
    estimasi: "2 - 5 Hari Kerja",
    note: "Pastikan surat mencantumkan nama lengkap siswa, NIS/NISN, kompetensi keahlian, dan durasi PKL."
  },
  {
    step: "3",
    badge: "TAHAP 3",
    target: "PKL Siswa SMK",
    title: "Kirim Surat Permohonan via WhatsApp Admin",
    desc: "Mengirimkan foto/scan PDF surat permohonan PKL dari sekolah melalui WhatsApp Admin Gemilang Training untuk konfirmasi ketersediaan kuota tempat PKL.",
    pic: "Siswa / Guru & Admin",
    estimasi: "15 - 30 Menit",
    note: "Disarankan mengajukan maksimal 2–4 minggu sebelum tanggal penerjunan PKL."
  },
  {
    step: "4",
    badge: "TAHAP 4",
    target: "PKL Siswa SMK",
    title: "Perkenalan Singkat & Pembagian Kelompok",
    desc: "Sesi obrolan ringan bersama mentor untuk mengetahui minat siswa serta pembagian tim kolaborasi antara jurusan teknis (RPL/TKJ) dan jurusan bisnis/kreatif (Marketing/DKV/MM).",
    pic: "Mentor Gemilang Training",
    estimasi: "1 - 2 Hari Kerja",
    note: "Tidak wajib sudah mahir koding atau SEO, materi diajarkan bertahap dari dasar."
  },
  {
    step: "5",
    badge: "TAHAP 5",
    target: "PKL Siswa SMK",
    title: "Penerbitan Surat Balasan Kesediaan PKL",
    desc: "Gemilang Training menerbitkan Surat Balasan Resmi Kesediaan Menerima Siswa PKL untuk diserahkan kembali ke bagian Pokja PKL / Tata Usaha sekolah.",
    pic: "Admin Gemilang Training",
    estimasi: "1 - 2 Hari Kerja",
    note: "Surat balasan menjadi dasar resmi penerjunan siswa PKL oleh pihak sekolah."
  },
  {
    step: "6",
    badge: "TAHAP 6",
    target: "PKL Siswa SMK",
    title: "Persiapan Perangkat Laptop & Buku Jurnal PKL",
    desc: "Siswa menyiapkan laptop pribadi yang akan dibawa selama masa PKL serta buku jurnal kegiatan harian / absensi PKL dari sekolah.",
    pic: "Siswa SMK",
    estimasi: "H-2 Sebelum Mulai",
    note: null
  },
  {
    step: "7",
    badge: "TAHAP 7",
    target: "PKL Siswa SMK",
    title: "Penerjunan, Pengarahan & Mulai Praktik",
    desc: "Hari pertama masuk PKL (bisa diantar guru pembimbing sekolah), pengenalan aturan kerja, instalasi aplikasi pendukung, dan mulai belajar membuat website (Bootstrap, Astro, Blogspot) serta artikel SEO.",
    pic: "Siswa, Guru Pembimbing & Mentor",
    estimasi: "Hari Pertama PKL",
    note: null
  },
  {
    step: "8",
    badge: "TAHAP 8",
    target: "PKL Siswa SMK",
    title: "Monitoring Berkala, Penilaian & Sertifikat PKL",
    desc: "Evaluasi proyek mingguan, pendampingan saat guru sekolah melakukan kunjungan monitoring, pengisian nilai akhir PKL pada rapor/lembar sekolah, serta penerbitan Sertifikat Resmi PKL.",
    pic: "Siswa, Mentor & Guru Pembimbing",
    estimasi: "3 - 6 Bulan (Sesuai Periode)",
    note: "Setiap siswa lulus PKL dengan membawa portofolio website online dan sertifikat resmi."
  }
];

const alurPariwisata = [
  {
    step: "1",
    badge: "TAHAP 1",
    target: "Magang & PKL Pariwisata",
    title: "Cek Kesesuaian Jurusan & Kuota Katun Outbound Malang",
    desc: "Mahasiswa jurusan MBP (Manajemen Bisnis Pariwisata), DEP (Destinasi Pariwisata), Pariwisata, maupun siswa SMK (Sekolah Menengah Kejuruan) Jurusan Pariwisata mengecek ketersediaan kuota dan periode program (3 – 6 bulan) dengan penempatan di Katun Outbound Malang.",
    pic: "Calon Peserta / Pihak Kampus & Sekolah",
    estimasi: "1 - 2 Hari",
    note: "Tentukan rencana tanggal mulai dan durasi program sesuai jadwal akademik kampus atau sekolah."
  },
  {
    step: "2",
    badge: "TAHAP 2",
    target: "Magang & PKL Pariwisata",
    title: "Siapkan Surat Pengantar / Permohonan Magang atau PKL",
    desc: "Mengurus surat permohonan resmi magang mahasiswa atau PKL (Praktik Kerja Lapangan) siswa SMK dari program studi, fakultas, maupun sekolah yang mencantumkan data peserta dan durasi praktik.",
    pic: "Peserta & Bagian Akademik Kampus / Sekolah",
    estimasi: "2 - 5 Hari Kerja",
    note: "Pengajuan dapat dilakukan secara individu maupun berkelompok dalam satu surat pengantar."
  },
  {
    step: "3",
    badge: "TAHAP 3",
    target: "Magang & PKL Pariwisata",
    title: "Kirim Berkas & Konfirmasi Jadwal via WhatsApp Admin",
    desc: "Mengirimkan salinan PDF surat pengantar kampus/sekolah dan biodata singkat melalui WhatsApp Admin untuk pengecekan kuota penempatan di Katun Outbound Malang.",
    pic: "Peserta & Admin",
    estimasi: "15 - 30 Menit",
    note: "Sertakan keterangan jurusan (MBP / DEP / Pariwisata) dan jumlah peserta yang diajukan."
  },
  {
    step: "4",
    badge: "TAHAP 4",
    target: "Magang & PKL Pariwisata",
    title: "Penerbitan Surat Balasan Resmi Kampus / Sekolah",
    desc: "Setelah kuota dan jadwal disepakati, admin menerbitkan Surat Balasan Resmi Penerimaan Magang / PKL untuk diserahkan peserta kepada pihak kampus atau sekolah sebagai syarat administrasi akademik.",
    pic: "Admin & Peserta",
    estimasi: "1 - 2 Hari Kerja",
    note: "Simpan salinan surat balasan resmi untuk arsip prodi, fakultas, atau Pokja PKL sekolah."
  },
  {
    step: "5",
    badge: "TAHAP 5",
    target: "Magang & PKL Pariwisata",
    title: "Briefing Awal, Grooming & Pemetaan Penempatan",
    desc: "Sesi pengarahan awal mengenai tata tertib lapangan, standar penampilan (grooming), sapaan tamu (greeting), etika komunikasi, serta pembagian jadwal kegiatan di Katun Outbound Malang.",
    pic: "Koordinator Lapangan & Peserta",
    estimasi: "1 - 2 Hari Kerja",
    note: "Kedisiplinan waktu dan kesiapan fisik/komunikasi menjadi poin penting sebelum turun lapangan."
  },
  {
    step: "6",
    badge: "TAHAP 6",
    target: "Magang & PKL Pariwisata",
    title: "Orientasi Lapangan & Pengenalan SOP (Standard Operating Procedure)",
    desc: "Peserta mulai masuk hari pertama untuk mengenal alur operasional kegiatan outbound, wisata, dan event, termasuk standar pelayanan tamu serta keamanan kegiatan lapangan.",
    pic: "Peserta & Tim Lapangan Katun Outbound",
    estimasi: "Minggu Pertama",
    note: null
  },
  {
    step: "7",
    badge: "TAHAP 7",
    target: "Magang & PKL Pariwisata",
    title: "Praktik 5 Bidang Utama Pariwisata di Lapangan",
    desc: "Peserta terjun langsung mempraktikkan peran di Bagian Bisnis EO (Event Organizer), LO (Leader Organizer), PIC (Person In Charge) Kegiatan Outbound, Tour Guide (Pemandu Wisata), dan Tour Leader (Pemimpin Rombongan Wisata).",
    pic: "Peserta & Pembimbing Lapangan",
    estimasi: "Selama Masa Praktik",
    note: "Jadwal dan pembagian peran menyesuaikan agenda kegiatan event, gathering, dan perjalanan wisata."
  },
  {
    step: "8",
    badge: "TAHAP 8",
    target: "Magang & PKL Pariwisata",
    title: "Monitoring, Penilaian Akhir & Penerbitan Sertifikat",
    desc: "Evaluasi performa lapangan secara berkala, pendampingan monitoring dosen/guru pembimbing, pengisian jurnal/logbook dan lembar nilai kampus/sekolah, serta penerbitan Sertifikat Selesai Magang / PKL.",
    pic: "Peserta, Pembimbing Lapangan & Dosen/Guru",
    estimasi: "3 - 6 Bulan (Sesuai Periode)",
    note: "Menjadi bukti pengalaman kerja nyata di industri pariwisata, event organizer, dan outbound."
  }
];
---

<BaseLayout 
  title="Alur & Prosedur Pendaftaran Magang Mahasiswa, PKL SMK & Pariwisata - Gemilang Training Malang" 
  description="Panduan lengkap 8 tahapan pendaftaran Magang Mahasiswa Informatika, PKL Siswa SMK, dan Magang/PKL Pariwisata (Katun Outbound Malang) mulai dari persiapan berkas hingga penerbitan sertifikat resmi."
  keywords="alur pendaftaran magang malang, cara daftar pkl smk malang, magang pariwisata malang, katun outbound malang, syarat magang mahasiswa malang, surat balasan kampus malang"
  isHome={false}
>
  <Navbar slot="header" />

  <!-- 1. HERO HEADER BANNER -->
  <section class="relative bg-tc-card/80 border-b border-tc-border overflow-hidden">
    <div class="absolute inset-0 opacity-15">
      <img src="/assets/img/beranda1.webp" alt="Alur Pendaftaran Magang dan PKL Gemilang Training" class="w-full h-full object-cover" />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 text-center">
      <span class="inline-block text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-bg/90 px-4 py-1.5 rounded-full border border-tc-border mb-4">
        Prosedur Resmi Magang & PKL
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 leading-tight">
        Alur & Prosedur <span class="text-tc-accent">Pendaftaran</span>
      </h1>
      <p class="text-tc-muted text-sm md:text-lg max-w-2xl mx-auto leading-relaxed">
        Pilih jalur pendaftaran di bawah ini untuk melihat langkah-langkah terstruktur dari persiapan berkas, surat balasan kampus/sekolah, hingga penerbitan sertifikat resmi.
      </p>
    </div>
  </section>

  <!-- 2. MAIN CONTENT (2 KOLOM: FILTER + TIMELINE KIRI & STICKY SIDEBAR KANAN) -->
  <section class="py-14 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- KOLOM KIRI (8 Kolom) -->
      <div class="lg:col-span-8">
        
        <!-- Header & Filter Tabs Jalur -->
        <div class="mb-8">
          <span class="text-xs font-semibold text-tc-accent uppercase tracking-wider block mb-2">
            Pilih Jalur Pendidikan
          </span>
          <h2 id="alur-heading" class="text-2xl md:text-3xl font-bold text-white mb-3">
            Tahapan Pendaftaran Magang Mahasiswa
          </h2>
          <p id="alur-subdesc" class="text-tc-muted text-sm md:text-base leading-relaxed mb-6">
            Panduan lengkap pengajuan magang bagi mahasiswa jurusan Informatika (D3/D4/S1) mulai dari surat pengantar kampus hingga konversi nilai dan sertifikat.
          </p>

          <!-- Tombol Filter Jalur -->
          <div class="inline-flex flex-wrap gap-2.5 p-1.5 bg-tc-card rounded-2xl border border-tc-border">
            <button 
              type="button"
              data-jalur-btn="mahasiswa"
              class="jalur-btn px-5 py-2.5 rounded-xl text-xs md:text-sm font-bold bg-tc-accent text-slate-950 transition-all cursor-pointer"
            >
              Alur Magang Mahasiswa
            </button>
            <button 
              type="button"
              data-jalur-btn="smk"
              class="jalur-btn px-5 py-2.5 rounded-xl text-xs md:text-sm font-semibold text-tc-muted hover:text-white transition-all cursor-pointer"
            >
              Alur PKL Siswa SMK
            </button>
            <button 
              type="button"
              data-jalur-btn="pariwisata"
              class="jalur-btn px-5 py-2.5 rounded-xl text-xs md:text-sm font-semibold text-tc-muted hover:text-white transition-all cursor-pointer"
            >
              Alur Magang & PKL Pariwisata
            </button>
          </div>
        </div>

        <!-- PANEL 1: TIMELINE MAGANG MAHASISWA -->
        <div id="panel-mahasiswa" class="alur-panel space-y-6 relative before:absolute before:left-5 before:top-4 before:bottom-4 before:w-0.5 before:bg-tc-border">
          {alurMahasiswa.map((item) => (
            <div class="relative pl-14">
              <div class="absolute left-0 top-1 w-10 h-10 rounded-full bg-tc-accent text-slate-950 font-extrabold text-sm flex items-center justify-center shadow-lg">
                {item.step}
              </div>

              <div class="bg-tc-card p-6 md:p-7 rounded-2xl border border-tc-border hover:border-tc-accent/70 transition-all shadow-lg">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                  <span class="text-[11px] font-mono text-tc-muted uppercase tracking-wider font-semibold">
                    {item.badge}
                  </span>
                  <span class="text-[11px] font-semibold text-tc-accent bg-tc-bg border border-tc-border px-2.5 py-0.5 rounded-full">
                    {item.target}
                  </span>
                </div>

                <h3 class="text-lg md:text-xl font-bold text-white mb-2.5">
                  {item.title}
                </h3>
                <p class="text-tc-muted text-sm leading-relaxed mb-4">
                  {item.desc}
                </p>

                <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs pt-3 border-t border-tc-border/60">
                  <div>
                    <span class="text-tc-muted">Penanggung Jawab: </span>
                    <span class="text-white font-semibold">{item.pic}</span>
                  </div>
                  <div>
                    <span class="text-tc-muted">Estimasi Waktu: </span>
                    <span class="text-tc-accent font-semibold">{item.estimasi}</span>
                  </div>
                </div>

                {item.note && (
                  <div class="mt-4 bg-tc-bg/90 border border-tc-border rounded-xl px-4 py-2.5 text-xs flex items-start gap-2.5">
                    <span class="text-tc-accent font-bold shrink-0">ⓘ</span>
                    <span class="text-tc-muted leading-relaxed">{item.note}</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- PANEL 2: TIMELINE PKL SISWA SMK -->
        <div id="panel-smk" class="alur-panel hidden space-y-6 relative before:absolute before:left-5 before:top-4 before:bottom-4 before:w-0.5 before:bg-tc-border">
          {alurSmk.map((item) => (
            <div class="relative pl-14">
              <div class="absolute left-0 top-1 w-10 h-10 rounded-full bg-tc-accent text-slate-950 font-extrabold text-sm flex items-center justify-center shadow-lg">
                {item.step}
              </div>

              <div class="bg-tc-card p-6 md:p-7 rounded-2xl border border-tc-border hover:border-tc-accent/70 transition-all shadow-lg">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                  <span class="text-[11px] font-mono text-tc-muted uppercase tracking-wider font-semibold">
                    {item.badge}
                  </span>
                  <span class="text-[11px] font-semibold text-tc-accent bg-tc-bg border border-tc-border px-2.5 py-0.5 rounded-full">
                    {item.target}
                  </span>
                </div>

                <h3 class="text-lg md:text-xl font-bold text-white mb-2.5">
                  {item.title}
                </h3>
                <p class="text-tc-muted text-sm leading-relaxed mb-4">
                  {item.desc}
                </p>

                <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs pt-3 border-t border-tc-border/60">
                  <div>
                    <span class="text-tc-muted">Penanggung Jawab: </span>
                    <span class="text-white font-semibold">{item.pic}</span>
                  </div>
                  <div>
                    <span class="text-tc-muted">Estimasi Waktu: </span>
                    <span class="text-tc-accent font-semibold">{item.estimasi}</span>
                  </div>
                </div>

                {item.note && (
                  <div class="mt-4 bg-tc-bg/90 border border-tc-border rounded-xl px-4 py-2.5 text-xs flex items-start gap-2.5">
                    <span class="text-tc-accent font-bold shrink-0">ⓘ</span>
                    <span class="text-tc-muted leading-relaxed">{item.note}</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- PANEL 3: TIMELINE MAGANG & PKL PARIWISATA -->
        <div id="panel-pariwisata" class="alur-panel hidden space-y-6 relative before:absolute before:left-5 before:top-4 before:bottom-4 before:w-0.5 before:bg-tc-border">
          {alurPariwisata.map((item) => (
            <div class="relative pl-14">
              <div class="absolute left-0 top-1 w-10 h-10 rounded-full bg-tc-accent text-slate-950 font-extrabold text-sm flex items-center justify-center shadow-lg">
                {item.step}
              </div>

              <div class="bg-tc-card p-6 md:p-7 rounded-2xl border border-tc-border hover:border-tc-accent/70 transition-all shadow-lg">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
                  <span class="text-[11px] font-mono text-tc-muted uppercase tracking-wider font-semibold">
                    {item.badge}
                  </span>
                  <span class="text-[11px] font-semibold text-tc-accent bg-tc-bg border border-tc-border px-2.5 py-0.5 rounded-full">
                    {item.target}
                  </span>
                </div>

                <h3 class="text-lg md:text-xl font-bold text-white mb-2.5">
                  {item.title}
                </h3>
                <p class="text-tc-muted text-sm leading-relaxed mb-4">
                  {item.desc}
                </p>

