---
// src/pages/alur-pendaftaran.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Alur & Syarat Pendaftaran Magang - Gemilang Training" isHome={false}>
  <Navbar slot="header" />

  <section class="py-12 md:py-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Prosedur Resmi Magang Vokasi & Kampus
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6">
        Alur & Syarat Pendaftaran Magang
      </h1>
      <p class="text-tc-muted text-base md:text-lg leading-relaxed">
        Panduan 5 langkah terstruktur bagi Siswa SMK (PKL) dan Mahasiswa (Magang Industri) mulai dari konsultasi awal hingga penerbitan Surat Balasan Resmi.
      </p>
    </div>

    <!-- Timeline Steps -->
    <div class="space-y-6 mb-16">
      
      <!-- Step 1 -->
      <div class="bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border hover:border-tc-accent transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-12 h-12 rounded-2xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-lg flex items-center justify-center shrink-0">
          01
        </div>
        <div class="space-y-2 flex-1">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-white">1. Konsultasi Program & Penyesuaian Jurusan</h3>
            <span class="text-xs font-mono text-tc-accent bg-tc-bg px-3 py-1 rounded-full border border-tc-border">Tahap Awal</span>
          </div>
          <p class="text-tc-muted text-sm leading-relaxed">
            Calon peserta magang memilih program magang yang diminati atau berkonsultasi langsung melalui kontak WhatsApp Admin Gemilang Training untuk penyesuaian porsi proyek (Skema 70:30 Tech vs Marketing/Konten).
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border hover:border-tc-accent transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-12 h-12 rounded-2xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-lg flex items-center justify-center shrink-0">
          02
        </div>
        <div class="space-y-2 flex-1">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-white">2. Pengajuan Berkas & Surat Pengantar</h3>
            <span class="text-xs font-mono text-tc-accent bg-tc-bg px-3 py-1 rounded-full border border-tc-border">Administrasi</span>
          </div>
          <p class="text-tc-muted text-sm leading-relaxed">
            Pendaftar menyerahkan kelengkapan berkas seperti CV/Portofolio singkat dan **Surat Pengantar Magang / PKL Resmi** yang diterbitkan oleh pihak Sekolah (SMK) atau Kampus.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border hover:border-tc-accent transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-12 h-12 rounded-2xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-lg flex items-center justify-center shrink-0">
          03
        </div>
        <div class="space-y-2 flex-1">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-white">3. Wawancara Singkat & Skill Mapping</h3>
            <p class="text-xs font-mono text-tc-accent bg-tc-bg px-3 py-1 rounded-full border border-tc-border">Verifikasi</p>
          </div>
          <p class="text-tc-muted text-sm leading-relaxed">
            Sesi wawancara/diskusi singkat secara online atau offline bersama mentor untuk pemetaan kemampuan awal dan penentuan tanggung jawab proyek yang akan dikerjakan.
          </p>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border hover:border-tc-accent transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-12 h-12 rounded-2xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-lg flex items-center justify-center shrink-0">
          04
        </div>
        <div class="space-y-2 flex-1">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-white">4. Penerbitan Surat Balasan Penerimaan Magang</h3>
            <span class="text-xs font-mono text-tc-accent bg-tc-bg px-3 py-1 rounded-full border border-tc-border">Legalitas</span>
          </div>
          <p class="text-tc-muted text-sm leading-relaxed">
            Setelah dinyatakan lolos verifikasi, tim Gemilang Training menerbitkan **Surat Balasan Penerimaan Resmi** bertanda tangan untuk diserahkan peserta ke pihak sekolah/kampus.
          </p>
        </div>
      </div>

      <!-- Step 5 -->
      <div class="bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border hover:border-tc-accent transition-all flex flex-col md:flex-row gap-6 items-start">
        <div class="w-12 h-12 rounded-2xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-lg flex items-center justify-center shrink-0">
          05
        </div>
        <div class="space-y-2 flex-1">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-white">5. Onboarding & Orientasi Proyek Industri</h3>
            <span class="text-xs font-mono text-tc-accent bg-tc-bg px-3 py-1 rounded-full border border-tc-border">Mulai Magang</span>
          </div>
          <p class="text-tc-muted text-sm leading-relaxed">
            Peserta mengikuti orientasi alur kerja industri, pembagian repositori (Astro, WordPress, Blogspot, atau Video Production), dan mulai mengerjakan proyek magang terpandu.
          </p>
        </div>
      </div>

    </div>

    <!-- CTA Box -->
    <div class="bg-tc-card border border-tc-border rounded-3xl p-8 text-center space-y-4 shadow-2xl">
      <h2 class="text-2xl font-bold text-white">Siap Memulai Pendaftaran Magang?</h2>
      <p class="text-tc-muted text-sm max-w-xl mx-auto">
        Hubungi tim pendaftaran kami via WhatsApp untuk mengirimkan berkas dan memulai konsultasi program.
      </p>
      <a 
        href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20mendaftar%20magang%20dan%20menanyakan%20persyaratan%20berkas." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-8 py-3.5 rounded-xl transition-all shadow-lg inline-block text-sm"
      >
        Daftar Sekarang via WA
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>