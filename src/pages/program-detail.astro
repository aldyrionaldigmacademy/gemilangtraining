          <div class="bg-tc-bg p-4 rounded-xl border border-tc-border/60 space-y-2">
            <div class="w-8 h-8 rounded-full bg-tc-accent text-slate-950 font-extrabold mx-auto flex items-center justify-center text-xs">3</div>
            <h4 class="text-white font-bold text-xs md:text-sm">Interview & Mapping</h4>
