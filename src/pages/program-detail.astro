// Baca Parameter Query URL Dinamis (?id=namaprogram)
const url = Astro.url;
const programId = url.searchParams.get('id') || 'informatika';
const currentData = detailsData[programId] || detailsData['informatika'];
---

<BaseLayout title={`${currentData.title} - Gemilang Training`} isHome={false}>
  <Navbar slot="header" />

  <section class="py-8 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- BREADCRUMB NAVIGASI -->
    <div>
      <a href="/#program" class="inline-flex items-center gap-2 text-xs md:text-sm text-tc-accent hover:underline font-semibold">
        &larr; Kembali ke Daftar Semua Program Magang
      </a>
    </div>

    <!-- 1. HEADER SECTION -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      
      <!-- FOTO BANNER HERO (KIRI) -->
      <div class="bg-tc-card p-3 rounded-2xl border border-tc-border shadow-2xl overflow-hidden">
        <img 
          src={currentData.img} 
          alt={currentData.title} 
          class="w-full h-auto max-h-[380px] object-cover rounded-xl" 
        />
      </div>

      <!-- CARD RINGKASAN & TOMBOL ACTION WA (KANAN) -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border shadow-2xl space-y-6">
        <div class="border-b border-tc-border pb-4 flex items-center justify-between">
          <div>
            <span class="text-xs text-tc-muted block">Status Pendaftaran</span>
            <span class="text-base font-bold text-white">Gelombang Aktif 2026</span>
          </div>
          <span class="text-xs bg-tc-accent/20 text-tc-accent border border-tc-accent/40 px-3 py-1 rounded-full font-semibold">Buka</span>
        </div>

        <div>
          <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest block mb-1">
            {currentData.category}
          </span>
          <h1 class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight">
            {currentData.title}
          </h1>
          <p class="text-tc-muted text-xs md:text-sm leading-relaxed">
            {currentData.desc}
          </p>
        </div>

        <div class="space-y-2 text-xs text-tc-muted border-t border-tc-border/60 pt-4">
          <div class="flex justify-between">
            <span>Target Jurusan:</span>
            <strong class="text-white">{currentData.jurusan}</strong>
          </div>
          <div class="flex justify-between">
            <span>Pembimbing/Mentor:</span>
            <strong class="text-tc-accent">{currentData.mentor}</strong>
          </div>
          <div class="flex justify-between">
            <span>Durasi Program:</span>
            <strong class="text-white">{currentData.durasi}</strong>
          </div>
        </div>

        <!-- TOMBOL AKSI UTAMA -->
        <div class="space-y-3 pt-2">
          <a 
            href={`https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20tertarik%20pilih%20Program%20${encodeURIComponent(currentData.jurusan)}.`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="block w-full text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold py-3.5 rounded-xl transition-all shadow-lg text-sm hover:scale-[1.02]"
          >
            Daftar Program Ini Sekarang
          </a>
          <a 
            href="/#program" 
            class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white font-medium py-3 rounded-xl transition-all text-xs"
          >
            Cek Pilihan Program Lainnya
          </a>
        </div>

      </div>

    </div>

    <!-- 2. STACKED CONTENT FULL WIDTH -->
    <div class="space-y-12">
      
      <!-- POINT 1: PRASYARAT / KUALIFIKASI PESERTA -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Prasyarat & Kualifikasi Peserta
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {currentData.kualifikasi.map((kual: string) => (
            <div class="flex items-start gap-3 bg-tc-bg/70 p-4 rounded-xl border border-tc-border/60">
              <span class="text-tc-accent font-bold mt-0.5">✓</span>
              <span class="text-tc-text text-xs md:text-sm font-medium leading-relaxed">{kual}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- POINT 2: FASILITAS & BENEFIT -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Fasilitas & Benefit Magang Termasuk
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {currentData.fasilitas.map((fasi: string) => (
            <div class="flex items-center gap-3 bg-tc-bg/70 p-4 rounded-xl border border-tc-border/60">
              <span class="w-2 h-2 rounded-full bg-tc-accent flex-shrink-0"></span>
              <span class="text-tc-text text-xs md:text-sm font-medium">{fasi}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- POINT 3: SKEMA PENILAIAN & EVALUASI AKADEMIS -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border space-y-6">
        <div>
          <h2 class="text-lg md:text-xl font-bold text-white mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"></path></svg>
            Kriteria & Bobot Penilaian Kelulusan
          </h2>
          <p class="text-tc-muted text-xs md:text-sm">
            Penilaian resmi disesuaikan dengan formulir evaluasi magang/PKL dari Perguruan Tinggi dan Sekolah Menengah Kejuruan (SMK).
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {currentData.assessment.map((ass: any) => (
            <div class="bg-tc-bg/70 p-4 rounded-xl border border-tc-border/60 space-y-1.5">
              <div class="flex justify-between items-center">
                <span class="text-white font-bold text-xs md:text-sm">{ass.aspek}</span>
                <span class="text-xs font-mono font-bold text-tc-accent bg-tc-card px-2 py-0.5 rounded border border-tc-border">{ass.bobot}</span>
              </div>
              <p class="text-tc-muted text-xs leading-relaxed">{ass.ket}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- POINT 4: SKEMA KOLABORASI LINTAS JURUSAN (CROSS-DEPARTMENT) -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border space-y-3">
        <span class="text-xs font-mono text-tc-accent uppercase tracking-widest font-bold">Cross-Department Collaboration</span>
        <h2 class="text-lg md:text-xl font-bold text-white">Simulasi Kolaborasi Tim Industri Nyata</h2>
        <p class="text-tc-muted text-xs md:text-sm leading-relaxed bg-tc-bg/60 p-4 rounded-xl border border-tc-border/50">
          🤝 <strong>Interaksi Lintas Divisi:</strong> {currentData.crossCollab}
        </p>
      </div>

      <!-- POINT 5: DOKUMENTASI / GALERI KEGIATAN -->
      <div>
        <h2 class="text-lg md:text-xl font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          Dokumentasi & Galeri Bimbingan
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {currentData.gallery.map((imgUrl: string) => (
            <div class="h-40 md:h-48 rounded-xl overflow-hidden border border-tc-border bg-tc-card shadow-md">
              <img src={imgUrl} alt="Dokumentasi Bimbingan" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
            </div>
          ))}
        </div>
      </div>

      <!-- POINT 6: RANGKAIAN TIMELINE -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Rangkaian & Itinerary Timeline Bimbingan
        </h2>
        <div class="space-y-6 relative before:absolute before:inset-0 before:left-3 md:before:left-4 before:w-0.5 before:bg-tc-border">
          {currentData.timeline.map((item: any) => (
            <div class="relative pl-8 md:pl-10">
              <span class="absolute left-1.5 md:left-2 top-1.5 w-3 h-3 rounded-full bg-tc-accent border-2 border-tc-bg"></span>
              <span class="text-xs font-mono text-tc-accent font-bold uppercase">{item.waktu}</span>
              <h3 class="text-base font-bold text-white my-1">{item.judul}</h3>
              <p class="text-tc-muted text-xs md:text-sm leading-relaxed">{item.ket}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- POINT 7: MATERI SILABUS & TOOLS -->
      <div class="bg-tc-card p-6 md:p-8 rounded-3xl border border-tc-border">
        <h2 class="text-lg md:text-xl font-bold text-white mb-6">Materi Silabus & Tools Pembelajaran</h2>
        
        <div class="space-y-4 mb-8">
          {currentData.curriculum.map((curr: string, idx: number) => (
            <div class="flex items-start gap-3 border-b border-tc-border/40 pb-3 last:border-none">
              <span class="w-6 h-6 rounded-full bg-tc-bg border border-tc-border text-tc-accent text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">{idx + 1}</span>
              <span class="text-tc-muted text-xs md:text-sm leading-relaxed">{curr}</span>
            </div>
          ))}
        </div>

        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3">Tools & Software Utama:</h3>
        <div class="flex flex-wrap gap-2">
          {currentData.tools.map((t: string) => (
            <span class="text-xs bg-tc-bg px-3 py-1.5 rounded-lg text-tc-accent border border-tc-border font-mono">{t}</span>
          ))}
        </div>
      </div>

      <!-- POINT 8: PANDUAN KOMPREHENSIF LAYANAN -->
      <div class="bg-tc-card/40 border border-tc-border p-6 md:p-8 rounded-3xl space-y-4">
        <span class="text-xs font-mono uppercase text-tc-accent tracking-widest block">Panduan Komprehensif Layanan</span>
        <h3 class="text-xl font-bold text-white">{currentData.technicalGuide.headline}</h3>
        <p class="text-tc-muted text-xs md:text-sm leading-relaxed">{currentData.technicalGuide.paragraph1}</p>
        <div class="space-y-3 pt-2">
          {currentData.technicalGuide.points.map((pt: string) => (
