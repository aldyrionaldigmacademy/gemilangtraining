---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const jalurProgramBeranda = [
  {
    badge: "Jalur Perguruan Tinggi (D3 / D4 / S1)",
    title: "Magang Mahasiswa",
    desc: "Program praktik kuliah untuk mahasiswa jurusan Informatika dengan proyek website nyata, optimasi SEO, pendampingan logbook harian, serta konversi nilai SKS kampus.",
    poin: [
      "Durasi fleksibel 3 – 6 bulan sesuai kalender kampus",
      "Membangun portofolio website live (Astro, Bootstrap, Blogspot)",
      "Sertifikat resmi kelulusan & lembar penilaian kampus"
    ],
    detailLink: "/program/magang-mahasiswa",
    alurLink: "/alur-pendaftaran?jalur=mahasiswa"
  },
  {
    badge: "Jalur Sekolah Menengah Kejuruan",
    title: "PKL Siswa SMK",
    desc: "Praktik Kerja Lapangan dibimbing bertahap dari dasar untuk siswa SMK jurusan RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, dan Multimedia.",
    poin: [
      "Dibimbing dari nol sampai bisa membuat website & artikel SEO",
      "Kolaborasi tim lintas jurusan teknis & kreatif/marketing",
      "Pendampingan monitoring guru & pengisian jurnal PKL"
    ],
    detailLink: "/program/pkl-smk",
    alurLink: "/alur-pendaftaran?jalur=smk"
  }
];

const portofolioBeranda = [
  {
    badge: "Media Digital",
    mitra: "Jawa Pos Radar Kediri",
    lokasi: "Kediri, Jawa Timur",
    title: "Kemitraan Jurnalistik & Portal Media Digital",
    desc: "Pengembangan strategi komunikasi media digital & portal berita komersial bersama Radar Kediri.",
    img: "/assets/img/kka-radar-kediri.webp"
  },
  {
    badge: "Vokasi & Pelatihan",
    mitra: "SMK PGRI 1 Malang (SKARIGA)",
    lokasi: "Malang, Jawa Timur",
    title: "Pelatihan Kejuruan Terpadu & Sinkronisasi",
    desc: "Program peningkatan kompetensi siswa SMK melalui sertifikasi keahlian terpadu lintas jurusan.",
    img: "/assets/img/pelatihan-smk3pgri.webp"
  },
  {
    badge: "Web & Fintech",
    mitra: "Panitia QRIS Run",
    lokasi: "Kota Malang",
    title: "Sistem Registrasi Digital & Event Management",
    desc: "Implementasi ticketing smart-presence dan lokasi live tracking untuk kegiatan event QRIS Run.",
    img: "/assets/img/qris-run.webp"
  }
];

const artikelBeranda = [
  {
    href: "/blog/tempat-magang-malang",
    img: "/assets/img/tempat-magang-malang-1.webp",
    alt: "Daftar periksa sebelum mendaftar magang di Malang",
    category: "Panduan Utama",
    tag: "Panduan Magang",
    title: "Tempat Magang di Malang 2027 dan Cara Memilihnya",
    desc: "Temukan jenis tempat magang di Malang, cara memilih yang sesuai jurusan, dan checklist verifikasi sebelum mendaftar.",
    date: "22 Nov 2026"
  },
  {
    href: "/blog/ciri-tawaran-magang-perlu-diwaspadai",
    img: "/assets/img/ciri-tawaran-magang-perlu-diwaspadai-1.webp",
    alt: "Mahasiswa memeriksa tawaran magang mencurigakan di ponsel",
    category: "Keamanan & Cek",
    tag: "Anti-Penipuan",
    title: "Ciri Tawaran Magang Mencurigakan dan Cara Cek",
    desc: "Kenali ciri tawaran magang yang mencurigakan dan cara cek tempat magang terpercaya sebelum daftar agar data tetap aman.",
    date: "22 Nov 2026"
  },
  {
    href: "/blog/pelatihan-ai-dan-prompt-untuk-bisnis-marketing-pemasaran",
    img: "/assets/img/artikel3a.webp",
    alt: "Pelatihan AI dan Prompt Marketing",
    category: "AI & Prompt",
    tag: "AI & Marketing",
    title: "Pelatihan AI dan Prompt untuk Bisnis, Marketing, dan Pemasaran",
    desc: "Panduan pelatihan AI dan prompt engineering untuk bisnis dan marketing: struktur prompt yang terarah & etika penggunaannya.",
    date: "03 Nov 2026"
  }
];
---

<BaseLayout title="Tempat Magang & PKL Mahasiswa & SMK di Malang - Gemilang Training" isHome={true}>
  <Navbar slot="header" />

  <!-- 1. HERO SECTION -->
  <section class="pt-24 pb-16 md:pt-32 md:pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-tc-card border border-tc-border text-tc-accent text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-tc-accent animate-pulse"></span>
        Pendaftaran Magang & PKL 2026 - Malang
      </div>
      
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
        Tempat Magang & PKL Berbasis Proyek Nyata di <span class="text-tc-accent">Gemilang Training</span>
      </h1>
      
      <p class="text-base md:text-xl text-tc-muted leading-relaxed mb-8">
        Program praktik berbasis proyek nyata di Malang untuk <strong class="text-white">Magang Mahasiswa (Informatika)</strong> serta <strong class="text-white">PKL Siswa SMK (RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, dan Multimedia)</strong> dengan bimbingan langsung dari mentor praktisi.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20mendaftar%20Program%20Magang%20%26%20PKL." target="_blank" rel="noopener noreferrer" class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-8 py-4 rounded-xl transition-all shadow-lg hover:scale-105">
          Daftar Magang & PKL
        </a>
        <a href="#program" class="bg-tc-card hover:border-tc-accent border border-tc-border text-white font-semibold px-8 py-4 rounded-xl transition-all">
          Lihat Pilihan Program
        </a>
      </div>
    </div>

    <!-- Foto Hero Representative -->
    <div class="relative max-w-5xl mx-auto rounded-2xl overflow-hidden border border-tc-border shadow-2xl bg-tc-card">
      <img 
        src="/assets/img/beranda1.webp" 
        alt="Kolaborasi Peserta Magang dan PKL Gemilang Training Malang" 
        class="w-full h-auto object-cover max-h-[480px] opacity-90 hover:opacity-100 transition-opacity duration-300"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-tc-bg via-transparent to-transparent opacity-80"></div>
    </div>
  </section>

  <!-- 2. RINGKASAN TENTANG -->
  <section class="py-16 bg-tc-card/50 border-y border-tc-border">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Mengapa Magang & PKL di Gemilang Training?</h2>
      <p class="text-tc-muted leading-relaxed">
        Gemilang Training menjembatani pembelajaran di sekolah dan kampus dengan praktik dunia digital yang sesungguhnya. Kami memastikan setiap peserta Magang dan PKL mendapatkan bimbingan intensif serta menghasilkan karya portofolio nyata selama masa praktik berlangsung.
      </p>
    </div>
  </section>

  <!-- 3. KEUNGGULAN PROGRAM -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-white text-center mb-12">Keunggulan Magang & PKL di Gemilang Training</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">01</div>
        <h3 class="text-lg font-bold text-white mb-2">Project-Based Learning</h3>
        <p class="text-tc-muted text-sm">Langsung mempraktikkan pembuatan website, optimasi SEO, dan konten kreatif, bukan sekadar tugas administratif.</p>
      </div>
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">02</div>
        <h3 class="text-lg font-bold text-white mb-2">Direct Mentorship</h3>
        <p class="text-tc-muted text-sm">Dibimbing langkah demi langkah oleh mentor praktisi yang berpengalaman di bidangnya.</p>
      </div>
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">03</div>
        <h3 class="text-lg font-bold text-white mb-2">Portofolio & Sertifikat</h3>
        <p class="text-tc-muted text-sm">Setiap lulusan Magang & PKL membawa bukti karya nyata serta sertifikat resmi kelulusan.</p>
      </div>
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">04</div>
        <h3 class="text-lg font-bold text-white mb-2">Skema Silang 70:30</h3>
        <p class="text-tc-muted text-sm">Kolaborasi lintas jurusan antara rumpun Tech (Web Dev) dan Digital Business & Creative Media.</p>
      </div>
    </div>
  </section>

  <!-- 4. PROGRAM MAGANG MAHASISWA & PKL SISWA SMK -->
  <section id="program" class="py-20 bg-tc-card/30 border-y border-tc-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold text-tc-accent uppercase tracking-wider block mb-2">
          Jalur Pendidikan Peserta
        </span>
        <h2 class="text-3xl font-bold text-white mb-2">Program Magang Mahasiswa & PKL Siswa SMK</h2>
        <p class="text-tc-muted text-sm max-w-2xl mx-auto mb-4">
          Pilih jalur program sesuai jenjang pendidikanmu untuk praktik pembuatan website (Astro, Bootstrap, Blogspot), optimasi SEO, penulisan artikel, dan digital marketing.
        </p>
        <a 
          href="/program" 
          class="text-tc-accent text-sm font-semibold hover:underline inline-flex items-center gap-1"
        >
          Lihat Semua Program & Materi &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {jalurProgramBeranda.map((item) => (
          <div class="bg-tc-card rounded-3xl border border-tc-border hover:border-tc-accent transition-all duration-300 p-7 md:p-8 flex flex-col justify-between shadow-xl">
            <div>
              <span class="inline-block text-[11px] font-semibold text-tc-accent uppercase tracking-wider bg-tc-bg border border-tc-border px-3 py-1 rounded-full mb-4">
                {item.badge}
              </span>
              <h3 class="text-2xl md:text-3xl font-extrabold text-white mb-3">
                {item.title}
              </h3>
              <p class="text-tc-muted text-sm leading-relaxed mb-6">
                {item.desc}
              </p>

              <ul class="space-y-2.5 mb-8">
                {item.poin.map((p) => (
                  <li class="flex items-start gap-2.5 text-xs md:text-sm text-white/90">
                    <span class="text-tc-accent font-bold mt-0.5">✓</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-5 border-t border-tc-border/60 flex flex-col sm:flex-row gap-3">
              <a 
                href={item.detailLink} 
                class="flex-1 text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold text-xs md:text-sm py-3 px-4 rounded-xl transition-all shadow-md"
              >
                Detail {item.title} &rarr;
              </a>
              <a 
                href={item.alurLink} 
                class="flex-1 text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white hover:text-tc-accent font-semibold text-xs md:text-sm py-3 px-4 rounded-xl transition-all"
              >
                Alur Pendaftaran
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. SHOWCASE PORTOFOLIO BERFOTO -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-white mb-2">Portofolio Karya Alumni Magang & PKL</h2>
      <p class="text-tc-muted text-sm max-w-xl mx-auto mb-4">Bukti otentik proyek yang telah berhasil diselesaikan oleh para peserta Magang dan PKL.</p>
      <a href="/portofolio" class="text-tc-accent text-sm font-semibold hover:underline inline-flex items-center gap-1">
        Lihat Semua Portofolio &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {portofolioBeranda.map((item) => {
        const waMessage = `Halo Admin Gemilang Training, saya tertarik dan ingin menanyakan detail mengenai proyek "${item.title}" (${item.mitra}).`;
        const waUrl = `https://wa.me/6281943431484?text=${encodeURIComponent(waMessage)}`;

        return (
          <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between shadow-xl">
            <div>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="block h-52 overflow-hidden relative border-b border-tc-border/60">
                <img src={item.img} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                  {item.badge}
                </span>
              </a>
              <div class="p-6 space-y-2">
                <div class="flex justify-between items-center text-xs text-tc-accent font-semibold">
                  <span>📍 {item.mitra}</span>
                  <span class="text-tc-muted">{item.lokasi}</span>
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
                  <a href={waUrl} target="_blank" rel="noopener noreferrer" class="hover:text-tc-accent transition-colors">
                    {item.title}
                  </a>
                </h3>
                <p class="text-tc-muted text-xs leading-relaxed line-clamp-2">
                  {item.desc}
                </p>
              </div>
            </div>
            <div class="px-6 pb-6 pt-3 border-t border-tc-border/40">
              <a 
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-2.5 rounded-xl bg-tc-bg hover:bg-tc-accent hover:text-slate-950 text-center text-xs font-bold text-tc-accent border border-tc-border hover:border-tc-accent transition-all duration-300"
              >
                Konsultasi Proyek via WA &rarr;
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 6. PERWAKILAN BLOG / EDUKASI -->
  <section class="py-20 bg-tc-card/30 border-y border-tc-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-2">Edukasi & Tips Magang / PKL</h2>
        <p class="text-tc-muted text-sm max-w-xl mx-auto mb-4">Artikel terbaru untuk membantu persiapan Magang, PKL, dan karier digitalmu.</p>
        <a href="/blog" class="text-tc-accent text-sm font-semibold hover:underline inline-flex items-center gap-1">
          Lihat Semua Blog &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {artikelBeranda.map((post) => (
          <article class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between group shadow-xl">
            <div>
              <a href={post.href} class="block h-48 overflow-hidden relative border-b border-tc-border/60">
                <img src={post.img} alt={post.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                  {post.category}
                </span>
              </a>
              <div class="p-6 space-y-3">
                <span class="bg-tc-bg border border-tc-border text-tc-accent text-xs font-semibold px-3 py-1 rounded-full inline-block">
                  {post.tag}
                </span>
                <h3 class="text-lg font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
                  <a href={post.href}>
                    {post.title}
                  </a>
                </h3>
                <p class="text-tc-muted text-xs leading-relaxed line-clamp-2">
                  {post.desc}
                </p>
              </div>
            </div>
            <div class="px-6 pb-6 pt-3 border-t border-tc-border/60 flex items-center justify-between">
              <span class="text-xs font-mono text-tc-muted">{post.date}</span>
              <a href={post.href} class="text-xs font-bold text-tc-accent hover:text-white transition-colors">
                Baca Selengkapnya &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. TESTIMONI ALUMNI -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-white mb-4">Apa Kata Alumni Magang & PKL?</h2>
      <p class="text-tc-muted">Pengalaman nyata dari para siswa SMK dan mahasiswa yang telah menyelesaikan program di Gemilang Training.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Testimoni 1 -->
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border flex flex-col justify-between">
        <p class="text-tc-muted text-sm italic mb-6">
          "Magang di sini beneran ngerjain proyek nyata. Saya yang dari jurusan Informatika jadi paham cara bangun website cepat dengan Astro dan Bootstrap."
        </p>
        <div class="flex items-center gap-3 border-t border-tc-border pt-4">
          <div class="w-10 h-10 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center font-bold text-tc-accent">F</div>
          <div>
            <h4 class="text-white font-bold text-sm">Fajar Ramadhan</h4>
            <p class="text-tc-muted text-xs">Mahasiswa Informatika</p>
          </div>
        </div>
      </div>

      <!-- Testimoni 2 -->
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border flex flex-col justify-between">
        <p class="text-tc-muted text-sm italic mb-6">
          "Waktu PKL di sini, praktik Digital Marketing-nya langsung ke kasus nyata. Riset keyword SEO dan pembuatan artikel beneran kepakai dan bikin portofolio saya makin berbobot!"
        </p>
        <div class="flex items-center gap-3 border-t border-tc-border pt-4">
          <div class="w-10 h-10 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center font-bold text-tc-accent">S</div>
          <div>
            <h4 class="text-white font-bold text-sm">Siti Nurhaliza</h4>
            <p class="text-tc-muted text-xs">Siswa PKL Bisnis Digital & Pemasaran</p>
          </div>
        </div>
      </div>

      <!-- Testimoni 3 -->
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border flex flex-col justify-between">
        <p class="text-tc-muted text-sm italic mb-6">
          "Bimbingan PKL-nya intensif banget. Produksi video konten dan pengelolaan media web saya benar-benar di-review langsung oleh mentor praktisi."
        </p>
        <div class="flex items-center gap-3 border-t border-tc-border pt-4">
          <div class="w-10 h-10 rounded-full bg-tc-accent/20 border border-tc-accent flex items-center justify-center font-bold text-tc-accent">D</div>
          <div>
            <h4 class="text-white font-bold text-sm">Dion Arisandi</h4>
            <p class="text-tc-muted text-xs">Siswa PKL DKV & Multimedia</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQ INTERAKTIF -->
  <section class="py-20 bg-tc-card/30 border-t border-tc-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-white text-center mb-12">Pertanyaan Umum (FAQ)</h2>
      <div class="space-y-4">
        
        <details class="bg-tc-card p-6 rounded-2xl border border-tc-border group cursor-pointer transition-all">
          <summary class="text-lg font-semibold text-white flex justify-between items-center list-none select-none">
            <span>Siapa saja yang bisa mendaftar Magang & PKL di Gemilang Training?</span>
            <span class="text-tc-accent text-sm group-open:rotate-180 transition-transform duration-300">▼</span>
          </summary>
          <p class="text-tc-muted text-sm mt-4 leading-relaxed border-t border-tc-border pt-4">
            Mahasiswa perguruan tinggi (Program Magang) dari jurusan Informatika dan Siswa SMK (Program PKL) jurusan RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, dan Multimedia.
          </p>
        </details>

        <details class="bg-tc-card p-6 rounded-2xl border border-tc-border group cursor-pointer transition-all">
          <summary class="text-lg font-semibold text-white flex justify-between items-center list-none select-none">
            <span>Bagaimana sistem pelaksanaan Magang & PKL-nya?</span>
            <span class="text-tc-accent text-sm group-open:rotate-180 transition-transform duration-300">▼</span>
          </summary>
          <p class="text-tc-muted text-sm mt-4 leading-relaxed border-t border-tc-border pt-4">
            Sistem pelaksanaan fleksibel (WFH / Hybrid / Onsite Malang) disesuaikan dengan ketentuan sekolah/kampus dan kebutuhan proyek yang dikerjakan bersama mentor.
          </p>
        </details>

        <details class="bg-tc-card p-6 rounded-2xl border border-tc-border group cursor-pointer transition-all">
          <summary class="text-lg font-semibold text-white flex justify-between items-center list-none select-none">
            <span>Berapa lama durasi Magang & PKL yang tersedia?</span>
            <span class="text-tc-accent text-sm group-open:rotate-180 transition-transform duration-300">▼</span>
          </summary>
          <p class="text-tc-muted text-sm mt-4 leading-relaxed border-t border-tc-border pt-4">
            Durasi standar berkisar antara 3 hingga 6 bulan sesuai dengan ketentuan kalender PKL SMK maupun program magang resmi dari pihak kampus masing-masing.
          </p>
        </details>

        <details class="bg-tc-card p-6 rounded-2xl border border-tc-border group cursor-pointer transition-all">
          <summary class="text-lg font-semibold text-white flex justify-between items-center list-none select-none">
            <span>Apakah peserta akan mendapatkan sertifikat resmi?</span>
