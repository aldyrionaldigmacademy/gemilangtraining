---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Platform Magang Industri Mahasiswa & SMK - Gemilang Training Malang" isHome={true}>
  <Navbar slot="header" />

  <!-- 1. HERO SECTION -->
  <section class="pt-24 pb-16 md:pt-32 md:pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-tc-card border border-tc-border text-tc-accent text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-tc-accent animate-pulse"></span>
        Pendaftaran Gelombang Aktif 2026 - Malang
      </div>
      
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
        Cetak Portofolio Industri Bersama <span class="text-tc-accent">Gemilang Training</span>
      </h1>
      
      <p class="text-base md:text-xl text-tc-muted leading-relaxed mb-8">
        Program magang berbasis proyek industri nyata untuk <strong class="text-white">Mahasiswa Informatika, Digital Marketing, Bisnis Digital, Pemasaran</strong>, serta siswa SMK jurusan <strong class="text-white">RPL, TKJ, Multimedia, dan DKV</strong> untuk mengasah keterampilan hingga siap kerja.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20mendaftar%20Program%20Magang." target="_blank" rel="noopener noreferrer" class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-8 py-4 rounded-xl transition-all shadow-lg hover:scale-105">
          Daftar Magang Sekarang
        </a>
        <a href="#program" class="bg-tc-card hover:border-tc-accent border border-tc-border text-white font-semibold px-8 py-4 rounded-xl transition-all">
          Eksplorasi Program
        </a>
      </div>
    </div>

    <!-- Foto Hero Representative -->
    <div class="relative max-w-5xl mx-auto rounded-2xl overflow-hidden border border-tc-border shadow-2xl bg-tc-card">
      <img 
        src="/assets/img/beranda1.webp" 
        alt="Kolaborasi Peserta Magang Gemilang Training Malang" 
        class="w-full h-auto object-cover max-h-[480px] opacity-90 hover:opacity-100 transition-opacity duration-300"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-tc-bg via-transparent to-transparent opacity-80"></div>
    </div>
  </section>

  <!-- 2. RINGKASAN TENTANG -->
  <section class="py-16 bg-tc-card/50 border-y border-tc-border">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Mengapa Gemilang Training Ada?</h2>
      <p class="text-tc-muted leading-relaxed">
        Gemilang Training menjembatani dunia pendidikan dengan standar industri. Kami memastikan setiap peserta magang tidak hanya mendapatkan jam kerja, tetapi menghasilkan karya nyata yang siap dipamerkan di portofolio profesional.
      </p>
    </div>
  </section>

  <!-- 3. KEUNGGULAN PROGRAM -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-white text-center mb-12">Keunggulan Magang di Gemilang Training</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">01</div>
        <h3 class="text-lg font-bold text-white mb-2">Project-Based</h3>
        <p class="text-tc-muted text-sm">Mengerjakan proyek nyata industri, bukan sekadar tugas teori atau administratif.</p>
      </div>
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">02</div>
        <h3 class="text-lg font-bold text-white mb-2">Direct Mentorship</h3>
        <p class="text-tc-muted text-sm">Dibimbing langsung oleh mentor praktisi yang berpengalaman di bidangnya.</p>
      </div>
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">03</div>
        <h3 class="text-lg font-bold text-white mb-2">Ready Portfolio</h3>
        <p class="text-tc-muted text-sm">Setiap lulusan membawa bukti karya otentik dan sertifikat resmi kelulusan.</p>
      </div>
      <div class="bg-tc-card p-6 rounded-2xl border border-tc-border">
        <div class="text-tc-accent text-2xl font-bold mb-3">04</div>
        <h3 class="text-lg font-bold text-white mb-2">Cross-Collaboration</h3>
        <p class="text-tc-muted text-sm">Kolaborasi tim nyata antara anak Tech, Digital Marketing, dan Creative Design.</p>
      </div>
    </div>
  </section>

  <!-- 4. PERWAKILAN PROGRAM SPESIALISASI LENGKAP -->
  <section id="program" class="py-20 bg-tc-card/30 border-y border-tc-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-4">Program Magang Spesialisasi</h2>
        <p class="text-tc-muted">Pilihan jurusan industri yang disesuaikan secara presisi dengan latar belakang pendidikanmu.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- 1. Informatika -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/informatika.webp" alt="Informatika" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                Informatika / SI
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Tech & Dev</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">Web Engineering & Architecture</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Pengembangan web modern berkecepatan tinggi, integrasi REST API, dan deployment cloud.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=informatika" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

        <!-- 2. RPL -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/rpl.webp" alt="Rekayasa Perangkat Lunak" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                SMK / Mahasiswa RPL
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Tech & Dev</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">Frontend & Fullstack Web Dev</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Penguasaan komponen antarmuka modern, Clean Code, dan arsitektur Clean URL dinamis.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=rpl" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

        <!-- 3. TKJ -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/tkj.webp" alt="Teknik Komputer & Jaringan" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                TKJ
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Tech & Dev</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">Network & Cloud Infrastructure</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Konfigurasi DNS Record, keamanan SSL/TLS, CDN, dan deployment otomatis platform cloud.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=tkj" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

        <!-- 4. Digital Marketing -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/digitalmarketing.webp" alt="Digital Marketing" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                Digital Marketing
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Digital Business</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">SEO & Answer Engine Optimization</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Riset keyword high-intent, strategi artikel pillar SEO, dan optimasi rekomendasi AI Search.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=digital-marketing" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

        <!-- 5. Bisnis Digital -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/bisnisdigital.webp" alt="Bisnis Digital" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                Bisnis Digital
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Digital Business</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">Data-Driven Growth & Strategy</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Optimalisasi Sales Funnel, riset kompetitor, dan pengelolaan operasional TikTok Shop Seller.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=bisnis-digital" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

        <!-- 6. Pemasaran -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/pemasaran.webp" alt="Pemasaran / Sales" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                Pemasaran / Sales
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Digital Business</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">Local GEO Tagging & Campaign</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Pemasaran lokal berdasar GEO Tagging, Google Business Profile, dan komunikasi outbound.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=pemasaran" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

        <!-- 7. DKV -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/uiux.webp" alt="Desain Komunikasi Visual" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                DKV
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Creative Arts</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">UI/UX Design & Brand Identity</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Pembuatan Design System UI/UX di Figma, antarmuka interaktif, dan panduan identitas brand.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=dkv" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

        <!-- 8. Multimedia -->
        <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-44 overflow-hidden relative border-b border-tc-border/60">
              <img src="/assets/img/multimedia.webp" alt="Multimedia" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2.5 left-2.5 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-2.5 py-0.5 rounded-full backdrop-blur-md">
                Multimedia
              </span>
            </div>
            <div class="p-5">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-1">Creative Arts</span>
              <h3 class="text-base font-bold text-white mb-2 leading-snug">Video Production & Motion Graphic</h3>
              <p class="text-tc-muted text-xs leading-relaxed">
                Produksi video pendek sinematik, animasi motion graphics 2D, audio mixing, dan thumbnail.
              </p>
            </div>
          </div>
          <div class="px-5 pb-5 pt-2 border-t border-tc-border/60">
            <a href="/program-detail?id=multimedia" class="block w-full text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold py-2 rounded-xl transition-all">
              Detail Program &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. SHOWCASE PORTOFOLIO BERFOTO -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-white mb-2">Portofolio Karya Alumni</h2>
      <p class="text-tc-muted text-sm max-w-xl mx-auto mb-4">Bukti otentik proyek yang telah berhasil diselesaikan oleh para peserta magang.</p>
      <a href="/portofolio" class="text-tc-accent text-sm font-semibold hover:underline inline-flex items-center gap-1">
        Lihat Semua Portofolio &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Item Portofolio 1 -->
      <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between shadow-xl">
        <div>
          <div class="h-52 overflow-hidden relative border-b border-tc-border/60">
            <img src="/assets/img/kka-radar-kediri.webp" alt="Media Digital Radar Kediri" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">Media Digital</span>
          </div>
          <div class="p-6 space-y-2">
            <div class="text-xs text-tc-accent font-semibold">📍 Jawa Pos Radar Kediri</div>
            <h3 class="text-lg font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
              Kemitraan Jurnalistik & Portal Media Digital
            </h3>
            <p class="text-tc-muted text-xs leading-relaxed line-clamp-2">
              Pengembangan strategi komunikasi media digital & portal berita komersial bersama Radar Kediri.
            </p>
          </div>
        </div>
        <div class="px-6 pb-6 pt-3 border-t border-tc-border/40">
          <a href="/portofolio" class="text-tc-accent text-xs font-bold hover:underline">Lihat Case Study &rarr;</a>
        </div>
      </div>

      <!-- Item Portofolio 2 -->
      <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between shadow-xl">
        <div>
          <div class="h-52 overflow-hidden relative border-b border-tc-border/60">
            <img src="/assets/img/pelatihan-smk3pgri.webp" alt="Pelatihan SKARIGA Malang" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">Vokasi & Pelatihan</span>
          </div>
          <div class="p-6 space-y-2">
            <div class="text-xs text-tc-accent font-semibold">📍 SMK PGRI 1 Malang (SKARIGA)</div>
            <h3 class="text-lg font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
              Pelatihan Kejuruan Terpadu & Sinkronisasi
            </h3>
            <p class="text-tc-muted text-xs leading-relaxed line-clamp-2">
              Program peningkatan kompetensi siswa SMK melalui sertifikasi keahlian terpadu lintas jurusan.
            </p>
          </div>
        </div>
        <div class="px-6 pb-6 pt-3 border-t border-tc-border/40">
          <a href="/portofolio" class="text-tc-accent text-xs font-bold hover:underline">Lihat Case Study &rarr;</a>
        </div>
      </div>

      <!-- Item Portofolio 3 -->
      <div class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 group flex flex-col justify-between shadow-xl">
        <div>
          <div class="h-52 overflow-hidden relative border-b border-tc-border/60">
            <img src="/assets/img/qris-run.webp" alt="QRIS Run System" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-[11px] font-semibold px-3 py-1 rounded-full backdrop-blur-md">Web & Fintech</span>
          </div>
          <div class="p-6 space-y-2">
            <div class="text-xs text-tc-accent font-semibold">📍 Panitia QRIS Run</div>
            <h3 class="text-lg font-bold text-white group-hover:text-tc-accent transition-colors leading-snug">
              Sistem Registrasi Digital & Event Management
            </h3>
            <p class="text-tc-muted text-xs leading-relaxed line-clamp-2">
              Implementasi ticketing smart-presence dan lokasi live tracking untuk kegiatan event QRIS Run.
            </p>
          </div>
        </div>
        <div class="px-6 pb-6 pt-3 border-t border-tc-border/40">
          <a href="/portofolio" class="text-tc-accent text-xs font-bold hover:underline">Lihat Case Study &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. PERWAKILAN BLOG / EDUKASI -->
  <section class="py-20 bg-tc-card/30 border-y border-tc-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-2">Edukasi & Tips Magang</h2>
        <p class="text-tc-muted text-sm max-w-xl mx-auto mb-4">Artikel terbaru untuk membantu persiapan karier digitalmu.</p>
        <a href="/blog" class="text-tc-accent text-sm font-semibold hover:underline inline-flex items-center gap-1">
          Lihat Semua Blog &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Artikel 1 (Pelatihan Kejuruan Terpadu SKARIGA) -->
        <article class="bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between group shadow-xl">
