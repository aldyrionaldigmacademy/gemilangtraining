      <div>
        <span class="text-xs font-semibold text-tc-accent uppercase tracking-wider block mb-2">
          Jalur Pendidikan & Jurusan Peserta
        </span>
        <h2 class="text-2xl md:text-4xl font-extrabold text-white">
          Pilih Kategori Programmu
        </h2>
      </div>
      <a 
        href="/alur-pendaftaran" 
