---
// src/pages/program.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const jalurProgram = [
  {
    badge: "Jalur Perguruan Tinggi (D3 / D4 / S1)",
    title: "Magang Mahasiswa",
    desc: "Program praktik kuliah untuk mahasiswa jurusan Informatika dengan proyek website nyata, optimasi SEO, pendampingan logbook harian, serta konversi nilai SKS kampus.",
    poin: [
      "Durasi fleksibel 3 – 6 bulan sesuai kalender kampus",
      "Membangun portofolio website live (Astro, Bootstrap, Blogspot)",
      "Sertifikat resmi kelulusan & lembar penilaian kampus"
    ],
    detailLink: "/program/magang-mahasiswa",
    alurLink: "/alur-pendaftaran?jalur=mahasiswa"
  },
  {
    badge: "Jalur Sekolah Menengah Kejuruan",
    title: "PKL Siswa SMK",
    desc: "Praktik Kerja Lapangan dibimbing bertahap dari dasar untuk siswa SMK jurusan RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, dan Multimedia.",
    poin: [
      "Dibimbing dari nol sampai bisa membuat website & artikel SEO",
      "Kolaborasi tim lintas jurusan teknis & kreatif/marketing",
      "Pendampingan monitoring guru & pengisian jurnal PKL"
    ],
    detailLink: "/program/pkl-smk",
    alurLink: "/alur-pendaftaran?jalur=smk"
  }
];

const programs = [
  {
    slug: "website-astro",
    category: "webdev",
    categoryLabel: "Pembuatan Website",
    jurusanTarget: "Magang Mahasiswa Informatika & PKL SMK (RPL, TKJ)",
    title: "Pembuatan Website Modern dengan Astro",
    desc: "Praktik membangun website multi-halaman berkecepatan tinggi menggunakan Astro JS, struktur Clean URL tanpa .html, hingga proses deploy online.",
    techs: ["Astro Framework", "Clean URL", "Optimasi PageSpeed", "Deploy Vercel"],
    img: "/assets/img/informatika.webp"
  },
  {
    slug: "website-bootstrap",
    category: "webdev",
    categoryLabel: "Pembuatan Website",
    jurusanTarget: "Magang Mahasiswa Informatika & PKL SMK (RPL, DKV, MM)",
    title: "Desain & Koding Website dengan Bootstrap",
    desc: "Belajar menyusun tampilan website yang rapi, responsif di HP maupun laptop, menggunakan komponen Bootstrap 5, HTML, CSS, dan aset gambar .webp ringan.",
    techs: ["Bootstrap 5", "HTML & CSS", "Desain Responsif", "Kompresi WebP"],
    img: "/assets/img/rpl.webp"
  },
  {
    slug: "website-blogspot",
    category: "webdev",
    categoryLabel: "Pembuatan Website",
    jurusanTarget: "PKL SMK (RPL, TKJ, Digital Marketing, Bisnis Digital)",
    title: "Pembuatan Website & Pengelolaan Blogspot",
    desc: "Praktik membuat website profil usaha dan portal informasi menggunakan Blogspot, mulai dari pengaturan tata letak, navigasi menu, hingga hubungkan domain kustom.",
    techs: ["Blogspot CMS", "Custom Domain", "Setting Navigasi", "Kelola Halaman"],
    img: "/assets/img/tkj.webp"
  },
  {
    slug: "optimasi-seo",
    category: "seo-marketing",
    categoryLabel: "SEO & Digital Marketing",
    jurusanTarget: "Magang Mahasiswa & PKL SMK Semua Jurusan",
    title: "Optimasi SEO & Riset Kata Kunci",
    desc: "Praktik agar website mudah ditemukan di halaman atas Google melalui riset keyword, pengaturan meta tag, Open Graph, serta pemantauan di Google Search Console.",
    techs: ["Riset Keyword", "SEO On-Page", "Google Search Console", "Open Graph & Schema"],
    img: "/assets/img/digitalmarketing.webp"
  },
  {
    slug: "pembuatan-artikel",
    category: "seo-marketing",
    categoryLabel: "SEO & Digital Marketing",
    jurusanTarget: "PKL SMK (Digital Marketing, Bisnis Digital, Pemasaran)",
    title: "Penulisan Artikel SEO & Konten Website",
    desc: "Belajar menyusun artikel informatif dan promosi yang enak dibaca sekaligus ramah mesin pencari, lengkap dengan struktur heading, internal link, dan gambar pendukung.",
    techs: ["Artikel SEO", "Copywriting", "Struktur Heading", "Internal Linking"],
    img: "/assets/img/bisnisdigital.webp"
  },
  {
    slug: "digital-marketing",
    category: "seo-marketing",
    categoryLabel: "SEO & Digital Marketing",
    jurusanTarget: "PKL SMK (Pemasaran, Bisnis Digital, DKV, Multimedia)",
    title: "Digital Marketing & Promosi Online",
    desc: "Praktik memasarkan produk dan jasa secara digital menggunakan halaman landing page, optimasi lokasi lokal, serta pembuatan materi promosi visual untuk menarik calon pelanggan.",
    techs: ["Strategi Promosi", "Landing Page", "Local GEO Tagging", "Konten Promosi"],
    img: "/assets/img/pemasaran.webp"
  }
];
---

<BaseLayout 
  title="Semua Program Magang Mahasiswa & PKL Siswa SMK - Gemilang Training Malang" 
  description="Daftar lengkap jalur Magang Mahasiswa Informatika dan PKL Siswa SMK di Gemilang Training Malang beserta kurikulum praktik pembuatan website Astro, Bootstrap, Blogspot, SEO, Artikel, dan Digital Marketing."
  isHome={false}
>
  <Navbar slot="header" />

  <!-- 1. HERO HEADER BANNER -->
  <section class="relative bg-tc-card/80 border-b border-tc-border overflow-hidden">
    <div class="absolute inset-0 opacity-15">
      <img src="/assets/img/beranda1.webp" alt="Semua Program Magang & PKL Gemilang Training Malang" class="w-full h-full object-cover" />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 text-center">
      <span class="inline-block text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-bg/90 px-4 py-1.5 rounded-full border border-tc-border mb-4">
        Semua Program • Kota Malang
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 leading-tight">
        Program Magang & PKL <span class="text-tc-accent">Gemilang Training</span>
      </h1>
      <p class="text-tc-muted text-sm md:text-lg max-w-2xl mx-auto leading-relaxed">
        Pilih jalur program sesuai jenjang pendidikanmu dan eksplorasi seluruh bidang keahlian website, SEO, hingga digital marketing yang dipraktikkan langsung bersama mentor.
      </p>
    </div>
  </section>

  <!-- 2. PILIH JALUR PROGRAM (TERHUBUNG KE /program/magang-mahasiswa, /program/pkl-smk, & /alur-pendaftaran) -->
  <section class="pt-14 md:pt-20 pb-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-xs font-semibold text-tc-accent uppercase tracking-wider block mb-2">
          Jalur Pendidikan Peserta
        </span>
        <h2 class="text-2xl md:text-4xl font-extrabold text-white">
          Pilih Kategori Programmu
        </h2>
      </div>
      <a 
        href="/alur-pendaftaran" 
        class="inline-flex items-center gap-2 bg-tc-card hover:border-tc-accent border border-tc-border text-tc-accent text-xs font-semibold px-4 py-2.5 rounded-xl transition-all self-start md:self-auto"
      >
        <span>Lihat Alur Pendaftaran Lengkap</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {jalurProgram.map((item) => (
        <div class="bg-tc-card rounded-3xl border border-tc-border hover:border-tc-accent transition-all duration-300 p-7 md:p-8 flex flex-col justify-between shadow-xl">
          <div>
            <span class="inline-block text-[11px] font-semibold text-tc-accent uppercase tracking-wider bg-tc-bg border border-tc-border px-3 py-1 rounded-full mb-4">
              {item.badge}
            </span>
            <h3 class="text-2xl md:text-3xl font-extrabold text-white mb-3">
              {item.title}
            </h3>
            <p class="text-tc-muted text-sm leading-relaxed mb-6">
              {item.desc}
            </p>

            <ul class="space-y-2.5 mb-8">
              {item.poin.map((p) => (
                <li class="flex items-start gap-2.5 text-xs md:text-sm text-white/90">
                  <span class="text-tc-accent font-bold mt-0.5">✓</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-5 border-t border-tc-border/60 flex flex-col sm:flex-row gap-3">
            <a 
              href={item.detailLink} 
              class="flex-1 text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold text-xs md:text-sm py-3 px-4 rounded-xl transition-all shadow-md"
            >
              Detail {item.title} &rarr;
            </a>
            <a 
              href={item.alurLink} 
              class="flex-1 text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white hover:text-tc-accent font-semibold text-xs md:text-sm py-3 px-4 rounded-xl transition-all"
            >
              Alur Pendaftaran
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. DAFTAR MATERI PRAKTIK MAGANG & PKL -->
  <section class="py-12 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Kurikulum Praktik Proyek Nyata
      </span>
      <h2 class="text-2xl md:text-4xl font-extrabold text-white mb-4 leading-tight">
        Apa Saja yang Dipelajari Saat <span class="text-tc-accent">Magang & PKL?</span>
      </h2>
      <p class="text-tc-muted text-sm md:text-base leading-relaxed">
        Selama mengikuti Magang Mahasiswa atau PKL Siswa SMK di Gemilang Training Malang, kamu akan langsung mempraktikkan pembuatan website (<strong class="text-white">Astro, Bootstrap, dan Blogspot</strong>), <strong class="text-white">Optimasi SEO</strong>, <strong class="text-white">Penulisan Artikel</strong>, hingga <strong class="text-white">Digital Marketing</strong>.
      </p>
    </div>

    <!-- Filter Buttons Interaktif -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <button 
        data-filter="all" 
        class="filter-btn active-filter px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-accent bg-tc-card text-tc-accent inline-flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
        <span>Semua Materi (6)</span>
      </button>

      <button 
        data-filter="webdev" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        <span>Pembuatan Website (Astro, Bootstrap, Blogspot)</span>
      </button>

      <button 
        data-filter="seo-marketing" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
        <span>Optimasi SEO, Artikel & Digital Marketing</span>
      </button>
    </div>

    <!-- Grid Kartu Materi -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="program-grid">
      {programs.map((item) => (
        <div 
          class="program-card bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between group"
          data-category={item.category}
        >
          <div>
            <!-- Thumbnail Gambar -->
            <div class="h-48 overflow-hidden relative border-b border-tc-border/60">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-xs font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                {item.categoryLabel}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-2">{item.jurusanTarget}</span>
              <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
              <p class="text-tc-muted text-sm leading-relaxed mb-6">{item.desc}</p>
              
              <!-- Tag Tech/Skills -->
              <div class="flex flex-wrap gap-2 mb-6">
                {item.techs.map((t) => (
                  <span class="text-xs bg-tc-bg px-2.5 py-1 rounded-md text-tc-muted border border-tc-border">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Tombol CTA & Detail -->
          <div class="px-6 pb-6 pt-3 border-t border-tc-border/60 flex items-center justify-between gap-3">
            <a 
              href={`/program/${item.slug}`} 
              class="flex-1 text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white text-xs font-semibold py-2.5 rounded-xl transition-all"
            >
              Detail Materi &rarr;
            </a>
            <a 
              href={`https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20bertanya%20mengenai%20Magang%20%26%20PKL%20materi%20${encodeURIComponent(item.title)}.`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex-1 text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 text-xs font-bold py-2.5 rounded-xl transition-all"
            >
              Daftar via WA
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. CTA BANNER PENDAFTARAN -->
  <section class="py-12 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-tc-card border border-tc-border rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
      <div class="max-w-xl text-center md:text-left">
        <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-3">
          Belum Yakin Memilih Jalur atau Materinya?
        </h2>
        <p class="text-tc-muted text-sm md:text-base">
          Pelajari langkah pengajuan surat pengantar di halaman Alur Pendaftaran atau konsultasikan langsung kebutuhan jurusanmu dengan admin kami.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 shrink-0">
        <a 
          href="/alur-pendaftaran" 
          class="bg-tc-bg hover:border-tc-accent border border-tc-border text-white font-semibold px-6 py-3.5 rounded-xl transition-all"
        >
          Alur Pendaftaran
        </a>
        <a 
          href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20konsultasi%20Program%20Magang%20%26%20PKL." 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-6 py-3.5 rounded-xl transition-all shadow-lg hover:scale-105"
        >
          Konsultasi via WA &rarr;
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupProgramFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const programCards = document.querySelectorAll('.program-card');

    if (!filterBtns.length || !programCards.length) return;

    function applyFilter(filterValue: string) {
      const targetBtn = document.querySelector(`.filter-btn[data-filter="${filterValue}"]`);
      if (!targetBtn) return;

      filterBtns.forEach(b => {
        b.classList.remove('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
        b.classList.add('text-tc-muted', 'border-tc-border');
      });

      targetBtn.classList.add('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
      targetBtn.classList.remove('text-tc-muted', 'border-tc-border');

      programCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter') || 'all';
        applyFilter(filterValue);
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('cat');

    if (categoryParam) {
      applyFilter(categoryParam);
    }
  }

  setupProgramFilter();
  document.addEventListener('astro:page-load', setupProgramFilter);
</script>