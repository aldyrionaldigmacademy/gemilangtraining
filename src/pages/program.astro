import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const programs = [
  // 1. Informatika
  {
    slug: "informatika",
    category: "webdev",
    categoryLabel: "Tech & Web Dev",
    jurusanTarget: "Terbuka untuk: Mahasiswa Informatika & Sistem Informasi",
