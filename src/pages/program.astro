          class="bg-tc-bg hover:border-tc-accent border border-tc-border text-white font-semibold px-6 py-3.5 rounded-xl transition-all"
        >
          Alur Pendaftaran
        </a>
        <a 
          href="/pendaftaran" 
          class="bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-bold px-6 py-3.5 rounded-xl transition-all shadow-lg hover:scale-105"
