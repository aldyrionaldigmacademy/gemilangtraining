---
// src/pages/program.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const programs = [
  // 1. Informatika
  {
    slug: "informatika",
    category: "webdev",
    categoryLabel: "Web Development",
    jurusanTarget: "Terbuka untuk: Mahasiswa Informatika & Sistem Informasi",
    title: "Web Engineering & Software Architecture",
    desc: "Praktik pembuatan website modern SSG dengan Astro Framework, optimasi performa berkecepatan tinggi, integrasi API, serta pengelolaan arsitektur server.",
    techs: ["Astro Framework", "Bootstrap 5", "Blogspot", "Tailwind CSS"],
    img: "/assets/img/informatika.webp"
  },
  // 2. RPL
  {
    slug: "rpl",
    category: "webdev",
    categoryLabel: "Web Development",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan RPL",
    title: "Frontend & Fullstack Web Development",
    desc: "Fokus pada pembuatan komponen web responsif menggunakan Astro SSG, kustomisasi template Bootstrap, pengelolaan Blogspot komersial, dan Clean Code.",
    techs: ["Astro SSG", "Bootstrap 5", "Blogspot CMS", "HTML5/CSS3"],
    img: "/assets/img/rpl.webp"
  },
  // 3. TKJ
  {
    slug: "tkj",
    category: "webdev",
    categoryLabel: "Web Development & Infrastructure",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan TKJ",
    title: "Network & Cloud Infrastructure Deployment",
    desc: "Deployment platform web Astro ke Vercel/Netlify, konfigurasi DNS Record, manajemen SSL security, serta penyediaan subdomain praktik.",
    techs: ["Cloud Deployment", "Custom DNS", "Astro Hosting", "Blogspot Domain"],
    img: "/assets/img/tkj.webp"
  },
  // 4. Digital Marketing
  {
    slug: "digital-marketing",
    category: "seo",
    categoryLabel: "Artikel & SEO",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Digital Marketing",
    title: "SEO & Answer Engine Optimization (AEO)",
    desc: "Riset kata kunci berdaya beli tinggi, strategi penulisan artikel pillar SEO On-Page, optimasi Answer Engine (ChatGPT/Gemini), dan Google Search Console.",
    techs: ["Artikel SEO", "AEO Strategy", "Google Search Console", "Blogspot SEO"],
    img: "/assets/img/digitalmarketing.webp"
  },
  // 5. Bisnis Digital
  {
    slug: "bisnis-digital",
    category: "seo",
    categoryLabel: "Artikel & Business Strategy",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Bisnis Digital",
    title: "Data-Driven Growth & Content Strategy",
    desc: "Penyusunan artikel promosi produk, optimasi Sales Funnel, riset pasar digital, serta strategi pertumbuhan omset toko e-commerce.",
    techs: ["Content Writing", "Sales Funnel", "Market Research", "TikTok Shop"],
    img: "/assets/img/bisnisdigital.webp"
  },
  // 6. Pemasaran
  {
    slug: "pemasaran",
    category: "marketing",
    categoryLabel: "Pemasaran & Outreach",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Pemasaran",
    title: "Local GEO Tagging & Social Media Campaign",
    desc: "Pemetaan GEO lokasi usaha lokal di Google Maps, penyusunan copywriting persuasif untuk website & landing page, serta campaign outbound.",
    techs: ["Local GEO Tagging", "Google Maps Business", "Copywriting", "Outreach"],
    img: "/assets/img/pemasaran.webp"
  },
  // 7. DKV
  {
    slug: "dkv",
    category: "marketing",
    categoryLabel: "Desain Visual & UI/UX",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan DKV",
    title: "UI/UX Design System & Brand Identity",
    desc: "Perancangan antarmuka situs web (UI/UX) di Figma, penyusunan Design System untuk Astro/Bootstrap, dan pembuatan aset visual brand.",
    techs: ["Figma UI/UX", "Design System", "Aset Web Graphic", "Brand Book"],
    img: "/assets/img/uiux.webp"
  },
  // 8. Multimedia
  {
    slug: "multimedia",
    category: "marketing",
    categoryLabel: "Creative Content & Video",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Multimedia",
    title: "Video Production & Motion Graphic Design",
    desc: "Produksi video promo pendek (Shorts/Reels/TikTok), animasi motion graphics 2D, penyuntingan audio visual, serta pembuatan thumbnail web.",
    techs: ["Premiere Pro", "After Effects", "Web Thumbnail", "Motion Graphics"],
    img: "/assets/img/multimedia.webp"
  }
];
---

<BaseLayout title="Program Magang Spesialisasi - Gemilang Training" isHome={false}>
  <Navbar slot="header" />

  <section class="py-12 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Program Magang Berbasis Proyek Industri
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6">
        Jalur Magang Spesialisasi Kampus & Vokasi
      </h1>
      <p class="text-tc-muted text-base md:text-lg leading-relaxed">
        Tempat magang untuk Mahasiswa Informatika dan Siswa SMK (RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, Multimedia) dengan fokus proyek pembuatan website (Astro, Bootstrap, Blogspot), artikel SEO, dan strategi pemasaran digital.
      </p>
    </div>

    <!-- Filter Buttons Interaktif (Ikon SVG Profesional menggantikan Emoji) -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <button 
        data-filter="all" 
        class="filter-btn active-filter px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border bg-tc-card text-tc-accent border-tc-accent inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
        <span>Semua Program</span>
      </button>

      <button 
        data-filter="webdev" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        <span>Web Development (Astro/Bootstrap/Blogspot)</span>
      </button>

      <button 
        data-filter="seo" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
        <span>Artikel & Optimasi SEO/AEO</span>
      </button>

      <button 
        data-filter="marketing" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
        <span>Pemasaran & Desain Visual</span>
      </button>
    </div>

    <!-- Grid Kartu Program Individual -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="program-grid">
      {programs.map((item) => (
        <div 
          class="program-card bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between"
          data-category={item.category}
        >
          <div>
            <!-- Thumbnail Gambar -->
            <div class="h-48 overflow-hidden relative">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-xs font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                {item.categoryLabel}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-2">{item.jurusanTarget}</span>
              <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
              <p class="text-tc-muted text-sm leading-relaxed mb-6">{item.desc}</p>
              
              <!-- Tag Tech/Skills -->
              <div class="flex flex-wrap gap-2 mb-6">
                {item.techs.map((t) => (
                  <span class="text-xs bg-tc-bg px-2.5 py-1 rounded-md text-tc-muted border border-tc-border">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Tombol CTA & Detail (Struktur Static Folder /program/[slug]) -->
          <div class="px-6 pb-6 pt-2 border-t border-tc-border/60 flex items-center justify-between gap-3">
            <a 
              href={`/program/${item.slug}`} 
              class="flex-1 text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white text-xs font-semibold py-2.5 rounded-xl transition-all"
            >
              Detail Program &rarr;
            </a>
            <a 
              href={`https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20tertarik%20pilih%20Program%20${encodeURIComponent(item.title)}.`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex-1 text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 text-xs font-bold py-2.5 rounded-xl transition-all"
            >
              Daftar VIA WA
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupProgramFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const programCards = document.querySelectorAll('.program-card');

    if (!filterBtns.length || !programCards.length) return;

    function applyFilter(filterValue: string) {
      const targetBtn = document.querySelector(`.filter-btn[data-filter="${filterValue}"]`);
      if (!targetBtn) return;

      filterBtns.forEach(b => {
        b.classList.remove('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
        b.classList.add('text-tc-muted');
      });

      targetBtn.classList.add('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
      targetBtn.classList.remove('text-tc-muted');

      programCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter') || 'all';
        applyFilter(filterValue);
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('cat');

    if (categoryParam) {
      applyFilter(categoryParam);
    }
  }

  setupProgramFilter();
  document.addEventListener('astro:page-load', setupProgramFilter);
</script>