  },
  // 5. Bisnis Digital
  {
    slug: "bisnis-digital",
    category: "digital-creative",
    categoryLabel: "Digital Business & Creative",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Bisnis Digital",
    title: "Data-Driven Growth & Content Strategy",
    desc: "Penyusunan artikel promosi produk & strategi marketing (70%) + 30% praktik pembuatan landing page web Bootstrap.",
