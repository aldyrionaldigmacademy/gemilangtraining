---
// src/pages/program.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const programs = [
  // Rumpun Tech
  {
    id: "informatika",
    category: "tech",
    categoryLabel: "Tech & Dev",
    jurusan: "Informatika / Sistem Informasi",
    title: "Web Engineering & Software Architecture",
    desc: "Pengembangan sistem web modern berkecepatan tinggi, manajemen database, integrasi REST API, dan deployment cloud.",
    techs: ["Astro", "Tailwind CSS", "blogspot", "bootsraps"],
    img: "/assets/img/informatika.webp"
  },
  {
    id: "rpl",
    category: "tech",
    categoryLabel: "Tech & Dev",
    jurusan: "RPL (Rekayasa Perangkat Lunak)",
    title: "Frontend & Fullstack Web Development",
    desc: "Fokus pada pembuatan komponen UI interaktif, pengkodean clean code, arsitektur Clean URL, dan optimasi performa web.",
    techs: ["HTML5 / CSS3", "JavaScript ES6+", "Astro SSG", "Git/GitHub"],
    img: "/assets/img/rpl.webp"
  },
  {
    id: "tkj",
    category: "tech",
    categoryLabel: "Tech & Dev",
    jurusan: "TKJ (Teknik Komputer & Jaringan)",
    title: "Network & Cloud Infrastructure Deployment",
    desc: "Konfigurasi server hosting, manajemen DNS Record, SSL Security, CDN, dan continuous deployment Vercel/Netlify.",
    techs: ["Custom DNS", "Vercel / Netlify", "Web Security", "Server Config"],
    img: "/assets/img/tkj.webp"
  },

  // Rumpun Business
  {
    id: "digital-marketing",
    category: "business",
    categoryLabel: "Digital Business",
    jurusan: "Digital Marketing",
    title: "SEO & Answer Engine Optimization (AEO)",
    desc: "Optimasi mesin pencari Google & AI Answer Engines, riset kata kunci, strategi backlink, serta analisis trafik Search Console.",
    techs: ["Google Search Console", "Ahrefs", "AEO Strategy", "SEO Content"],
    img: "/assets/img/digitalmarketing.webp"
  },
  {
    id: "bisnis-digital",
    category: "business",
    categoryLabel: "Digital Business",
    jurusan: "Bisnis Digital",
    title: "Data-Driven Growth & Business Strategy",
    desc: "Perancangan funnel pemasaran digital, analisis conversion rate, market research, dan manajemen toko marketplace.",
    techs: ["Market Research", "TikTok Shop/Seller", "Analytics", "Funnel Strategy"],
    img: "/assets/img/bisnisdigital.webp"
  },
  {
    id: "pemasaran",
    category: "business",
    categoryLabel: "Digital Business",
    jurusan: "Pemasaran / Sales",
    title: "Local GEO Tagging & Social Media Campaign",
    desc: "Eksekusi pemetaan GEO lokasi usaha lokal, optimasi profil bisnis digital, dan campaign outbound marketing.",
    techs: ["Local GEO", "Social Media Ads", "Customer Acquisition", "Copywriting"],
    img: "/assets/img/pemasaran.webp"
  },

  // Rumpun Design
  {
    id: "dkv",
    category: "design",
    categoryLabel: "Creative Arts",
    jurusan: "DKV (Desain Komunikasi Visual)",
    title: "UI/UX Design System & Brand Identity",
    desc: "Perancangan antarmuka pengguna di Figma, pembuatan wireframe, Design System, serta identitas brand visual korporat.",
    techs: ["Figma", "UI/UX Wireframing", "Brand Guidelines", "Design System"],
    img: "/assets/img/uiux.webp"
  },
  {
    id: "multimedia",
    category: "design",
    categoryLabel: "Creative Arts",
    jurusan: "Multimedia / Digital Content",
    title: "Video Production & Motion Graphic Design",
    desc: "Produksi konten video kreatif promosi, animasi 2D/motion graphics, editing audio visual, dan thumbnail visual viral.",
    techs: ["Premiere Pro", "After Effects", "Canva Pro", "Audio Editing"],
    img: "/assets/img/multimedia.webp"
  }
];
---

<BaseLayout title="Program Magang Spesialisasi - Gemilang Training" isHome={false}>
  <Navbar slot="header" />

  <section class="py-12 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Program Magang Spesialisasi
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6">
        Pilih Jalur Spesialisasi Karier Kamu
      </h1>
      <p class="text-tc-muted text-base md:text-lg">
        Program magang berbasis proyek riil yang disesuaikan secara khusus dengan latar belakang jurusan perkuliahan dan minatmu.
      </p>
    </div>

    <!-- Filter Buttons Interaktif -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <button 
        data-filter="all" 
        class="filter-btn active-filter px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border bg-tc-card text-tc-accent border-tc-accent"
      >
        Semua Jurusan
      </button>
      <button 
        data-filter="tech" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white"
      >
        💻 Tech & Dev
      </button>
      <button 
        data-filter="business" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white"
      >
        📈 Digital Business
      </button>
      <button 
        data-filter="design" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white"
      >
        🎨 Creative Arts
      </button>
    </div>

    <!-- Grid Kartu Program Individual -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="program-grid">
      {programs.map((item) => (
        <div 
          class="program-card bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between"
          data-category={item.category}
        >
          <div>
            <!-- Thumbnail Gambar -->
            <div class="h-48 overflow-hidden relative">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-xs font-semibold px-3 py-1 rounded-full">
                {item.jurusan}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6">
              <span class="text-xs font-mono text-tc-accent uppercase tracking-wider block mb-2">{item.categoryLabel}</span>
              <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
              <p class="text-tc-muted text-sm leading-relaxed mb-6">{item.desc}</p>
              
              <!-- Tag Tech/Skills -->
              <div class="flex flex-wrap gap-2 mb-6">
                {item.techs.map((t) => (
                  <span class="text-xs bg-tc-bg px-2.5 py-1 rounded-md text-tc-muted border border-tc-border">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Tombol CTA & Detail -->
          <div class="px-6 pb-6 pt-2 border-t border-tc-border/60 flex items-center justify-between gap-3">
            <a 
              href={`/program-detail?id=${item.id}`} 
              class="flex-1 text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white text-xs font-semibold py-2.5 rounded-xl transition-all"
            >
              Detail Program
            </a>
            <a 
              href={`https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20tertarik%20pilih%20Program%20${encodeURIComponent(item.jurusan)}.`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex-1 text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 text-xs font-bold py-2.5 rounded-xl transition-all"
            >
              Daftar VIA WA
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupProgramFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const programCards = document.querySelectorAll('.program-card');

    if (!filterBtns.length || !programCards.length) return;

    function applyFilter(filterValue: string) {
      const targetBtn = document.querySelector(`.filter-btn[data-filter="${filterValue}"]`);
      if (!targetBtn) return;

      filterBtns.forEach(b => {
        b.classList.remove('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
        b.classList.add('text-tc-muted');
      });

      targetBtn.classList.add('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
      targetBtn.classList.remove('text-tc-muted');

      programCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter') || 'all';
        applyFilter(filterValue);
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('cat');

    if (categoryParam) {
      applyFilter(categoryParam);
    }
  }

  setupProgramFilter();
  document.addEventListener('astro:page-load', setupProgramFilter);
</script>