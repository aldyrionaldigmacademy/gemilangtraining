    category: "webdev",
    categoryLabel: "Tech & Web Dev",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan RPL",
    title: "Frontend & Fullstack Web Development",
    desc: "Pengembangan antarmuka responsif Astro SSG, Bootstrap 5, WordPress & Blogspot komersial (70% Coding) + 30% SEO.",
    techs: ["Astro SSG", "Bootstrap 5", "WordPress", "Blogspot CMS", "Artikel SEO"],
    img: "/assets/img/rpl.webp"
  },
  // 3. TKJ
  {
    slug: "tkj",
    category: "webdev",
    categoryLabel: "Tech & Web Dev",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan TKJ",
    title: "Network & Cloud Infrastructure Deployment",
