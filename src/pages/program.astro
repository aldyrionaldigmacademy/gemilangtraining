            <!-- Content -->
            <div class="p-6">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-2">{item.jurusanTarget}</span>
              <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
              <p class="text-tc-muted text-sm leading-relaxed mb-6">{item.desc}</p>
              
              <!-- Tag Tech/Skills -->
              <div class="flex flex-wrap gap-2 mb-6">
                {item.techs.map((t) => (
                  <span class="text-xs bg-tc-bg px-2.5 py-1 rounded-md text-tc-muted border border-tc-border">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Tombol Daftar Program -->
          <div class="px-6 pb-6 pt-3 border-t border-tc-border/60">
            <a 
              href={item.daftarUrl}
              target={item.isExternal ? "_blank" : undefined}
              rel={item.isExternal ? "noopener noreferrer" : undefined}
              class="block w-full text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 text-xs sm:text-sm font-bold py-3 rounded-xl transition-all shadow-md"
            >
              {item.isExternal ? "Daftar via WhatsApp (Katun Outbound) →" : "Daftar Program →"}
