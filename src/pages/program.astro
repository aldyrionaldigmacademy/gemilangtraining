];
---

<BaseLayout title="Program Magang Spesialisasi - Gemilang Training" isHome={false}>
  <Navbar slot="header" />

  <section class="py-12 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-semibold text-tc-accent uppercase tracking-widest bg-tc-card px-4 py-2 rounded-full border border-tc-border inline-block mb-4">
        Program Magang Berbasis Proyek Industri
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6">
        Jalur Magang Spesialisasi Kampus & Vokasi
      </h1>
      <p class="text-tc-muted text-base md:text-lg leading-relaxed">
        Sistem magang silang kompetensi (70:30): Mahasiswa & SMK Tech belajar <strong class="text-white">pembuatan website (Astro, Bootstrap, Blogspot, WordPress)</strong> + dasar SEO, sedangkan SMK Marketing & Kreatif belajar <strong class="text-white">riset keyword, artikel SEO, 3 kategori video konten</strong> + dasar web.
      </p>
    </div>

    <!-- Ringkasan Skema Pembelajaran 70:30 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      <div class="bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">1. Rumpun Tech (Informatika, RPL, TKJ)</h3>
            <p class="text-xs text-tc-accent font-mono">70% Web Development : 30% SEO & Bisnis</p>
          </div>
        </div>
        <p class="text-tc-muted text-xs md:text-sm leading-relaxed">
          Fokus utama pembuatan & deployment website menggunakan **Astro Framework, Bootstrap 5, Blogspot, dan WordPress**, dilengkapi pemahaman dasar riset keyword dan optimasi artikel SEO.
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">Astro SSG</span>
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">Bootstrap 5</span>
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">WordPress</span>
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">Blogspot</span>
        </div>
      </div>

      <div class="bg-tc-card p-6 md:p-8 rounded-2xl border border-tc-border space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-tc-accent/20 border border-tc-accent flex items-center justify-center text-tc-accent font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">2. Rumpun Bisnis & Kreatif (Marketing, DKV, MM)</h3>
            <p class="text-xs text-tc-accent font-mono">70% Marketing & Video : 30% Web Basics</p>
          </div>
        </div>
        <p class="text-tc-muted text-xs md:text-sm leading-relaxed">
          Fokus utama riset keyword, penulisan artikel SEO, strategi marketing, serta pembuatan **3 kategori video konten (Promosi, Edukasi, Berita/Jurnalistik)** + praktik dasar HTML/Bootstrap/Blogspot.
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">Artikel SEO</span>
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">Video Promosi</span>
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">Video Edukasi</span>
          <span class="text-xs bg-tc-bg px-3 py-1 rounded-md text-tc-accent border border-tc-border">Video Jurnalistik</span>
        </div>
      </div>
    </div>

    <!-- Filter Buttons Interaktif -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <button 
        data-filter="all" 
        class="filter-btn active-filter px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border bg-tc-card text-tc-accent border-tc-accent inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
        <span>Semua Program</span>
      </button>

      <button 
        data-filter="webdev" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        <span>Pembuatan Web (Astro/Bootstrap/WP/Blogspot)</span>
      </button>

      <button 
        data-filter="seo" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
        <span>Riset Keyword & Artikel SEO</span>
      </button>

      <button 
        data-filter="marketing" 
        class="filter-btn px-5 py-2.5 rounded-xl font-medium text-sm transition-all border border-tc-border text-tc-muted hover:text-white inline-flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-tc-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        <span>3 Kategori Video Konten & Pemasaran</span>
      </button>
    </div>

    <!-- Grid Kartu Program Individual -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="program-grid">
      {programs.map((item) => (
        <div 
          class="program-card bg-tc-card rounded-2xl border border-tc-border overflow-hidden hover:border-tc-accent transition-all duration-300 flex flex-col justify-between"
          data-category={item.category}
        >
          <div>
            <!-- Thumbnail Gambar -->
            <div class="h-48 overflow-hidden relative">
              <img 
                src={item.img} 
                alt={item.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
              />
              <span class="absolute top-3 left-3 bg-tc-bg/90 border border-tc-border text-tc-accent text-xs font-semibold px-3 py-1 rounded-full backdrop-blur-md">
                {item.categoryLabel}
              </span>
            </div>

            <!-- Content -->
            <div class="p-6">
              <span class="text-[11px] font-mono text-tc-accent uppercase tracking-wider block mb-2">{item.jurusanTarget}</span>
              <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
              <p class="text-tc-muted text-sm leading-relaxed mb-6">{item.desc}</p>
              
              <!-- Tag Tech/Skills -->
              <div class="flex flex-wrap gap-2 mb-6">
                {item.techs.map((t) => (
                  <span class="text-xs bg-tc-bg px-2.5 py-1 rounded-md text-tc-muted border border-tc-border">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Tombol CTA & Detail (Folder src/pages/program/[slug].astro) -->
          <div class="px-6 pb-6 pt-2 border-t border-tc-border/60 flex items-center justify-between gap-3">
            <a 
              href={`/program/${item.slug}`} 
              class="flex-1 text-center bg-tc-bg hover:border-tc-accent border border-tc-border text-white text-xs font-semibold py-2.5 rounded-xl transition-all"
            >
              Detail Program &rarr;
            </a>
            <a 
              href={`https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20tertarik%20pilih%20Program%20${encodeURIComponent(item.title)}.`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex-1 text-center bg-tc-accent hover:bg-tc-accentHover text-slate-950 text-xs font-bold py-2.5 rounded-xl transition-all"
            >
              Daftar VIA WA
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- SECTION ALUR PENDAFTARAN -->
    <div id="alur-pendaftaran" class="bg-tc-card p-6 md:p-10 rounded-3xl border border-tc-border my-16 space-y-8 shadow-2xl scroll-mt-28">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-mono text-tc-accent uppercase tracking-widest font-bold">Prosedur Resmi</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white">5 Alur Mudah Pendaftaran Magang</h2>
        <p class="text-tc-muted text-xs md:text-sm">
          Tahapan terstruktur mulai dari pendaftaran awal hingga penerbitan surat balasan resmi sekolah/kampus.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 relative">
        
        <!-- Langkah 1 -->
        <div class="bg-tc-bg/80 p-5 rounded-2xl border border-tc-border/60 flex flex-col justify-between space-y-4 hover:border-tc-accent transition-colors">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-sm flex items-center justify-center">01</span>
            <span class="text-[10px] text-tc-accent bg-tc-card px-2 py-0.5 rounded border border-tc-border font-mono">Tahap 1</span>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">Konsultasi Program</h3>
            <p class="text-tc-muted text-xs leading-relaxed">
              Pilih konsentrasi magang (Tech, SEO, Video) & hubungi admin via WhatsApp.
            </p>
          </div>
        </div>

        <!-- Langkah 2 -->
        <div class="bg-tc-bg/80 p-5 rounded-2xl border border-tc-border/60 flex flex-col justify-between space-y-4 hover:border-tc-accent transition-colors">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-sm flex items-center justify-center">02</span>
            <span class="text-[10px] text-tc-accent bg-tc-card px-2 py-0.5 rounded border border-tc-border font-mono">Tahap 2</span>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">Kirim Berkas Magang</h3>
            <p class="text-tc-muted text-xs leading-relaxed">
              Kirimkan CV/Portofolio singkat & Surat Pengantar resmi Sekolah/Kampus.
            </p>
          </div>
        </div>

        <!-- Langkah 3 -->
        <div class="bg-tc-bg/80 p-5 rounded-2xl border border-tc-border/60 flex flex-col justify-between space-y-4 hover:border-tc-accent transition-colors">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-sm flex items-center justify-center">03</span>
            <span class="text-[10px] text-tc-accent bg-tc-card px-2 py-0.5 rounded border border-tc-border font-mono">Tahap 3</span>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">Interview & Mapping</h3>
            <p class="text-tc-muted text-xs leading-relaxed">
              Sesi diskusi singkat & pemetaan porsi proyek (skema 70:30) bersama mentor.
            </p>
          </div>
        </div>

        <!-- Langkah 4 -->
        <div class="bg-tc-bg/80 p-5 rounded-2xl border border-tc-border/60 flex flex-col justify-between space-y-4 hover:border-tc-accent transition-colors">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-sm flex items-center justify-center">04</span>
            <span class="text-[10px] text-tc-accent bg-tc-card px-2 py-0.5 rounded border border-tc-border font-mono">Tahap 4</span>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">Surat Balasan Resmi</h3>
            <p class="text-tc-muted text-xs leading-relaxed">
              Penerbitan Surat Balasan Resmi Penerimaan Magang untuk verifikasi kampus/sekolah.
            </p>
          </div>
        </div>

        <!-- Langkah 5 -->
        <div class="bg-tc-bg/80 p-5 rounded-2xl border border-tc-border/60 flex flex-col justify-between space-y-4 hover:border-tc-accent transition-colors">
          <div class="flex items-center justify-between">
            <span class="w-8 h-8 rounded-xl bg-tc-accent/20 border border-tc-accent text-tc-accent font-mono font-bold text-sm flex items-center justify-center">05</span>
            <span class="text-[10px] text-tc-accent bg-tc-card px-2 py-0.5 rounded border border-tc-border font-mono">Tahap 5</span>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">Onboarding & Project</h3>
            <p class="text-tc-muted text-xs leading-relaxed">
              Pembagian akses proyek (Astro/WP/Blogspot/Video) & pengerjaan terpandu.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupProgramFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const programCards = document.querySelectorAll('.program-card');

    if (!filterBtns.length || !programCards.length) return;

    function applyFilter(filterValue: string) {
      const targetBtn = document.querySelector(`.filter-btn[data-filter="${filterValue}"]`);
      if (!targetBtn) return;

      filterBtns.forEach(b => {
        b.classList.remove('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
        b.classList.add('text-tc-muted');
      });

      targetBtn.classList.add('bg-tc-card', 'text-tc-accent', 'border-tc-accent');
      targetBtn.classList.remove('text-tc-muted');

      programCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter') || 'all';
        applyFilter(filterValue);
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('cat');

    if (categoryParam) {
      applyFilter(categoryParam);
    }
  }

  setupProgramFilter();
  document.addEventListener('astro:page-load', setupProgramFilter);
</script>