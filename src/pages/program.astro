    slug: "informatika",
    category: "webdev",
    categoryLabel: "Web Engineering",
    jurusanTarget: "Terbuka untuk: Mahasiswa Informatika & Sistem Informasi",
    title: "Web Engineering & Software Architecture",
    desc: "Praktik pembuatan website modern Astro Framework, Bootstrap 5, WordPress & Blogspot CMS (70% Web Development), serta optimasi SEO dasar (30%).",
    techs: ["Astro Framework", "Bootstrap 5", "WordPress", "Blogspot CMS", "Riset Keyword"],
    img: "/assets/img/informatika.webp"
  },
  // 2. RPL
  {
    slug: "rpl",
    category: "webdev",
    categoryLabel: "Web Development",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan RPL",
    title: "Frontend & Fullstack Web Development",
    desc: "Pengembangan antarmuka responsif Astro SSG, Bootstrap 5, penyesuaian tema WordPress & Blogspot komersial (70% Coding) + 30% optimasi kata kunci.",
    techs: ["Astro SSG", "Bootstrap 5", "WordPress", "Blogspot CMS", "Artikel SEO"],
    img: "/assets/img/rpl.webp"
  },
  // 3. TKJ
  {
    slug: "tkj",
    category: "webdev",
    categoryLabel: "Web Infrastructure",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan TKJ",
    title: "Network & Cloud Infrastructure Deployment",
    desc: "Setup server & hosting WordPress, deployment situs Astro ke Vercel, konfigurasi DNS (70% Infra Web) + 30% pengisian konten web & SEO.",
    techs: ["Cloud Deployment", "WordPress Hosting", "Custom DNS", "Blogspot Domain", "SEO Basics"],
    img: "/assets/img/tkj.webp"
  },
  // 4. Digital Marketing
  {
    slug: "digital-marketing",
    category: "seo",
    categoryLabel: "SEO & Content Marketing",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Digital Marketing",
    title: "SEO & Answer Engine Optimization (AEO)",
    desc: "Riset keyword berdaya beli tinggi, artikel SEO On-Page (70% Pemasaran/SEO) + 30% praktik koding dasar Bootstrap & pengisian CMS Blogspot.",
    techs: ["Riset Keyword", "Artikel SEO", "Search Console", "Dasar Bootstrap", "Blogspot CMS"],
    img: "/assets/img/digitalmarketing.webp"
  },
  // 5. Bisnis Digital
  {
    slug: "bisnis-digital",
    category: "seo",
    categoryLabel: "Business Growth & Strategy",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Bisnis Digital",
    title: "Data-Driven Growth & Content Strategy",
    desc: "Penyusunan artikel promosi produk & strategi marketing digital (70%) + 30% praktik pembuatan landing page web sederhana berbasis Bootstrap.",
    techs: ["Strategi Marketing", "Artikel Promosi", "Riset Pasar", "Dasar Landing Page", "Blogspot"],
    img: "/assets/img/bisnisdigital.webp"
  },
  // 6. Pemasaran
  {
    slug: "pemasaran",
    category: "marketing",
    categoryLabel: "Pemasaran & Outreach",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Pemasaran",
    title: "Local GEO Tagging & Marketing Strategy",
    desc: "Pemetaan GEO lokasi usaha di Google Maps & campaign jualan (70% Pemasaran) + 30% dasar pengelolaan halaman web & artikel jualan.",
    techs: ["Local GEO Tagging", "Google Business Profile", "Copywriting", "Dasar Web Ops"],
    img: "/assets/img/pemasaran.webp"
  },
  // 7. DKV
  {
    slug: "dkv",
    category: "marketing",
    categoryLabel: "Creative Media & Video",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan DKV",
    title: "Creative Visual & Video Content Production",
    desc: "Produksi video konten 3 kategori (Promosi, Edukasi, Berita/Jurnalistik) & aset visual web (70% Kreatif) + 30% penyesuaian layout web Bootstrap.",
    techs: ["Video Promosi", "Video Edukasi", "Video Berita/Jurnalistik", "Aset Graphic Web"],
    img: "/assets/img/uiux.webp"
  },
  // 8. Multimedia
  {
    slug: "multimedia",
    category: "marketing",
    categoryLabel: "Video Content & Motion",
    jurusanTarget: "Terbuka untuk: Siswa SMK Jurusan Multimedia",
    title: "Video Production & Motion Graphics",
    desc: "Pengambilan gambar & penyuntingan video 3 kategori (Promosi, Edukasi, Berita/Jurnalistik) (70% Video) + 30% pengelolaan media di CMS Blogspot/WP.",
    techs: ["Video Promosi", "Video Edukasi", "Video Jurnalistik", "Premiere Pro", "Web Thumbnail"],
