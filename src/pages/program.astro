            <span class="inline-block text-[11px] font-semibold text-tc-accent uppercase tracking-wider bg-tc-bg border border-tc-border px-3 py-1 rounded-full mb-3">
              {item.badge}
            </span>
            <p class="text-xs font-mono text-tc-muted mb-2">{item.lokasi}</p>
            <h3 class="text-2xl font-extrabold text-white mb-3 leading-snug">
              {item.title}
            </h3>
            <p class="text-tc-muted text-sm leading-relaxed mb-5">
              {item.desc}
            </p>

            <ul class="space-y-2.5 mb-5">
              {item.poin.map((p) => (
                <li class="flex items-start gap-2.5 text-xs md:text-sm text-white/90">
                  <span class="text-tc-accent font-bold mt-0.5">✓</span>
                  <span>{p}</span>
