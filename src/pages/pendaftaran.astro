---
// src/pages/pendaftaran.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Formulir Pendaftaran Online Magang & PKL - Gemilang Training Malang" 
  description="Isi formulir pendaftaran mandiri untuk program Magang Mahasiswa Informatika dan PKL Siswa SMK di Gemilang Training Malang. Terhubung langsung ke WhatsApp resmi panitia."
  isHome={false}
>
  <Navbar slot="header" />

  <!-- 1. HERO HEADER BANNER -->
  <section class="relative bg-tc-card/80 border-b border-tc-border overflow-hidden pt-24">
    <div class="absolute inset-0 opacity-15">
      <img 
        src="/assets/img/beranda1.webp" 
        alt="Pendaftaran Magang & PKL Gemilang Training Malang" 
        class="w-full h-full object-cover" 
      />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 text-center">
      <!-- Breadcrumb Pill -->
      <nav aria-label="Breadcrumb" class="inline-flex items-center gap-2 text-xs font-medium text-tc-muted bg-tc-bg/90 px-4 py-1.5 rounded-full border border-tc-border mb-5">
        <a href="/" class="hover:text-tc-accent transition-colors">Beranda</a>
        <span>/</span>
        <a href="/alur-pendaftaran" class="hover:text-tc-accent transition-colors">Alur Pendaftaran</a>
        <span>/</span>
        <span class="text-tc-accent font-semibold">Formulir Online</span>
      </nav>

      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 leading-tight">
        Registrasi Mandiri <span class="text-tc-accent">Magang & PKL</span>
      </h1>
      <p class="text-tc-muted text-sm md:text-lg max-w-2xl mx-auto leading-relaxed">
        Lengkapi profil akademik dan pilih fokus bidang proyek yang kamu minati. Setelah dikirim, rekap pendaftaranmu akan langsung diteruskan ke WhatsApp resmi tim mentor Gemilang Training.
      </p>
    </div>
  </section>

  <!-- 2. FORMULIR & SIDEBAR INFORMASI -->
  <section class="py-12 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- KOLOM KIRI: FORMULIR PENDAFTARAN (8 Kolom) -->
      <div class="lg:col-span-8 bg-tc-card rounded-3xl border border-tc-border p-6 sm:p-8 md:p-10 shadow-2xl">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-6 mb-8 border-b border-tc-border">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-tc-accent animate-pulse"></span>
            <h2 class="text-lg md:text-xl font-bold text-white">
              Data Calon Peserta Praktik
            </h2>
          </div>
          <span class="text-xs font-semibold text-tc-accent bg-tc-bg border border-tc-border px-3.5 py-1.5 rounded-full">
            Gratis Biaya Pendaftaran
          </span>
        </div>

        <form id="form-pendaftaran" class="space-y-6">
          
          <!-- 1. PILIH JALUR PENDIDIKAN -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-white mb-3">
              1. Kategori Jalur Pendidikan <span class="text-tc-accent">*</span>
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              
              <!-- Pilihan SMK -->
              <label class="jalur-option relative flex items-start gap-3.5 p-4 rounded-2xl border border-tc-border bg-tc-bg/70 hover:border-tc-accent cursor-pointer transition-all">
                <input 
                  type="radio" 
                  name="jalur" 
                  value="PKL Siswa SMK" 
                  checked 
                  class="mt-1 accent-amber-400 w-4 h-4 cursor-pointer" 
                />
                <div>
                  <div class="text-sm font-bold text-white">PKL Siswa SMK</div>
                  <p class="text-xs text-tc-muted mt-0.5">Kelas XI / XII SMK Sederajat</p>
                </div>
              </label>

              <!-- Pilihan Mahasiswa -->
              <label class="jalur-option relative flex items-start gap-3.5 p-4 rounded-2xl border border-tc-border bg-tc-bg/70 hover:border-tc-accent cursor-pointer transition-all">
                <input 
                  type="radio" 
                  name="jalur" 
                  value="Magang Mahasiswa (D3/D4/S1)" 
                  class="mt-1 accent-amber-400 w-4 h-4 cursor-pointer" 
                />
                <div>
                  <div class="text-sm font-bold text-white">Magang Mahasiswa</div>
                  <p class="text-xs text-tc-muted mt-0.5">Jenjang D3 / D4 / S1 Aktif</p>
                </div>
              </label>

            </div>
          </div>

          <!-- 2. NAMA LENGKAP & NOMOR WHATSAPP -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nama" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Nama Lengkap Peserta <span class="text-tc-accent">*</span>
              </label>
              <input 
                type="text" 
                id="nama" 
                name="nama" 
                required 
                placeholder="Contoh: Ahmad Maulana" 
                class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white placeholder:text-tc-muted/50 transition-colors"
              />
            </div>

            <div>
              <label for="whatsapp" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Nomor WhatsApp Aktif <span class="text-tc-accent">*</span>
              </label>
              <input 
                type="tel" 
                id="whatsapp" 
                name="whatsapp" 
                required 
                placeholder="0812xxxxxxxx" 
                class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white placeholder:text-tc-muted/50 transition-colors"
              />
              <p class="text-[11px] text-tc-muted mt-1.5">Digunakan admin untuk konfirmasi jadwal & surat balasan.</p>
            </div>
          </div>

          <!-- 3. EMAIL & ASAL SEKOLAH / KAMPUS -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Alamat Email <span class="text-tc-muted font-normal lowercase">(opsional)</span>
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="nama@email.com" 
                class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white placeholder:text-tc-muted/50 transition-colors"
              />
            </div>

            <div>
              <label for="instansi" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Asal Sekolah / Perguruan Tinggi <span class="text-tc-accent">*</span>
              </label>
              <input 
                type="text" 
                id="instansi" 
                name="instansi" 
                required 
                placeholder="Contoh: SMKN 4 Malang / Polinema" 
                class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white placeholder:text-tc-muted/50 transition-colors"
              />
            </div>
          </div>

          <!-- 4. JURUSAN & TINGKAT / SEMESTER -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="jurusan" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Jurusan / Program Studi <span class="text-tc-accent">*</span>
              </label>
              <input 
                type="text" 
                id="jurusan" 
                name="jurusan" 
                required 
                placeholder="Contoh: RPL / Teknik Informatika / Bisnis Digital" 
                class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white placeholder:text-tc-muted/50 transition-colors"
              />
            </div>

            <div>
              <label for="tingkat" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Kelas / Semester Saat Ini <span class="text-tc-accent">*</span>
              </label>
              <select 
                id="tingkat" 
                name="tingkat" 
                required 
                class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white transition-colors"
              >
                <option value="Kelas XI SMK">Kelas XI SMK</option>
                <option value="Kelas XII SMK">Kelas XII SMK</option>
                <option value="Mahasiswa Semester 5">Mahasiswa Semester 5</option>
                <option value="Mahasiswa Semester 6">Mahasiswa Semester 6</option>
                <option value="Mahasiswa Semester 7 / Akhir">Mahasiswa Semester 7 / Akhir</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>
          </div>

          <!-- 5. FOKUS BIDANG / PROGRAM PRAKTIK -->
          <div>
            <label for="program" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
              Fokus Bidang Proyek yang Diminati <span class="text-tc-accent">*</span>
            </label>
            <select 
              id="program" 
              name="program" 
              required 
              class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white transition-colors"
            >
              <option value="">-- Pilih Fokus Bidang Praktik --</option>
              <option value="Pembuatan Website Modern dengan Astro">Pembuatan Website Modern dengan Astro</option>
              <option value="Desain & Koding Website dengan Bootstrap">Desain & Koding Website dengan Bootstrap</option>
              <option value="Pembuatan Website & Pengelolaan Blogspot">Pembuatan Website & Pengelolaan Blogspot</option>
              <option value="Optimasi SEO & Riset Kata Kunci">Optimasi SEO & Riset Kata Kunci</option>
              <option value="Penulisan Artikel SEO & Konten Website">Penulisan Artikel SEO & Konten Website</option>
              <option value="Digital Marketing & Promosi Online">Digital Marketing & Promosi Online</option>
              <option value="Konsultasi Penempatan Sesuai Jurusan">Belum Yakin (Sesuaikan dengan Jurusan Saya)</option>
            </select>
            <p class="text-[11px] text-tc-muted mt-1.5">Penempatan tim proyek tetap dapat disesuaikan kembali saat sesi pengarahan awal.</p>
          </div>

          <!-- 6. RENCANA DURASI & SISTEM PELAKSANAAN -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Rencana Durasi Praktik <span class="text-tc-accent">*</span>
              </label>
              <div class="grid grid-cols-1 gap-2.5">
                <label class="flex items-center gap-3 p-3.5 rounded-xl border border-tc-border bg-tc-bg/70 hover:border-tc-accent cursor-pointer transition-all">
                  <input type="radio" name="durasi" value="3 – 4 Bulan" checked class="accent-amber-400 w-4 h-4 cursor-pointer" />
                  <span class="text-xs sm:text-sm text-white font-medium">3 – 4 Bulan <span class="text-tc-muted">(Reguler)</span></span>
                </label>
                <label class="flex items-center gap-3 p-3.5 rounded-xl border border-tc-border bg-tc-bg/70 hover:border-tc-accent cursor-pointer transition-all">
                  <input type="radio" name="durasi" value="5 – 6 Bulan" class="accent-amber-400 w-4 h-4 cursor-pointer" />
                  <span class="text-xs sm:text-sm text-white font-medium">5 – 6 Bulan <span class="text-tc-muted">(1 Semester Penuh)</span></span>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
                Metode Pelaksanaan <span class="text-tc-accent">*</span>
              </label>
              <div class="grid grid-cols-1 gap-2.5">
                <label class="flex items-center gap-3 p-3.5 rounded-xl border border-tc-border bg-tc-bg/70 hover:border-tc-accent cursor-pointer transition-all">
                  <input type="radio" name="metode" value="Onsite (Kantor Malang)" checked class="accent-amber-400 w-4 h-4 cursor-pointer" />
                  <span class="text-xs sm:text-sm text-white font-medium">Onsite <span class="text-tc-muted">(Hadir di Kantor Malang)</span></span>
                </label>
                <label class="flex items-center gap-3 p-3.5 rounded-xl border border-tc-border bg-tc-bg/70 hover:border-tc-accent cursor-pointer transition-all">
                  <input type="radio" name="metode" value="Hybrid / WFH" class="accent-amber-400 w-4 h-4 cursor-pointer" />
                  <span class="text-xs sm:text-sm text-white font-medium">Hybrid / WFH <span class="text-tc-muted">(Sesuai Ketentuan Kampus/Sekolah)</span></span>
                </label>
              </div>
            </div>
          </div>

          <!-- 7. TAUTAN BERKAS / PORTOFOLIO / CATATAN -->
          <div>
            <label for="catatan" class="block text-xs font-bold uppercase tracking-wider text-white mb-2">
              Tautan Surat Pengantar / CV / Catatan <span class="text-tc-muted font-normal lowercase">(opsional)</span>
            </label>
            <textarea 
              id="catatan" 
              name="catatan" 
              rows="3" 
              placeholder="Contoh: Link Google Drive CV / Surat Pengantar, rencana tanggal mulai magang, atau jumlah anggota kelompok jika mendaftar bersama tim..." 
              class="w-full bg-tc-bg border border-tc-border focus:border-tc-accent focus:outline-none rounded-xl px-4 py-3 text-sm text-white placeholder:text-tc-muted/50 transition-colors"
            ></textarea>
            <p class="text-[11px] text-tc-muted mt-1.5">Jika melampirkan tautan Google Drive, pastikan akses berbagi diatur ke "Siapa saja yang memiliki link dapat melihat".</p>
          </div>

          <!-- CHECKBOX PERSETUJUAN -->
          <div class="pt-2">
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input 
                type="checkbox" 
                id="persetujuan" 
                required 
                class="mt-1 accent-amber-400 w-4 h-4 rounded cursor-pointer" 
              />
              <span class="text-xs text-tc-muted leading-relaxed">
                Saya menyatakan bahwa data yang diisikan di atas adalah benar dan siap mengikuti arahan serta tata tertib program Magang / PKL di Gemilang Training Malang.
              </span>
            </label>
          </div>

          <!-- SUBMIT BUTTON -->
          <div class="pt-2">
            <button 
              type="submit" 
              class="w-full bg-tc-accent hover:bg-tc-accentHover text-slate-950 font-extrabold text-sm md:text-base py-4 px-6 rounded-2xl transition-all shadow-lg hover:scale-[1.01] flex items-center justify-center gap-2.5 cursor-pointer"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z"/>
              </svg>
              <span>Kirim Formulir via WhatsApp Resmi</span>
            </button>
            <p class="text-[11px] text-tc-muted text-center mt-3">
              Setelah tombol ditekan, WhatsApp akan otomatis terbuka dengan format pesan pendaftaran yang sudah tersusun rapi.
            </p>
          </div>

        </form>
      </div>

      <!-- KOLOM KANAN: SIDEBAR INFO & BANTUAN (4 Kolom) -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- Card 1: Status Gelombang & Kuota -->
        <div class="bg-tc-card rounded-3xl border border-tc-border p-6 shadow-xl">
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              Pendaftaran Dibuka
            </span>
            <span class="text-xs font-mono text-tc-muted">Periode 2026</span>
          </div>

          <h3 class="text-lg font-bold text-white mb-1.5">
            Kuota Magang & PKL Malang
          </h3>
          <p class="text-xs text-tc-muted leading-relaxed mb-5">
            Penerimaan dibuka untuk individu maupun kelompok kecil dari SMK dan Perguruan Tinggi. Kuota dibatasi agar pendampingan mentor tetap optimal.
          </p>

          <!-- Progress Bar Kuota -->
          <div class="bg-tc-bg p-3.5 rounded-2xl border border-tc-border">
            <div class="flex items-center justify-between text-xs mb-2">
              <span class="text-tc-muted font-medium">Ketersediaan Slot Bimbingan</span>
              <span class="text-tc-accent font-bold">Terisi 75%</span>
            </div>
            <div class="w-full h-2 bg-tc-card rounded-full overflow-hidden">
              <div class="h-full bg-tc-accent rounded-full" style="width: 75%"></div>
            </div>
          </div>
        </div>

        <!-- Card 2: Benefit & Fasilitas Peserta -->
        <div class="bg-tc-card rounded-3xl border border-tc-border p-6 shadow-xl">
          <h3 class="text-base font-bold text-white mb-4">
            Fasilitas Peserta Gemilang Training
          </h3>
          <ul class="space-y-3.5 text-xs text-tc-muted leading-relaxed">
            <li class="flex items-start gap-2.5">
              <span class="text-tc-accent font-bold mt-0.5">✓</span>
              <span><strong class="text-white">Bebas Biaya Pendaftaran:</strong> Tidak ada pungutan biaya registrasi maupun biaya bimbingan praktik.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-tc-accent font-bold mt-0.5">✓</span>
              <span><strong class="text-white">Proyek Website & SEO Riil:</strong> Langsung mengelola website aktif berbasis Astro, Bootstrap, dan Blogspot.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-tc-accent font-bold mt-0.5">✓</span>
              <span><strong class="text-white">Pendampingan Mentor Praktisi:</strong> Evaluasi rutin harian dan pengarahan teknis bertahap.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-tc-accent font-bold mt-0.5">✓</span>
              <span><strong class="text-white">Administrasi Lengkap:</strong> Surat balasan resmi, tanda tangan jurnal/logbook, nilai akhir, dan sertifikat kelulusan.</span>
            </li>
          </ul>
        </div>

        <!-- Card 3: Bantuan Konsultasi -->
        <div class="bg-gradient-to-br from-tc-card to-tc-bg rounded-3xl border border-tc-accent/40 p-6 shadow-xl">
          <span class="inline-block text-[11px] font-semibold text-tc-accent uppercase tracking-wider mb-2">
            Bantuan Admin
          </span>
          <h3 class="text-lg font-bold text-white mb-2">
            Butuh Surat Balasan Cepat atau Konsultasi?
          </h3>
          <p class="text-xs text-tc-muted leading-relaxed mb-5">
            Jika pihak sekolah atau kampus membutuhkan konfirmasi kuota terlebih dahulu sebelum mengirim surat pengantar, silakan hubungi koordinator kami.
          </p>
          <a 
            href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20berkonsultasi%20sebelum%20mengisi%20formulir%20pendaftaran%20Magang%20%26%20PKL." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full inline-flex items-center justify-center gap-2 bg-tc-bg hover:border-tc-accent border border-tc-border text-tc-accent font-bold text-xs py-3 px-4 rounded-xl transition-all"
          >
            <span>Tanya Admin via WhatsApp</span>
            <span>&rarr;</span>
          </a>
        </div>

      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  function setupPendaftaranForm() {
    const form = document.getElementById('form-pendaftaran') as HTMLFormElement | null;
    if (!form) return;

    const urlParams = new URLSearchParams(window.location.search);
    const jalurParam = urlParams.get('jalur');
    const programParam = urlParams.get('program');

    // Auto-select Jalur Pendidikan dari URL (?jalur=mahasiswa atau ?jalur=smk)
    if (jalurParam === 'mahasiswa') {
      const radioMhs = form.querySelector('input[name="jalur"][value="Magang Mahasiswa (D3/D4/S1)"]') as HTMLInputElement | null;
      const selectTingkat = document.getElementById('tingkat') as HTMLSelectElement | null;
      if (radioMhs) radioMhs.checked = true;
      if (selectTingkat) selectTingkat.value = 'Mahasiswa Semester 5';
    } else if (jalurParam === 'smk') {
      const radioSmk = form.querySelector('input[name="jalur"][value="PKL Siswa SMK"]') as HTMLInputElement | null;
      const selectTingkat = document.getElementById('tingkat') as HTMLSelectElement | null;
      if (radioSmk) radioSmk.checked = true;
      if (selectTingkat) selectTingkat.value = 'Kelas XI SMK';
    }

    // Auto-select Fokus Bidang Praktik dari URL (?program=...)
    if (programParam) {
      const selectProgram = document.getElementById('program') as HTMLSelectElement | null;
      if (selectProgram) {
        const options = Array.from(selectProgram.options);
        const matched = options.find(opt => opt.value.toLowerCase() === programParam.toLowerCase());
        if (matched) {
          selectProgram.value = matched.value;
        }
      }
    }

    // Handle Submit ke WhatsApp
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const jalur = (form.querySelector('input[name="jalur"]:checked') as HTMLInputElement)?.value || '-';
      const nama = (document.getElementById('nama') as HTMLInputElement)?.value.trim() || '-';
      const whatsapp = (document.getElementById('whatsapp') as HTMLInputElement)?.value.trim() || '-';
      const email = (document.getElementById('email') as HTMLInputElement)?.value.trim() || '-';
      const instansi = (document.getElementById('instansi') as HTMLInputElement)?.value.trim() || '-';
      const jurusan = (document.getElementById('jurusan') as HTMLInputElement)?.value.trim() || '-';
