---
// src/layouts/BaseLayout.astro
import '../global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  isHome?: boolean;
  type?: 'website' | 'article';
  hideBreadcrumb?: boolean;
}

const { 
  title, 
  description = "Tempat Magang Mahasiswa (Informatika) & PKL Siswa SMK (RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, Multimedia) berbasis proyek nyata di Malang.", 
  keywords = "tempat magang malang, tempat pkl malang, info magang malang, lowongan magang malang, magang mahasiswa informatika malang, pkl smk rpl malang, pkl smk tkj malang, pkl digital marketing malang, pkl bisnis digital malang, pkl pemasaran malang, pkl dkv malang, pkl multimedia malang, gemilang training malang",
  image = "/assets/img/beranda1.webp",
  isHome = false,
  type = "website",
  hideBreadcrumb = false
} = Astro.props;

// 1. CLEAN CANONICAL URL 
const siteUrl = (Astro.site ? Astro.site.toString() : "https://infomagangmalang.web.id").replace(/\/$/, "");
const cleanPath = Astro.url.pathname
  .replace(/\.html$/i, "")
  .replace(/\/index$/i, "")
  .replace(/\/+$/, "") || "/";
const canonicalURL = cleanPath === "/" ? siteUrl : `${siteUrl}${cleanPath}`;

// Deteksi apakah halaman saat ini termasuk bagian Program
const isProgramSection = cleanPath === "/program" || cleanPath.startsWith("/program/");

// Bangun item breadcrumb dinamis yang bisa diklik per segmen
const labelOverrides: Record<string, string> = {
  "program": "Program",
  "magang-mahasiswa": "Magang Mahasiswa",
  "pkl-smk": "PKL Siswa SMK",
  "alur-pendaftaran": "Alur Pendaftaran",
  "pendaftaran": "Pendaftaran",
  "portofolio": "Portofolio",
  "blog": "Blog",
  "tentang-kami": "Tentang Kami",
  "kontak": "Kontak"
};

const pathSegments = cleanPath === "/" ? [] : cleanPath.replace(/^\//, "").split("/");
const breadcrumbItems = pathSegments.map((seg, index) => {
  const href = "/" + pathSegments.slice(0, index + 1).join("/");
  const customLabel = labelOverrides[seg.toLowerCase()];
  const label = customLabel || seg.replace(/-/g, " ").replace(/\b\w/g, (ch) => ch.toUpperCase());
  const isLast = index === pathSegments.length - 1;
  return { href, label, isLast };
});

// 2. ABSOLUTE OG IMAGE URL (.webp)
const ogImageURL = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`;

// 3. MENCEGAH DUPLIKASI NAMA BRAND DI TITLE
const formattedTitle = title.includes("Gemilang Training") ? title : `${title} | Gemilang Training`;

// 4. SCHEMA MARKUP JSON-LD LENGKAP (AEO & LOCAL SEO MALANG)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Gemilang Training",
  "alternateName": "Info Magang & PKL Malang - Gemilang Training",
  "url": siteUrl,
  "logo": `${siteUrl}/assets/img/beranda1.webp`,
  "image": ogImageURL,
  "description": "Tempat praktik Magang Mahasiswa (Informatika) dan PKL Siswa SMK (RPL, TKJ, Digital Marketing, Bisnis Digital, Pemasaran, DKV, Multimedia) berbasis proyek nyata di Kota Malang.",
  "telephone": "+6281943431484",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Malang",
    "addressRegion": "Jawa Timur",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -7.9427,
    "longitude": 112.6190
  },
  "areaServed": [
    { "@type": "City", "name": "Malang" },
    { "@type": "AdministrativeArea", "name": "Malang Raya" },
    { "@type": "State", "name": "Jawa Timur" }
  ],
  "knowsAbout": [
    "Magang Mahasiswa Informatika Malang",
    "Tempat PKL SMK RPL Malang",
    "Tempat PKL SMK TKJ Malang",
    "Tempat PKL Digital Marketing Malang",
    "Tempat PKL Bisnis Digital & Pemasaran Malang",
    "Tempat PKL SMK DKV & Multimedia Malang",
    "Web Development Astro & Bootstrap",
    "Search Engine Optimization (SEO)"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+6281943431484",
    "contactType": "admissions",
    "areaServed": "ID",
    "availableLanguage": "Indonesian"
  }
};

const breadcrumbSchema = !isHome && !hideBreadcrumb && breadcrumbItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": siteUrl
    },
    ...breadcrumbItems.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 2,
      "name": item.label,
      "item": `${siteUrl}${item.href}`
    }))
  ]
} : null;
---

<!DOCTYPE html>
<html lang="id" class="bg-tc-bg text-tc-text scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary Meta Tags & Keywords -->
  <title>{formattedTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Gemilang Training Malang" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonicalURL} />

  <!-- GEO Tagging (Kota Malang, Jawa Timur - Local SEO) -->
  <meta name="geo.region" content="ID-JI" />
  <meta name="geo.placename" content="Malang" />
  <meta name="geo.position" content="-7.9427;112.6190" />
  <meta name="ICBM" content="-7.9427, 112.6190" />

  <!-- Open Graph / WhatsApp / Social Media -->
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Gemilang Training" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={formattedTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={formattedTitle} />
  <meta property="og:locale" content="id_ID" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={formattedTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Schema Org JSON-LD Global (AEO & Local SEO) -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <!-- Slot Head Tambahan (Untuk Schema FAQPage di Beranda atau Article di Blog) -->
  <slot name="head" />
</head>
<body 
  data-active-section={isProgramSection ? "program" : undefined}
  data-current-path={cleanPath}
  class="min-h-screen flex flex-col justify-between font-sans antialiased bg-tc-bg text-tc-text relative"
>
  <slot name="header" />
  
  <!-- Breadcrumb (Aktif untuk SEMUA halaman KECUALI Beranda atau jika di-hide secara eksplisit) -->
  {!isHome && !hideBreadcrumb && breadcrumbItems.length > 0 && (
    <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-24 pb-4 text-sm text-tc-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="text-tc-muted hover:text-tc-accent transition-colors">Beranda</a>
        </li>
        {breadcrumbItems.map((item) => (
          <>
            <li aria-hidden="true" class="text-tc-muted/60">/</li>
            {item.isLast ? (
              <li aria-current="page" class="text-white font-medium hover:text-tc-accent transition-colors cursor-default">
                {item.label}
              </li>
            ) : (
              <li>
                <a href={item.href} class="text-tc-muted hover:text-tc-accent transition-colors">
                  {item.label}
                </a>
              </li>
            )}
          </>
        ))}
      </ol>
    </nav>
  )}

  <main class={isHome ? "pt-16" : ""}>
    <slot />
  </main>

  <slot name="footer" />

  <!-- ======================================================= -->
  <!-- FLOATING BUTTONS (PANAH SCROLL TOP & WHATSAPP LIVE)      -->
  <!-- ======================================================= -->
  <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 items-center">
    
    <!-- 1. Tombol Scroll To Top (Panah ke Atas) -->
    <button 
      id="scroll-to-top-btn" 
      aria-label="Scroll to top"
      class="opacity-0 invisible transition-all duration-300 bg-tc-card hover:bg-tc-bg border border-tc-border text-tc-accent p-3 rounded-full shadow-2xl hover:scale-110 flex items-center justify-center cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>

    <!-- 2. Tombol WhatsApp Live Melayang -->
    <a 
      href="https://wa.me/6281943431484?text=Halo%20Admin%20Gemilang%20Training%2C%20saya%20ingin%20bertanya%20mengenai%20Program%20Magang%20%26%20PKL." 
      target="_blank" 
      rel="noopener noreferrer"
      aria-label="Chat WhatsApp Magang & PKL"
      class="bg-[#25D366] hover:bg-[#20ba5a] text-white p-3.5 rounded-full shadow-2xl transition-all duration-300 hover:scale-110 flex items-center justify-center group relative"
    >
      <svg class="w-6 h-6 fill-current transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-6" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z"/>
      </svg>

      <!-- Tooltip Hover Pesan Singkat -->
      <span class="absolute right-full mr-3 bg-tc-card border border-tc-border text-white text-xs font-semibold px-3 py-1.5 rounded-xl whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none shadow-xl">
        Chat Live WA
      </span>
    </a>

  </div>

  <!-- Script Logika Scroll ke Atas & Sinkronisasi Menu Program Aktif -->
  <script>
    function setupScrollToTop() {
      const scrollBtn = document.getElementById('scroll-to-top-btn');
      if (!scrollBtn) return;

      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          scrollBtn.classList.remove('opacity-0', 'invisible');
          scrollBtn.classList.add('opacity-100', 'visible');
        } else {
          scrollBtn.classList.add('opacity-0', 'invisible');
          scrollBtn.classList.remove('opacity-100', 'visible');
        }
      });

      scrollBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }

    function syncActiveProgramNav() {
      const isProgram = document.body.getAttribute('data-active-section') === 'program';
      const currentPath = document.body.getAttribute('data-current-path') || window.location.pathname;
      if (!isProgram) return;

      const navLinks = document.querySelectorAll('header nav a, header nav button');
      navLinks.forEach((el) => {
        const href = el.getAttribute('href') || '';
        const text = (el.textContent || '').trim().toLowerCase();
        const isProgramTarget =
          href === '/program' ||
          href.startsWith('/program/') ||
          text.startsWith('program');

        if (isProgramTarget) {
          el.setAttribute('data-active', 'true');
          el.classList.add('text-white');
          if (href === currentPath) {
            el.setAttribute('aria-current', 'page');
          }
        }
      });
    }

    setupScrollToTop();
    syncActiveProgramNav();
    document.addEventListener('astro:page-load', () => {
      setupScrollToTop();
      syncActiveProgramNav();
    });
  </script>
</body>
</html>
